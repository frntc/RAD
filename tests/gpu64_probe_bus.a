;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- when a register read answers $FF, was the address
;      mis-sampled, or did the access never arrive at all?
;
;      WHY THIS EXISTS
;
;      The 62291-frame Quake run of 2026-09-08 was clean on everything
;      its screen could report -- STALLS 00, zero BUSY refusals, no menu
;      drop -- except for 135 frames whose commit answered ERRCODE $FF.
;
;      $FF is not an errcode. GPU64_ERR_* stops at $0C. It has exactly
;      two producers and that screen could not tell them apart:
;
;        (a) MIS-SAMPLED ADDRESS. The loop serviced the read, but
;            IO_ADDRESS came out wrong, so gpu64_apiReadReg() fell
;            through its four cases to `return 0xFF`. IO_ADDRESS takes
;            A0-A3 from GPIO 10-13, which are dedicated, and A4-A7 from
;            GPIO 0-3, which the LVC257 multiplexes with NMI, ROMH, IO1
;            and BUTTON. Every gpu64 register is at $DF50-$DF68, so
;            A4-A7 read 0 when sampled correctly and a mis-sample can
;            only ever SET bits: $DF53 degrades to $1E, $2E, $4E or $8E,
;            all of which still decode into the gpu64 window and all of
;            which return $FF.
;
;        (b) DROPPED ACCESS. The loop never saw the read at all -- the
;            known ~1-in-180000 sampling floor (CLAUDE.md, "the bus is
;            not reliable") -- and the C64 latched a floating bus that
;            happens to read as $FF.
;
;      They need different responses. Under (a) the firmware's state is
;      intact and only the answer was wrong, so a C64-side re-read
;      repairs it and the API can document that. Under (b) a write in
;      the same position would have vanished silently, which no re-read
;      can repair and which only a sequence number can even detect.
;
;      HOW IT TELLS THEM APART
;
;      The firmware now counts, on core 0 and off every deadline path,
;      how many gpu64-window reads and writes the polling loop actually
;      serviced and how many of those carried an address no gpu64
;      register occupies (Source/Firmware/gpu64_busstats.h, reported
;      through GET_HEALTH bytes 48-63). That gives every access a
;      denominator for the first time.
;
;      This program issues a known number of accesses, counts its own
;      $FF answers, and reads the firmware's counters either side. Three
;      numbers per rung then separate the hypotheses:
;
;        ISSD  what the C64 issued -- counted at every single read site
;        SAW   what the loop serviced, minus the fixed cost of the
;              GET_HEALTH round trip itself (the CAL row)
;        BAD   of those, how many carried an impossible address
;        FF    how many answers came back $FF
;
;        SAW < ISSD  ................  (b), and by exactly how much
;        BAD > 0  ...................  (a), and BADAD names the bits
;        FF ~= BAD + (ISSD - SAW)  ..  the two mechanisms together
;                                      account for every bad answer.
;                                      Approximately, not exactly: a
;                                      rung's BAD also collects the one
;                                      GET_HEALTH round-trip read the CAL
;                                      row corrects ISSD and SAW for, so
;                                      BAD may run a count or two ahead
;        FF >> BAD + (ISSD - SAW)  ..  there is a THIRD mechanism, and
;                                      that is the finding
;
;      THE RUNGS
;
;        READ  raw `lda ERRCODE` at full speed on an otherwise quiet
;              bus. Maximum read pressure, nothing else happening. If
;              the defect needs no help, it shows up here.
;        DISP  a NOP dispatch followed immediately by `lda ERRCODE` --
;              the exact shape every command helper in this tree emits,
;              and the shape the Quake commit used. The read lands on
;              the instruction right after a DMA hold released, which is
;              the one structural difference from READ.
;        FLIP  the same read, but issued only while a deferred PAGE_FLIP
;              is in flight, so it races the loop-fired commit hold. Of
;              the four rungs this is the closest class-0 analogue of
;              the Quake frame that produced the 135 events: the Quake
;              number works out at about one per 460 commits, which is
;              two orders of magnitude above the documented write-drop
;              floor and is the reason a commit-adjacent rung exists at
;              all.
;        WRIT  raw `sta ARG+0` at full speed. The write-side twin, and
;              the first measurement of the drop rate for writes that
;              has ever had a denominator: until now it had a numerator
;              (SEQ/SEQACK mismatches) and nothing to divide it by, so
;              "1 in 70 commit dispatches" and "1 in 180000 writes" were
;              never comparable numbers. The FF column is meaningless
;              here and prints ----.
;
;      HOW TO READ THE RESULT
;
;        GPU64 PROBE BUS
;
;        CAL    RR WW EE               reads and writes one GET_HEALTH
;                                      round trip costs, and GET_HEALTH's
;                                      own errcode. RR/WW are subtracted
;                                      from every SAW, and are printed so
;                                      the arithmetic is auditable at the
;                                      bench rather than trusted. EE must
;                                      be 00 -- anything else means
;                                      healthBuf was never filled and
;                                      every number below is a difference
;                                      between two copies of nothing
;               ISSD SAW  BAD  FF
;        READ   7D00 7D00 0000 0000
;        DISP   4E20 4E20 0000 0000
;        FLIP   0BB8 0BB8 0000 0000
;        WRIT   7D00 7D00 0000 ----
;
;        BADAD  LL OO AA WW            last bad read address, OR of all
;                                      of them, AND of all of them, and
;                                      the last bad WRITE address. AA
;                                      reads FF when there were no bad
;                                      samples at all. Expect the low
;                                      nibble to match the register the
;                                      rung was reading ($0E for ERRCODE)
;                                      and the damage to be in the high
;                                      nibble -- that is hypothesis (a)'s
;                                      signature, and anything else
;                                      refutes it
;
;        VERDICT ...
;        PHASE  CRDFWV                 one letter per rung reached. If it
;                                      stops short, THAT rung is where
;                                      the machine died
;        ALIVE  -
;        TRAP   00   0000               only if a BRK or NMI was taken:
;                                      the kind, then the interrupted PC
;
;      WHAT EACH VERDICT MEANS
;
;        CLEAN - NO EVENT
;              -- nothing went wrong in this run. Not a failure and not
;                 a pass: the defect is rare, and a clean run bounds its
;                 rate from above rather than disproving it. This is
;                 also what a desk check under tools/prgsim/runsim.py
;                 always prints, because a simulated bus never drops an
;                 access and never mis-samples an address. That desk
;                 check is worth running anyway -- it is what proves the
;                 CAL arithmetic right, and a systematic accounting
;                 error would otherwise reach the bench disguised as
;                 DROPPED.
;        MIS-SAMPLED ADDRESS
;              -- hypothesis (a). Read BADAD. The fix is C64-side and
;                 cheap: re-read the register when the answer is $FF.
;        DROPPED ACCESS
;              -- hypothesis (b). The sampling floor, now with a
;                 measured rate and denominator on both the read and the
;                 write side. No C64-side re-read helps a dropped write.
;        MIS-SAMPLED AND DROPPED
;              -- both, which is the outcome the instrument was built to
;                 be able to report rather than the one it expects.
;        UNEXPLAINED FF
;              -- $FF answers that neither counter accounts for. The
;                 loop serviced every access at a legal address and
;                 still handed back $FF, so the fault is between
;                 gpu64_apiReadReg() and the C64's latch -- the data
;                 half of the bus, not the address half. That would be a
;                 new finding.
;        FAIL - TRAP
;              -- a BRK or NMI. Nothing to do with sampling; read TRAP.
;
;      Class 0 only: no viewport, no camera, no core 1. A rung that
;      cannot fail for an unrelated reason is worth more here than a
;      realistic one.
;
;      Requires the RAD menu switched to REU mode with T. Power-cycle
;      between runs: a re-launch from the RAD menu inherits firmware
;      state from its predecessor.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

CMD_HI   = $df50
CMD_LO   = $df51
STATUS   = $df52
ERRCODE  = $df53
ARG      = $df56
RESULT   = $df66

ST_BUSY  = $01

; class 0
OP_NOP           = $00
OP_PAGE_FLIP     = $05
OP_GET_HEALTH    = $0A

SCREEN   = $0400

; zero page scratch. $fb-$fe are free in a BASIC-hosted program.
SRC      = $fb
DST      = $fd

; ----------------------------------------------------------------------
; Rung budgets, in ITERATIONS -- not in accesses. Sized for events per
; minute, not for statistical power (CLAUDE.md).
;
; READ and WRIT do eight accesses per iteration, so 4000 iterations is
; 32000 accesses each and takes well under a second. DISP is paced by
; dispatch at roughly 2400/s, so 20000 is about eight seconds -- and at
; the Quake run's rate of one event per 460 commits that is about 43
; expected events, which is the rung this run is really being spent on.
; FLIP is paced by the 50 Hz frame clock, one armed window per frame, so
; 3000 iterations is around ten seconds.
;
; Declared weak so a desk run can shrink them without editing the source:
;   64tass -D N_READ=50 -D N_DISP=50 ...
; The bench always builds the defaults.
.weak
N_READ   = 4000
N_DISP   = 20000
N_FLIP   = 3000
N_WRIT   = 4000
; Accesses per iteration in the burst rungs. Eight is one page of the
; 6502's patience: long enough that the bookkeeping between bursts does
; not dominate the access rate, short enough that a burst still fits
; inside one armed flip window in the FLIP rung.
N_BURST  = 8
.endweak

; Screen rows.
ROW_CAL      = 2
ROW_HEAD     = 4
ROW_READ     = 5
ROW_DISP     = 6
ROW_FLIP     = 7
ROW_WRIT     = 8
ROW_BADAD    = 10
ROW_VERDICT  = 12
ROW_PHASE    = 14
ROW_ALIVE    = 15
ROW_TRAP     = 17
ROW_CURSOR   = 20

COL_VAL      = 7		; first count column; the rest are +5 apart

; Phase breadcrumb letters, as screen codes (letter - $40).
PH_CAL     = $03		; C
PH_READ    = $12		; R
PH_DISP    = $04		; D
PH_FLIP    = $06		; F
PH_WRIT    = $17		; W
PH_VERDICT = $16		; V

; Rung indices, which are also slots in the result tables.
IX_READ  = 0
IX_DISP  = 1
IX_FLIP  = 2
IX_WRIT  = 3

; Trap markers.
TRAP_BRK = $01
TRAP_NMI = $02

; KERNAL vectors and calls.
CBINV = $0316			; BRK
NMINV = $0318			; NMI
PLOT  = $fff0

; GET_HEALTH block offsets (Source/Firmware/gpu64_api.cpp, case 0x0A).
; Only the low 16 bits of the two 32-bit counters are used: every number
; this program wants is a DIFFERENCE between two snapshots, and every
; difference is far below 65536, so the low word subtracts correctly
; even across a wrap.
H_READS   = 48
H_WRITES  = 52
H_RDBAD   = 56
H_WRBAD   = 58
H_LASTBAD = 60
H_ORBAD   = 61
H_ANDBAD  = 62
H_LASTBW  = 63

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	; Remembered so a trap can put the stack back the way BASIC left it and
	; still let the final RTS return there.
	tsx
	stx entrySP

	jsr clearScreen
	lda #<txtTitle
	ldy #>txtTitle
	ldx #0
	jsr printAt

	jsr installTraps
	jsr showLabels

	; CMD_HI is sticky, and every command in this program is class 0.
	lda #0
	sta CMD_HI

	; --- CAL ------------------------------------------------------------
	; Two GET_HEALTH round trips back to back with nothing in between.
	; The difference between them is exactly what one round trip costs in
	; register accesses -- its own six ARG writes, its CMD_LO, and the
	; ERRCODE read that follows -- and that is the constant every rung
	; below has to subtract before its SAW means anything.
	;
	; Measured rather than counted from the source on purpose. The
	; firmware counts the triggering CMD_LO write only AFTER the command
	; has run and the bus is back (see gpu64_busStatsWrite() under
	; gpu64_holdGapRelease() in rad_reu.cpp), so the write that dispatches
	; a snapshot lands in the NEXT snapshot's block. Measuring is immune
	; to that; counting is not.
	lda #PH_CAL
	jsr phase
	jsr doHealth
	jsr snapSave
	jsr doHealth
	jsr calcCal
	jsr showCal

	lda #PH_READ
	jsr phase
	jsr runRead
	lda abortFlag
	bne allDone

	lda #PH_DISP
	jsr phase
	jsr runDisp
	lda abortFlag
	bne allDone

	lda #PH_FLIP
	jsr phase
	jsr runFlip
	lda abortFlag
	bne allDone

	lda #PH_WRIT
	jsr phase
	jsr runWrit

allDone
	lda #PH_VERDICT
	jsr phase
	jsr showBadAddr
	jsr verdict

	jsr removeTraps

	lda #0
	sta CMD_HI

	; Park the cursor below the report so BASIC's READY. does not scroll
	; the thing the operator came to read off the top of the screen.
	clc
	ldx #ROW_CURSOR
	ldy #0
	jsr PLOT
	rts

; ----------------------------------------------------------------------
; The rungs.
;
; Every one of them follows the same three steps, and the discipline in
; the middle one is the whole instrument:
;
;   beginRung   snapshot the firmware counters, zero the local ones
;   <body>      issue accesses, and increment issR or issW at EVERY
;               single access site, including the ones inside helpers
;   endRung     snapshot again, subtract, subtract CAL, store, display
;
; An access site that forgets to bump the counter reports itself as a
; dropped access, which is the exact finding this program exists to
; make -- so the counting is deliberately explicit and local rather than
; hidden in a helper that could drift out of step with its call sites.
; ----------------------------------------------------------------------

; READ: raw reads on a quiet bus.
runRead
	lda #IX_READ
	ldx #<N_READ
	ldy #>N_READ
	jsr beginRung
rdLoop
	ldx #N_BURST
rdRep
	lda ERRCODE
	cmp #$ff
	bne rdOk
	jsr bumpFF
rdOk
	dex
	bne rdRep
	jsr bumpR8
	jsr endIter
	lda phaseDone
	beq rdLoop
	jmp endRungRead

; DISP: a dispatch, then the read that judges it -- the shape every
; command helper in this tree emits. One read per iteration, because
; that is what the shape does; the rung is paced by the dispatch, not by
; the read.
runDisp
	lda #IX_DISP
	ldx #<N_DISP
	ldy #>N_DISP
	jsr beginRung
dsLoop
	lda #OP_NOP
	sta CMD_LO
	lda ERRCODE
	cmp #$ff
	bne dsOk
	jsr bumpFF
dsOk
	jsr bumpR
	jsr endIter
	lda phaseDone
	beq dsLoop
	jmp endRungRead

; FLIP: the same read, but only while a deferred PAGE_FLIP is in flight,
; so it races the loop-fired commit hold. When no flip is pending the
; iteration arms one instead -- a dispatch made with the window closed,
; which can never legitimately be refused.
runFlip
	lda #IX_FLIP
	ldx #<N_FLIP
	ldy #>N_FLIP
	jsr beginRung
fpLoop
	; STATUS is judged for $FF like every other read. It has to be: a
	; mis-sampled STATUS read answers $FF, which `and #ST_BUSY` reads as
	; "a flip is in flight" and quietly steers the iteration, so leaving
	; it unchecked would put events in the firmware's BAD column with
	; nothing in the FF column to match them against.
	lda STATUS
	jsr bumpR
	cmp #$ff
	bne fpStOk
	jsr bumpFF
fpStOk
	and #ST_BUSY
	bne fpBusy
	; Arm: two writes and one read, and the read is counted like any
	; other. ERRCODE is judged here too -- a $FF answer to the arming
	; dispatch is exactly the event under investigation and must not
	; escape just because it came from a helper.
	lda #1				; 1 = defer to the vblank boundary
	sta ARG+0
	lda #OP_PAGE_FLIP
	sta CMD_LO
	lda ERRCODE
	jsr bumpR
	cmp #$ff
	bne fpNext
	jsr bumpFF
	jmp fpNext
fpBusy
	ldx #N_BURST
fpRep
	lda ERRCODE
	cmp #$ff
	bne fpOk
	jsr bumpFF
fpOk
	dex
	bne fpRep
	jsr bumpR8
fpNext
	jsr endIter
	lda phaseDone
	beq fpLoop
	jmp endRungRead

; WRIT: raw writes on a quiet bus. ARG+0 is chosen because it is the
; most-written register in the API and because writing it has no side
; effect at all -- nothing is dispatched, so the rung cannot fail for a
; reason other than the one it is measuring.
runWrit
	lda #IX_WRIT
	ldx #<N_WRIT
	ldy #>N_WRIT
	jsr beginRung
wrLoop
	ldx #N_BURST
	lda #$5a			; an arbitrary value; nothing reads it back
wrRep
	sta ARG+0
	dex
	bne wrRep
	jsr bumpW8
	jsr endIter
	lda phaseDone
	beq wrLoop
	jmp endRungWrite

; ----------------------------------------------------------------------
; Rung bookkeeping.
; ----------------------------------------------------------------------

; A = rung index, X/Y = iteration budget low/high.
beginRung
	sta curRung
	stx budLo
	sty budHi
	lda #0
	sta iters
	sta iters+1
	sta issR
	sta issR+1
	sta issW
	sta issW+1
	sta ffCount
	sta ffCount+1
	sta phaseDone
	; The snapshot the rung is measured against is the one GET_HEALTH
	; left behind most recently -- the CAL pass's second call for the
	; first rung, and the previous rung's closing call after that. No
	; extra round trip is spent here, which also means no extra round
	; trip has to be corrected for.
	jmp snapSave

; Common tail: take the closing snapshot, subtract, and display.
endRungRead
	jsr doHealth
	; SAW = (reads now - reads at beginRung) - CAL reads.
	lda #H_READS
	jsr snapDelta
	lda calR
	jsr subCal
	jsr storeRung
	lda #H_RDBAD
	jsr snapDelta
	jsr storeBad
	lda issR
	ldx issR+1
	jsr storeIssued
	jmp showRungRow

endRungWrite
	jsr doHealth
	lda #H_WRITES
	jsr snapDelta
	lda calW
	jsr subCal
	jsr storeRung
	lda #H_WRBAD
	jsr snapDelta
	jsr storeBad
	lda issW
	ldx issW+1
	jsr storeIssued
	jmp showRungRow

endIter
	inc iters
	bne eiCounted
	inc iters+1
eiCounted
	; Refreshing the row costs more 6502 time than an iteration does, so
	; it happens every 32 -- often enough that the spinner still reads as
	; alive at the bench, rare enough not to throttle the access rate
	; this is trying to maximise.
	lda iters
	and #$1f
	bne eiNoShow
	jsr spin
eiNoShow
	; RUN/STOP, read the way the KERNAL does.
	lda $91
	cmp #$7f
	bne eiNoStop
	lda #1
	sta abortFlag
	sta phaseDone
	rts
eiNoStop
	lda iters+1
	cmp budHi
	bcc eiDone
	bne eiFull
	lda iters
	cmp budLo
	bcc eiDone
eiFull
	lda #1
	sta phaseDone
eiDone
	rts

bumpR
	inc issR
	bne brDone
	inc issR+1
brDone
	rts

bumpR8
	clc
	lda issR
	adc #N_BURST
	sta issR
	bcc br8Done
	inc issR+1
br8Done
	rts

bumpW8
	clc
	lda issW
	adc #N_BURST
	sta issW
	bcc bw8Done
	inc issW+1
bw8Done
	rts

; Preserves nothing; every caller has already finished with A.
bumpFF
	inc ffCount
	bne bfDone
	inc ffCount+1
bfDone
	rts

; ----------------------------------------------------------------------
; Snapshot arithmetic.
;
; All of it is 16-bit on the low word of what the firmware reports as a
; 32-bit counter. That is correct and not a shortcut: only differences
; are ever used, every difference here is far below 65536, and a 16-bit
; subtraction of two low words is exact across a 32-bit wrap.
; ----------------------------------------------------------------------

; Copies the four counters out of the current health block into prev*.
snapSave
	lda healthBuf + H_READS
	sta prevR
	lda healthBuf + H_READS + 1
	sta prevR+1
	lda healthBuf + H_WRITES
	sta prevW
	lda healthBuf + H_WRITES + 1
	sta prevW+1
	lda healthBuf + H_RDBAD
	sta prevRB
	lda healthBuf + H_RDBAD + 1
	sta prevRB+1
	lda healthBuf + H_WRBAD
	sta prevWB
	lda healthBuf + H_WRBAD + 1
	sta prevWB+1
	rts

; A = a GET_HEALTH offset (H_READS, H_WRITES, H_RDBAD or H_WRBAD).
; Returns the 16-bit difference against the matching prev* in dlt.
snapDelta
	tax
	; prev* are laid out in the same order as the four fields, two bytes
	; apart, so the offset selects the pair.
	ldy #0
	cpx #H_READS
	beq sdGo
	iny
	iny
	cpx #H_WRITES
	beq sdGo
	iny
	iny
	cpx #H_RDBAD
	beq sdGo
	iny
	iny
sdGo
	sty snapTmp
	sec
	lda healthBuf,x
	ldy snapTmp
	sbc prevR,y
	sta dlt
	inx
	lda healthBuf,x
	iny
	sbc prevR,y
	sta dlt+1
	rts

; A = the calibration constant to take off dlt (it is always small
; enough to be one byte).
subCal
	sta snapTmp
	sec
	lda dlt
	sbc snapTmp
	sta dlt
	lda dlt+1
	sbc #0
	sta dlt+1
	rts

; The CAL pass: dlt against the two counters, with no correction, is
; itself the correction every later rung uses.
calcCal
	lda #H_READS
	jsr snapDelta
	lda dlt
	sta calR
	lda #H_WRITES
	jsr snapDelta
	lda dlt
	sta calW
	rts

; --- result tables. Two bytes per rung, indexed by curRung*2. ---

storeRung
	lda curRung
	asl
	tax
	lda dlt
	sta sawTbl,x
	lda dlt+1
	sta sawTbl+1,x
	rts

storeBad
	lda curRung
	asl
	tax
	lda dlt
	sta badTbl,x
	lda dlt+1
	sta badTbl+1,x
	rts

; A/X = the issued count, low/high.
storeIssued
	sta snapTmp
	txa
	pha
	lda curRung
	asl
	tax
	lda snapTmp
	sta issTbl,x
	pla
	sta issTbl+1,x
	lda curRung
	asl
	tax
	lda ffCount
	sta ffTbl,x
	lda ffCount+1
	sta ffTbl+1,x
	rts

; ----------------------------------------------------------------------
; The verdict.
;
; Nothing here is judged against an expectation of zero events: the
; defect is rare and a clean run is a bound, not a proof. What the
; verdict does is name WHICH mechanism the run saw, which is the
; question the Quake screen could not answer.
; ----------------------------------------------------------------------

verdict
	lda trapKind
	beq vNoTrap
	lda #<txtTrapFail
	ldy #>txtTrapFail
	ldx #ROW_VERDICT
	jmp printAt
vNoTrap
	lda abortFlag
	beq vNoAbort
	lda #<txtAbort
	ldy #>txtAbort
	ldx #ROW_VERDICT
	jmp printAt
vNoAbort

	; anyBad: any rung with a mis-sampled address.
	lda #0
	ldx #0
vbLoop
	ora badTbl,x
	ora badTbl+1,x
	inx
	inx
	cpx #8
	bne vbLoop
	sta anyBad

	; anyShort: any rung whose SAW came out below its ISSD. Strictly
	; below -- a SAW above ISSD would mean this program miscounted its
	; own accesses, which is a different bug and is what the desk check
	; under runsim.py exists to catch before the bench.
	lda #0
	sta anyShort
	ldx #0
vsLoop
	lda sawTbl,x
	cmp issTbl,x
	lda sawTbl+1,x
	sbc issTbl+1,x
	bcs vsNext
	lda #1
	sta anyShort
vsNext
	inx
	inx
	cpx #8
	bne vsLoop

	; anyFF: any $FF answer at all.
	lda #0
	ldx #0
vfLoop
	ora ffTbl,x
	ora ffTbl+1,x
	inx
	inx
	cpx #8
	bne vfLoop
	sta anyFF

	lda anyBad
	beq vNotBad
	lda anyShort
	beq vBadOnly
	lda #<txtBoth
	ldy #>txtBoth
	ldx #ROW_VERDICT
	jmp printAt
vBadOnly
	lda #<txtMissampled
	ldy #>txtMissampled
	ldx #ROW_VERDICT
	jmp printAt
vNotBad
	lda anyShort
	beq vNotShort
	lda #<txtDropped
	ldy #>txtDropped
	ldx #ROW_VERDICT
	jmp printAt
vNotShort
	lda anyFF
	beq vClean
	lda #<txtUnexplained
	ldy #>txtUnexplained
	ldx #ROW_VERDICT
	jmp printAt
vClean
	lda #<txtClean
	ldy #>txtClean
	ldx #ROW_VERDICT
	jmp printAt

; ----------------------------------------------------------------------
; The Pi's opinion of itself. Called only between rungs -- never inside
; one, because a property-mailbox round trip is exactly the kind of load
; a rung is trying to hold constant, and because its own register
; traffic would land in the middle of the window being measured.
; ----------------------------------------------------------------------

doHealth
	lda #0
	sta ARG+0			; GPU64_SPACE_C64
	lda #<healthBuf
	sta ARG+1
	lda #>healthBuf
	sta ARG+2
	lda #0
	sta ARG+3
	lda #64
	sta ARG+4
	lda #0
	sta ARG+5
	lda #OP_GET_HEALTH
	sta CMD_LO
	lda ERRCODE
	sta healthErr
	rts

; ----------------------------------------------------------------------
; Display.
; ----------------------------------------------------------------------

showLabels
	lda #<txtCal
	ldy #>txtCal
	ldx #ROW_CAL
	jsr printAt
	lda #<txtHead
	ldy #>txtHead
	ldx #ROW_HEAD
	jsr printAt
	lda #<txtRead
	ldy #>txtRead
	ldx #ROW_READ
	jsr printAt
	lda #<txtDisp
	ldy #>txtDisp
	ldx #ROW_DISP
	jsr printAt
	lda #<txtFlip
	ldy #>txtFlip
	ldx #ROW_FLIP
	jsr printAt
	lda #<txtWrit
	ldy #>txtWrit
	ldx #ROW_WRIT
	jsr printAt
	lda #<txtBadAd
	ldy #>txtBadAd
	ldx #ROW_BADAD
	jsr printAt
	lda #<txtPhase
	ldy #>txtPhase
	ldx #ROW_PHASE
	jsr printAt
	lda #<txtAlive
	ldy #>txtAlive
	ldx #ROW_ALIVE
	jmp printAt

showCal
	lda #ROW_CAL
	jsr rowAddr
	ldy #COL_VAL
	lda calR
	jsr putHex
	iny
	lda calW
	jsr putHex
	iny
	; GET_HEALTH's own errcode. If this is not 00 every number below it
	; is meaningless -- healthBuf was never filled in and the deltas are
	; differences between two copies of whatever was there before.
	lda healthErr
	jsr putHex
	rts

showRungRow
	clc
	lda curRung
	adc #ROW_READ
	jsr rowAddr
	lda curRung
	asl
	tax
	ldy #COL_VAL
	lda issTbl+1,x
	jsr putHex
	lda issTbl,x
	jsr putHex
	iny
	lda sawTbl+1,x
	jsr putHex
	lda sawTbl,x
	jsr putHex
	iny
	lda badTbl+1,x
	jsr putHex
	lda badTbl,x
	jsr putHex
	iny
	; The write rung has no $FF column to fill: nothing reads a value
	; back, so there is no answer to judge. Four dashes rather than 0000,
	; which would read as a measurement that was made and came out empty.
	lda curRung
	cmp #IX_WRIT
	beq srDashes
	lda ffTbl+1,x
	jsr putHex
	lda ffTbl,x
	jsr putHex
	rts
srDashes
	lda #$2d			; screen code for '-'
	sta (DST),y
	iny
	sta (DST),y
	iny
	sta (DST),y
	iny
	sta (DST),y
	rts

showBadAddr
	lda #ROW_BADAD
	jsr rowAddr
	ldy #COL_VAL
	lda healthBuf + H_LASTBAD
	jsr putHex
	iny
	lda healthBuf + H_ORBAD
	jsr putHex
	iny
	lda healthBuf + H_ANDBAD
	jsr putHex
	iny
	lda healthBuf + H_LASTBW
	jsr putHex
	rts

showTrap
	lda #<txtTrap
	ldy #>txtTrap
	ldx #ROW_TRAP
	jsr printAt
	lda #ROW_TRAP
	jsr rowAddr
	ldy #COL_VAL
	lda trapKind
	jsr putHex
	iny
	iny
	iny
	lda trapPC+1
	jsr putHex
	lda trapPC
	jsr putHex
	rts

; A = screen code. Appends one letter to the phase row.
phase
	ldx phaseIdx
	cpx #16
	bcs phaseFull
	sta SCREEN + ROW_PHASE * 40 + COL_VAL, x
	inc phaseIdx
phaseFull
	rts

spin
	ldx spinIdx
	inx
	cpx #4
	bcc spinOk
	ldx #0
spinOk
	stx spinIdx
	lda spinTable,x
	sta SCREEN + ROW_ALIVE * 40 + COL_VAL
	rts

; ----------------------------------------------------------------------
; Traps. A BRK or NMI while a rung is running means the machine derailed,
; which is a different and much worse finding than anything the counters
; can report -- so it abandons the run rather than trying to continue.
; ----------------------------------------------------------------------

installTraps
	lda CBINV
	sta oldBrk
	lda CBINV+1
	sta oldBrk+1
	lda NMINV
	sta oldNmi
	lda NMINV+1
	sta oldNmi+1

	sei
	lda #<brkTrap
	sta CBINV
	lda #>brkTrap
	sta CBINV+1
	lda #<nmiTrap
	sta NMINV
	lda #>nmiTrap
	sta NMINV+1
	cli
	rts

; Put them back before returning to BASIC -- these vectors point into a
; program BASIC is free to overwrite.
removeTraps
	sei
	lda oldBrk
	sta CBINV
	lda oldBrk+1
	sta CBINV+1
	lda oldNmi
	sta NMINV
	lda oldNmi+1
	sta NMINV+1
	cli
	rts

; The KERNAL's IRQ entry has already pushed Y, X and A on top of the
; P/PCL/PCH the hardware pushed, so the interrupted address is six and
; seven bytes above the stack pointer.
brkTrap
	tsx
	lda $0105,x
	sta trapPC
	lda $0106,x
	sta trapPC+1
	lda #TRAP_BRK
	sta trapKind
	jsr showTrap

	ldx entrySP
	txs
	cli
	jmp allDone

; The NMI vector is taken with nothing pushed by the KERNAL, so the
; hardware frame is directly under the stack pointer.
nmiTrap
	tsx
	lda $0104,x
	sta trapPC
	lda $0105,x
	sta trapPC+1
	lda #TRAP_NMI
	sta trapKind
	jsr showTrap

	ldx entrySP
	txs
	cli
	jmp allDone

; ----------------------------------------------------------------------
; Screen output helpers. Identical to gpu64_probe_rmw.a's.
; ----------------------------------------------------------------------

clearScreen
	ldx #0
	lda #$20
cls1
	sta SCREEN,x
	sta SCREEN+$100,x
	sta SCREEN+$200,x
	sta SCREEN+$300,x
	inx
	bne cls1
	rts

; A/Y = string pointer (zero-terminated PETSCII), X = row.
printAt
	sta SRC
	sty SRC+1
	txa
	jsr rowAddr
	ldy #0
prLoop
	lda (SRC),y
	beq prDone
	cmp #$41
	bcc prPut
	cmp #$5b
	bcs prPut
	sec
	sbc #$40
prPut
	sta (DST),y
	iny
	bne prLoop
prDone
	rts

; A = row; leaves the row's screen address in DST.
rowAddr
	sta rowTmp
	lda #<SCREEN
	sta DST
	lda #>SCREEN
	sta DST+1
	ldx rowTmp
	beq rowDone
rowAdd
	clc
	lda DST
	adc #40
	sta DST
	lda DST+1
	adc #0
	sta DST+1
	dex
	bne rowAdd
rowDone
	rts

; A = byte, Y = column offset within the row DST already points at.
putHex
	pha
	lsr
	lsr
	lsr
	lsr
	jsr hexDigit
	sta (DST),y
	iny
	pla
	and #$0f
	jsr hexDigit
	sta (DST),y
	iny
	rts

hexDigit
	cmp #10
	bcs hexAlpha
	clc
	adc #$30
	rts
hexAlpha
	sec
	sbc #9
	rts

; ----------------------------------------------------------------------
; Data.
; ----------------------------------------------------------------------

txtTitle	.text "GPU64 PROBE BUS"
		.byte 0
txtCal		.text "CAL"
		.byte 0
txtHead		.text "       ISSD SAW  BAD  FF"
		.byte 0
txtRead		.text "READ"
		.byte 0
txtDisp		.text "DISP"
		.byte 0
txtFlip		.text "FLIP"
		.byte 0
txtWrit		.text "WRIT"
		.byte 0
txtBadAd	.text "BADAD"
		.byte 0
txtPhase	.text "PHASE"
		.byte 0
txtAlive	.text "ALIVE"
		.byte 0
txtTrap		.text "TRAP"
		.byte 0

; -, N-shape, ], M-shape: four screen codes that read as a turning bar.
spinTable	.byte $2d, $4e, $5d, $4d

txtClean	.text "VERDICT CLEAN - NO EVENT"
		.byte 0
txtMissampled	.text "VERDICT MIS-SAMPLED ADDRESS"
		.byte 0
txtDropped	.text "VERDICT DROPPED ACCESS"
		.byte 0
txtBoth		.text "VERDICT MIS-SAMPLED AND DROPPED"
		.byte 0
txtUnexplained	.text "VERDICT UNEXPLAINED FF"
		.byte 0
txtTrapFail	.text "VERDICT FAIL - TRAP"
		.byte 0
txtAbort	.text "VERDICT ABORT - RUN/STOP"
		.byte 0

; ----------------------------------------------------------------------
; Variables.
; ----------------------------------------------------------------------

curRung		.byte 0
budLo		.byte 0
budHi		.byte 0
phaseDone	.byte 0
abortFlag	.byte 0

iters		.word 0
issR		.word 0
issW		.word 0
ffCount		.word 0

; The four prev* pairs MUST stay in this order and adjacent: snapDelta
; indexes them as one array, in the order reads, writes, readsBad,
; writesBad.
prevR		.word 0
prevW		.word 0
prevRB		.word 0
prevWB		.word 0

dlt		.word 0
calR		.byte 0
calW		.byte 0

issTbl		.fill 8, 0
sawTbl		.fill 8, 0
badTbl		.fill 8, 0
ffTbl		.fill 8, 0

anyBad		.byte 0
anyShort	.byte 0
anyFF		.byte 0

rowTmp		.byte 0
snapTmp		.byte 0
entrySP		.byte 0
phaseIdx	.byte 0
spinIdx		.byte 0
trapKind	.byte 0
trapPC		.word 0

healthErr	.byte 0
healthBuf	.fill 64, 0
oldBrk		.word 0
oldNmi		.word 0
