;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- milestone 6 phase 1 bench: a textured, lit, z-buffered box.
;
;      WHAT THIS TESTS
;
;      Everything between a class 1 command arriving and a pixel changing:
;      the fixed-point transform, backface culling, the directional light
;      through a generated colormap, near-plane clipping, the affine texture
;      mapper and the 16-bit z-buffer. All of it runs on core 0 inside the
;      dispatch window, exactly like a class 0 draw op -- the render loop on
;      core 1 is phase 4 and is not exercised here beyond the ring counter.
;
;      The identical scene has already been rendered on a PC by
;      tools/hostsim, which writes out/prgpreview.ppm. THAT PICTURE IS THE
;      EXPECTED RESULT. Hold the HDMI output against it: the pipeline is
;      byte-for-byte the same code, so any difference is the firmware's
;      plumbing -- the blob pull, the palette, the page flip, the cache
;      clean -- and not the maths.
;
;      HOW TO READ THE RESULT
;
;      The C64's own screen carries the diagnosis; the HDMI screen carries
;      the picture. Every setup command's ERRCODE is printed, in order, so a
;      failed run says which step failed rather than just showing a blank
;      viewport:
;
;        GPU64 3D CUBE
;
;        SETUP   00 00 00 00 00 00 00 00     all zero = every setup command
;                                            was accepted
;        FRAME   nnnn                        frames drawn so far
;        TRIS    06                          <== THE ONE THAT MATTERS
;        ERR     00                          last draw's ERRCODE
;
;      TRIS is DRAW_MESH's RESULT register: the number of triangles it
;      actually rasterised. Six is right for this box at this angle -- three
;      faces, two triangles each. The value distinguishes the two failures a
;      blank screen cannot:
;
;        TRIS 06, nothing on HDMI  -> the geometry was drawn somewhere you
;                                     are not looking, or the page flip or
;                                     the cache clean is wrong
;        TRIS 00                   -> every face was culled: winding, the
;                                     backface test, or the near plane
;        ERR 0A                    -> BAD_ID, the mesh upload did not stick
;        ERR 08                    -> OUT_OF_MEMORY, the arena is exhausted
;
;      A SETUP row with a non-zero entry means the run never got as far as
;      drawing, and the position of the non-zero byte names the command --
;      the order is the same as the SETUP sequence below.
;
;      RUN/STOP exits back to BASIC.
;
;      Requires a firmware built with GPU64_3D_ENABLED (Source/Firmware/
;      gpu64_3d.h), and the RAD menu switched to REU mode with T -- without
;      that, reuUsingPolling() never runs and no command is ever seen.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

CMD_HI   = $df50
CMD_LO   = $df51
STATUS   = $df52
ERRCODE  = $df53
ID_LO    = $df54
ID_HI    = $df55
ARG      = $df56
RESULT   = $df66

; class 0
OP_PAGE_FLIP     = $05
OP_PAL_LOAD      = $31

; class 1 -- dev/milestone6_3d_design.md
OP_SET_VIEWPORT    = $01
OP_SET_PERSPECTIVE = $02
OP_SET_LIGHT       = $03
OP_BUILD_COLORMAP  = $04
OP_SET_BACKGROUND  = $05
OP_UPLOAD_MESH     = $10
OP_UPLOAD_TEXTURE  = $11
OP_CLEAR_VIEWPORT  = $40
OP_DRAW_MESH       = $41

SCREEN   = $0400

; zero page scratch. $fb-$fe are free in a BASIC-hosted program.
SRC      = $fb
DST      = $fd

PALBUF   = $4000		; 256 x 3 bytes
TEXBUF   = $5000		; 64 x 64 texels

TEX_ID   = 1
MESH_ID  = 2

; Resource IDs are C64-assigned and this program owns the whole namespace.

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	jsr clearScreen
	lda #<txtTitle
	ldy #>txtTitle
	ldx #0
	jsr printAt

	; Both generated rather than shipped as data: the palette is 768 bytes
	; and the texture 4096, which together would be five times the size of
	; the rest of this program.
	jsr buildPalette
	jsr buildTexture

	jsr doSetup
	jsr showSetup
	jsr showLabels

	jmp mainLoop

; ----------------------------------------------------------------------
; Command helpers.
;
; Writing CMD_LO is what dispatches; CMD_HI is sticky and selects the class.
; The C64 is DMA-halted for the whole dispatch, so there is nothing to poll
; and no handshake -- ERRCODE is valid on the very next instruction.
; ----------------------------------------------------------------------

cmd0
	ldx #0
	stx CMD_HI
	sta CMD_LO
	lda ERRCODE
	rts

cmd1
	ldx #1
	stx CMD_HI
	sta CMD_LO
	lda ERRCODE
	rts

; Records the ERRCODE in A into the setup log, in order.
logStep
	ldx setupIdx
	sta setupErr,x
	inc setupIdx
	rts

; ----------------------------------------------------------------------
; Setup: one command per step, each logged.
; ----------------------------------------------------------------------

doSetup
	lda #0
	sta setupIdx

	; --- step 0/1: the palette, in two halves -----------------------
	; PAL_LOAD's count is a single byte, so 256 entries do not fit in one
	; command. Two calls of 128 rather than 255 + 1: equal halves are
	; easier to check by eye in a memory dump than an odd remainder.
	lda #0
	jsr palLoadHalf
	jsr logStep

	lda #128
	jsr palLoadHalf
	jsr logStep

	; --- step 2: viewport 256x160, centred --------------------------
	; Leaves a 32-pixel margin each side and 20 top and bottom, which is
	; where a program's class 0 HUD would go. The render loop never writes
	; outside this rectangle.
	lda #32
	sta ARG+0
	lda #0
	sta ARG+1
	lda #20
	sta ARG+2
	lda #0
	sta ARG+3
	lda #<256
	sta ARG+4
	lda #>256
	sta ARG+5
	lda #<160
	sta ARG+6
	lda #>160
	sta ARG+7
	lda #OP_SET_VIEWPORT
	jsr cmd1
	jsr logStep

	; --- step 3: perspective ----------------------------------------
	; fov $2AAB is 60 degrees as a binary angle. near and far are 8.8, so
	; the far plane cannot exceed 127.99 units -- a real limit of the wire
	; format, and the reason this scene lives at z=70 rather than z=700.
	lda #$AB
	sta ARG+0
	lda #$2A
	sta ARG+1
	lda #$00			; near = 1.0
	sta ARG+2
	lda #$01
	sta ARG+3
	lda #$00			; far = 120.0
	sta ARG+4
	lda #$78
	sta ARG+5
	lda #OP_SET_PERSPECTIVE
	jsr cmd1
	jsr logStep

	; --- step 4: the light ------------------------------------------
	; Direction (-5, 7, -6) in 8.8, i.e. from the upper left and towards
	; the viewer. The firmware normalises it, so the magnitudes only set
	; the direction. Ambient 3 of 15 keeps an unlit face readable.
	lda #<-1280
	sta ARG+0
	lda #>-1280
	sta ARG+1
	lda #<1792
	sta ARG+2
	lda #>1792
	sta ARG+3
	lda #<-1536
	sta ARG+4
	lda #>-1536
	sta ARG+5
	lda #3
	sta ARG+6
	lda #OP_SET_LIGHT
	jsr cmd1
	jsr logStep

	; --- step 5: background, then the colormap ----------------------
	lda #0
	sta ARG+0
	lda #OP_SET_BACKGROUND
	jsr cmd1
	jsr logStep

	; BUILD_COLORMAP reads the palette that is installed *now*, which is
	; why it comes after PAL_LOAD and not before. It costs milliseconds
	; and the C64 is halted for all of them; never call it per frame.
	lda #OP_BUILD_COLORMAP
	jsr cmd1
	jsr logStep

	; --- step 6: the texture ----------------------------------------
	lda #<TEX_ID
	sta ID_LO
	lda #>TEX_ID
	sta ID_HI
	lda #0				; space 0 = C64 RAM
	sta ARG+0
	lda #<TEXBUF
	sta ARG+1
	lda #>TEXBUF
	sta ARG+2
	lda #0
	sta ARG+3
	lda #<4096
	sta ARG+4
	lda #>4096
	sta ARG+5
	lda #6				; 1<<6 = 64 wide
	sta ARG+6
	lda #6				; 1<<6 = 64 high
	sta ARG+7
	lda #OP_UPLOAD_TEXTURE
	jsr cmd1
	jsr logStep

	; --- step 7: the mesh -------------------------------------------
	; Two blob descriptors in one 16-byte ARG block, which is the whole
	; reason the mesh format is two blobs and not three.
	lda #<MESH_ID
	sta ID_LO
	lda #>MESH_ID
	sta ID_HI
	lda #0
	sta ARG+0
	lda #<vertBlob
	sta ARG+1
	lda #>vertBlob
	sta ARG+2
	lda #0
	sta ARG+3
	lda #48
	sta ARG+4
	lda #0
	sta ARG+5
	lda #0
	sta ARG+6
	lda #<faceBlob
	sta ARG+7
	lda #>faceBlob
	sta ARG+8
	lda #0
	sta ARG+9
	lda #144
	sta ARG+10
	lda #0
	sta ARG+11
	lda #OP_UPLOAD_MESH
	jsr cmd1
	jsr logStep

	rts

; A = first palette index; loads 128 entries from PALBUF + A*3.
palLoadHalf
	sta palFirst

	; A*3 as the offset into PALBUF, in 16 bits: 128*3 = 384 does not fit
	; in a byte.
	sta $fb
	lda #0
	sta $fc
	asl $fb
	rol $fc				; x2
	clc
	lda $fb
	adc palFirst
	sta $fb
	lda $fc
	adc #0
	sta $fc				; x3

	clc
	lda $fb
	adc #<PALBUF
	sta ARG+1
	lda $fc
	adc #>PALBUF
	sta ARG+2

	lda #0
	sta ARG+0			; space 0 = C64 RAM
	sta ARG+3
	lda #<384			; 128 entries x 3 bytes
	sta ARG+4
	lda #>384
	sta ARG+5
	lda palFirst
	sta ARG+6
	lda #128
	sta ARG+7

	lda #OP_PAL_LOAD
	jmp cmd0

; ----------------------------------------------------------------------
; The frame loop.
; ----------------------------------------------------------------------

mainLoop
	; CLEAR_VIEWPORT fills the viewport with the background index and
	; resets the z-buffer. Only the viewport: anything the C64 drew
	; outside it with class 0 survives.
	lda #OP_CLEAR_VIEWPORT
	jsr cmd1

	lda #<MESH_ID
	sta ID_LO
	lda #>MESH_ID
	sta ID_HI

	lda #0				; position x, 8.8
	sta ARG+0
	sta ARG+1
	sta ARG+2			; position y
	sta ARG+3
	lda #$00			; position z = 70.0
	sta ARG+4
	lda #$46
	sta ARG+5

	lda angle
	sta ARG+6			; yaw, binary angle
	lda angle+1
	sta ARG+7
	lda #$00			; pitch -- a constant tilt about the
	sta ARG+8			; box's OWN x axis, so it turns with
	lda #$F0			; the yaw and the box tumbles rather
	sta ARG+9			; than spinning flat. Any non-zero
					; value will do; what this is here to
					; prove is that a second face is
					; visible, because a cube that renders
					; as one flat quad is the signature of
					; a broken transform.
	lda #0				; roll
	sta ARG+10
	sta ARG+11
	lda #$00			; scale 1.0 in 8.8
	sta ARG+12
	lda #$01
	sta ARG+13

	lda #OP_DRAW_MESH
	jsr cmd1
	sta lastErr
	lda RESULT
	sta lastTris

	; Immediate flip, not the vblank-deferred one: this loop has nothing
	; else to do while it waits, and a flip that cannot fail is one fewer
	; thing to have got wrong on the first hardware run. ARG0 = 1 is the
	; deferred form and is worth trying once this picture is right.
	lda #0
	sta ARG+0
	lda #OP_PAGE_FLIP
	jsr cmd0

	clc
	lda angle
	adc #$00
	sta angle
	lda angle+1
	adc #$02			; ~2.8 degrees a frame
	sta angle+1

	inc frames
	bne +
	inc frames+1
+
	jsr showFrame

	; RUN/STOP, read the way the KERNAL does.
	lda $91
	cmp #$7f
	bne quit

	jmp mainLoop

quit
	lda #0
	sta CMD_HI
	rts

; ----------------------------------------------------------------------
; The palette: 32 hues x 8 brightnesses.
;
; The colormap only works as well as the palette gives it room to: it maps a
; darkened colour to the nearest entry the palette actually has, so a palette
; with no dark tones has nowhere to go and every light level collapses onto
; the same index. Eight steps per hue is what makes 16 light levels legible.
; ----------------------------------------------------------------------

buildPalette
	lda #<PALBUF
	sta DST
	lda #>PALBUF
	sta DST+1

	lda #<hueTable
	sta SRC
	lda #>hueTable
	sta SRC+1

	lda #0
	sta hueIdx

palHue
	lda #0
	sta briIdx

palBri
	ldy #0
palChan
	; entry = hue * (brightness + 1) / 8, in 16 bits so the intermediate
	; does not wrap: 255 * 8 is 2040.
	lda (SRC),y
	sta mulA
	lda #0
	sta mulL
	sta mulH
	ldx briIdx
	inx
palMulLoop
	clc
	lda mulL
	adc mulA
	sta mulL
	lda mulH
	adc #0
	sta mulH
	dex
	bne palMulLoop

	lsr mulH
	ror mulL
	lsr mulH
	ror mulL
	lsr mulH
	ror mulL

	lda mulL
	sta (DST),y
	iny
	cpy #3
	bne palChan

	clc
	lda DST
	adc #3
	sta DST
	lda DST+1
	adc #0
	sta DST+1

	inc briIdx
	lda briIdx
	cmp #8
	bne palBri

	clc
	lda SRC
	adc #3
	sta SRC
	lda SRC+1
	adc #0
	sta SRC+1

	inc hueIdx
	lda hueIdx
	cmp #32
	bne palHue

	; Index 0 is the viewport background and index 255 is the firmware's
	; reserved log ink; both are written last so the loop above does not
	; have to special-case them.
	lda #16
	sta PALBUF+0
	sta PALBUF+1
	sta PALBUF+2
	lda #255
	sta PALBUF+765
	sta PALBUF+766
	sta PALBUF+767
	rts

; ----------------------------------------------------------------------
; The texture: a 64x64 checker with one off-centre marker block, so a
; mirrored or rotated texture lookup is visible rather than merely suspected.
; ----------------------------------------------------------------------

buildTexture
	lda #<TEXBUF
	sta DST
	lda #>TEXBUF
	sta DST+1

	lda #0
	sta texY

texRow
	ldy #0
texCol
	; ((x >> 3) ^ (y >> 3)) & 1 picks the square.
	tya
	lsr
	lsr
	lsr
	sta texTmp
	lda texY
	lsr
	lsr
	lsr
	eor texTmp
	and #1
	beq texB

	lda #(10*8)+7			; a bright cyan-ish hue at full strength
	jmp texStore
texB
	lda #(13*8)+4			; a mid blue

texStore
	sta texPix

	; The marker: x in 4..15, y in 4..9.
	lda texY
	cmp #4
	bcc texPut
	cmp #10
	bcs texPut
	cpy #4
	bcc texPut
	cpy #16
	bcs texPut
	lda #(3*8)+7			; orange
	sta texPix

texPut
	lda texPix
	sta (DST),y
	iny
	cpy #64
	bne texCol

	clc
	lda DST
	adc #64
	sta DST
	lda DST+1
	adc #0
	sta DST+1

	inc texY
	lda texY
	cmp #64
	bne texRow
	rts

; ----------------------------------------------------------------------
; Screen output. Nothing here touches the API.
; ----------------------------------------------------------------------

clearScreen
	ldx #0
	lda #$20
cls1
	sta SCREEN,x
	sta SCREEN+$100,x
	sta SCREEN+$200,x
	sta SCREEN+$300,x
	inx
	bne cls1
	rts

; A/Y = string pointer (zero-terminated PETSCII), X = row.
printAt
	sta SRC
	sty SRC+1
	txa
	jsr rowAddr
	ldy #0
prLoop
	lda (SRC),y
	beq prDone
	cmp #$41
	bcc prPut
	cmp #$5b
	bcs prPut
	sec
	sbc #$40			; PETSCII upper case -> screen code
prPut
	sta (DST),y
	iny
	bne prLoop
prDone
	rts

; A = row; leaves the row's screen address in DST.
rowAddr
	sta rowTmp
	lda #<SCREEN
	sta DST
	lda #>SCREEN
	sta DST+1
	ldx rowTmp
	beq rowDone
rowAdd
	clc
	lda DST
	adc #40
	sta DST
	lda DST+1
	adc #0
	sta DST+1
	dex
	bne rowAdd
rowDone
	rts

; A = byte, Y = column offset within the row DST already points at.
putHex
	pha
	lsr
	lsr
	lsr
	lsr
	jsr hexDigit
	sta (DST),y
	iny
	pla
	and #$0f
	jsr hexDigit
	sta (DST),y
	iny
	rts

hexDigit
	cmp #10
	bcs hexAlpha
	clc
	adc #$30			; screen code for '0'
	rts
hexAlpha
	sec
	sbc #9				; screen code for 'A' is 1
	rts

showSetup
	lda #<txtSetup
	ldy #>txtSetup
	ldx #3
	jsr printAt

	lda #3
	jsr rowAddr
	ldy #8
	ldx #0
ssLoop
	lda setupErr,x
	jsr putHex
	iny				; a space between entries
	inx
	cpx #8
	bne ssLoop
	rts

; The live rows are labelled once, at startup. Four bare hex fields at fixed
; offsets is exactly the mistake the phase 0 bench made and had to undo: a
; result you have to count screen lines to read is a result you can misread.
showLabels
	lda #<txtFrame
	ldy #>txtFrame
	ldx #5
	jsr printAt
	lda #<txtTris
	ldy #>txtTris
	ldx #6
	jsr printAt
	lda #<txtErr
	ldy #>txtErr
	ldx #7
	jmp printAt

showFrame
	lda #5
	jsr rowAddr
	ldy #8
	lda frames+1
	jsr putHex
	lda frames
	jsr putHex

	lda #6
	jsr rowAddr
	ldy #8
	lda lastTris
	jsr putHex

	lda #7
	jsr rowAddr
	ldy #8
	lda lastErr
	jsr putHex
	rts

; ----------------------------------------------------------------------
; Data.
; ----------------------------------------------------------------------

txtTitle
	.text "GPU64 3D CUBE"
	.byte 0
txtSetup
	.text "SETUP"
	.byte 0
txtFrame
	.text "FRAME"
	.byte 0
txtTris
	.text "TRIS"
	.byte 0
txtErr
	.text "ERR"
	.byte 0

hueTable
	.byte 255,  64,  64
	.byte 255, 112,  48
	.byte 255, 160,  32
	.byte 255, 208,  32
	.byte 240, 255,  32
	.byte 176, 255,  32
	.byte 112, 255,  48
	.byte  48, 255,  64
	.byte  32, 255, 128
	.byte  32, 255, 192
	.byte  32, 240, 255
	.byte  32, 192, 255
	.byte  48, 144, 255
	.byte  64,  96, 255
	.byte  96,  64, 255
	.byte 144,  48, 255
	.byte 192,  32, 255
	.byte 240,  32, 255
	.byte 255,  32, 192
	.byte 255,  48, 128
	.byte 176, 112,  80
	.byte 208, 144, 104
	.byte 128,  96,  64
	.byte  96, 128,  96
	.byte 255, 255, 255
	.byte 224, 224, 224
	.byte 192, 192, 192
	.byte 160, 160, 160
	.byte 128, 128, 128
	.byte  96,  96,  96
	.byte  64,  64,  64
	.byte  32,  32,  32

; The box: wider than it is tall, with the top face pushed off-centre in x,
; so an upside-down or mirrored render is obvious at a glance. A symmetric
; cube renders identically under half a dozen distinct bugs.
;
; Winding is clockwise as seen from outside, which is what makes the
; firmware's cross-product normal point outwards. Reverse it and every face
; of this closed mesh is culled -- TRIS reads 00 and the viewport stays
; empty, which is why TRIS is on the screen.

vertBlob
	.byte $00, $e8, $00, $f2, $00, $ec, $00, $18, $00, $f2, $00, $ec
	.byte $00, $18, $00, $f2, $00, $14, $00, $e8, $00, $f2, $00, $14
	.byte $00, $ef, $00, $0e, $00, $ec, $00, $1f, $00, $0e, $00, $ec
	.byte $00, $1f, $00, $0e, $00, $14, $00, $ef, $00, $0e, $00, $14

faceBlob
	.byte $00, $01, $02, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $00, $02, $03, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $07, $06, $05, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $07, $05, $04, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $00, $04, $05, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $00, $05, $01, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $02, $06, $07, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $02, $07, $03, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $03, $07, $04, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $03, $04, $00, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $01, $05, $06, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $01, $06, $02, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00

; ----------------------------------------------------------------------
; Variables.
; ----------------------------------------------------------------------

setupIdx	.byte 0
setupErr	.fill 8, $ff
palFirst	.byte 0
hueIdx		.byte 0
briIdx		.byte 0
mulA		.byte 0
mulL		.byte 0
mulH		.byte 0
texY		.byte 0
texTmp		.byte 0
texPix		.byte 0
rowTmp		.byte 0
angle		.word 0
frames		.word 0
lastTris	.byte 0
lastErr		.byte 0
