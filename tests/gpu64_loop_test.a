; Copyright (c) 2026 Honza Slesinger. GPL-3.0-or-later (see LICENSE).
;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- stage 16: LOOP_START / SCENE_COMMIT / LOOP_STOP.
;
;      WHAT THIS TESTS
;
;      The handshake-mode autonomous render loop end to end -- nothing else
;      in tests exercises these three opcodes at all:
;
;        1. LOOP_START before an active camera exists answers NO_CAMERA, and
;           does not start the loop (checked by immediately doing the real
;           SET_ACTIVE_CAMERA/LOOP_START right after and requiring THAT to
;           succeed).
;        2. LOOP_START while already running, and CLEAR_VIEWPORT (immediate
;           mode) while the loop is running, both answer BUSY -- the "loop
;           owns the framebuffer" rule from precheckClearViewport().
;        3. While the loop runs, ROTATE_LOCAL is shadow-redirected: it
;           returns immediately (no ring wait) and only takes visible effect
;           after the next SCENE_COMMIT.
;        4. SCENE_COMMIT's OK/RESULT/STATUS for six consecutive frames:
;           RESULT is the page just rendered into (must cycle through the
;           three flip pages, i.e. stay under 3), and STATUS read
;           immediately after must have FRAME_READY (bit 4) clear -- a
;           commit that just armed a new frame has, by construction, not
;           finished it yet.
;        5. LOOP_STOP (keyed) always answers OK, and CLEAR_VIEWPORT is
;           accepted straight after it -- immediate mode restored. A
;           SCENE_COMMIT then answers OK too, because since 2026-09-10 a
;           commit against a stopped loop RE-ARMS it rather than refusing
;           with UNSUPPORTED, so one mis-sampled byte cannot end a session
;           (see SCENE_COMMIT in Source/Firmware/gpu64_3d_class1.cpp). The
;           fourth check is CLEAR_VIEWPORT again, now expected to answer
;           BUSY: that is what proves the re-arm was real rather than the
;           commit merely being ignored.
;
;      HOW TO READ THE RESULT
;
;        GPU64 LOOP TEST
;
;        SETUP  00 00 00 00 00 00 00 00 00     all zero = every setup
;                                              command was accepted (same
;                                              nine steps as gpu64_3d_cube.a)
;        SCENE  00 0B 00 00 00 00 07 07        the five checks above, in
;                                              order -- see EXPECTED below
;        POST   00 00 00 07                    LOOP_STOP, CLEAR_VIEWPORT-
;                                              after-stop, SCENE_COMMIT
;                                              (re-arms, so OK), then
;                                              CLEAR_VIEWPORT again, now
;                                              BUSY because of that re-arm
;        FRAME  nnnn/mmmm                      commits attempted / commits
;                                              that answered OK. The two
;                                              are separate because a run
;                                              where every commit is
;                                              refused still counts frames,
;                                              and the old single number
;                                              could not tell that from a
;                                              healthy run.
;        ROT ERR  00                           last ROTATE_LOCAL's ERRCODE
;        COMMIT ERR  00                        last SCENE_COMMIT's ERRCODE
;        PAGE   00                             last SCENE_COMMIT's RESULT
;        MISSED  0000                         count of ROTATE_LOCAL/
;                                              SCENE_COMMIT dispatches whose
;                                              SEQACK didn't match the SEQ
;                                              this program wrote -- i.e. a
;                                              write the bus-watch loop did
;                                              not sample (see
;                                              dev/reliability_protocol_design.md).
;                                              Should stay 0000; nonzero
;                                              confirms the pre-existing
;                                              drop defect, not a new bug.
;        FIRST ERR  00 @ 0000                  the FIRST commit ERRCODE
;                                              that was not OK, and the
;                                              frame it happened on. Sticky:
;                                              COMMIT ERR above only shows
;                                              the last one, which a single
;                                              good frame afterwards erases.
;        PHASE  SCAPV                          one letter per stage the
;                                              program reached: S(etup)
;                                              C(scene) A(nimate) or
;                                              K(skipped) P(ost) V(erdict).
;                                              If it stops short, THAT is
;                                              where the hang is.
;        ALIVE  -  STAGE 30                    a spinner advanced once per
;                                              animation frame, and where
;                                              in the frame the program is:
;                                              10/11 = before/after the
;                                              ROTATE_LOCAL dispatch,
;                                              20/21 = before/after the
;                                              SCENE_COMMIT dispatch,
;                                              30 = between frames. A
;                                              frozen spinner means the C64
;                                              itself is stopped; a turning
;                                              spinner with a frozen HDMI
;                                              picture means it is not.
;        TRAP  00 PC 0000                      shown ONLY if a BRK or an
;                                              NMI was taken -- the marker
;                                              (01 = BRK, 02 = NMI) and the
;                                              return address. A run that
;                                              derailed into the weeds
;                                              usually hits a BRK; without
;                                              this it looked identical to
;                                              a hang.
;
;      The box turns on HDMI, driven by the render loop rather than by the
;      C64 issuing DRAW_NODE itself. Watch it turn, then press RUN/STOP to
;      end the animation early -- or just leave it alone: it stops on its
;      own after AUTO_STOP_FRAMES commits, so the POST checks and the
;      verdict always run even if nobody is at the keyboard. That matters
;      because a run that needs an operator keypress produces no verdict at
;      all when the thing being tested is whether the C64 is still alive.
;
;        VERDICT PASS
;
;      EXPECTED for SCENE, in order: 00 (CREATE_CAMERA), 0B (LOOP_START, no
;      camera yet -- NO_CAMERA), 00 (SET_ACTIVE_CAMERA), 00 (CREATE_OBJECT),
;      00 (SET_POSITION), 00 (LOOP_START for real), 07 (LOOP_START again
;      while running -- BUSY), 07 (CLEAR_VIEWPORT while running -- BUSY).
;
;      Requires a firmware built with GPU64_3D_ENABLED, and the RAD menu
;      switched to REU mode with T.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

CMD_HI   = $df50
CMD_LO   = $df51
STATUS   = $df52
ERRCODE  = $df53
ID_LO    = $df54
ID_HI    = $df55
ARG      = $df56
RESULT   = $df66
SEQ      = $df67
SEQACK   = $df68

STATUS_FRAME_READY = $10

ERR_BUSY = $07

; class 0
OP_PAL_LOAD      = $31

; class 1 -- docs/class1-3d-mesh-reference.md
OP_SET_VIEWPORT     = $01
OP_SET_PERSPECTIVE  = $02
OP_SET_LIGHT        = $03
OP_BUILD_COLORMAP   = $04
OP_SET_BACKGROUND   = $05
OP_LOOP_START       = $06
OP_LOOP_STOP        = $07
OP_SCENE_COMMIT     = $08
OP_UPLOAD_MESH      = $10
OP_UPLOAD_TEXTURE   = $11
OP_CREATE_OBJECT    = $20
OP_CREATE_CAMERA    = $21
OP_SET_ACTIVE_CAMERA = $23
OP_SET_POSITION     = $30
OP_ROTATE_LOCAL     = $34
OP_CLEAR_VIEWPORT   = $40

SCREEN   = $0400

; zero page scratch. $fb-$fe are free in a BASIC-hosted program.
SRC      = $fb
DST      = $fd

PALBUF   = $4000		; 256 x 3 bytes
TEXBUF   = $5000		; 64 x 64 texels

TEX_ID   = 1
MESH_ID  = 2
CAM_ID   = 10
OBJ_ID   = 20

; How many SCENE_COMMITs get their ERRCODE/RESULT/STATUS individually
; checked in the verdict, rather than just shown live. Six is enough to
; prove the page cycles rather than sticking on one value.
COMMIT_LOG_COUNT = 6

; The animation ends by itself after this many commits, whether or not
; anyone touches the keyboard. At roughly a frame each that is about ten
; seconds -- long enough to watch the box turn and well past the frame-98
; onset that a short desk check once missed, short enough that a bench run
; costs seconds. Without it the only exit was RUN/STOP, so a run left
; unattended (or one where the C64 stops responding to the keyboard)
; produced no POST checks and no verdict at all.
AUTO_STOP_FRAMES = 600

; Screen rows. Kept as named constants because the trap handlers and the
; spinner write to the screen directly, without going through printAt.
ROW_FRAME    = 6
ROW_ROT      = 7
ROW_COMMIT   = 8
ROW_PAGE     = 9
ROW_MISSED   = 10
ROW_FIRSTERR = 11
ROW_PHASE    = 13
ROW_ALIVE    = 14
ROW_TRAP     = 16
ROW_LOG1     = 15
ROW_LOG2     = 17
ROW_VERDICT  = 18
ROW_CURSOR   = 20

COL_VAL      = 14

; Phase breadcrumb letters, as screen codes (letter - $40).
PH_SETUP   = $13		; S
PH_SCENE   = $03		; C
PH_ANIM    = $01		; A
PH_SKIP    = $0b		; K -- the loop never started, animation skipped
PH_POST    = $10		; P
PH_VERDICT = $16		; V

; Verdict reason codes: what failed, printed beside the word FAIL.
WHY_TRAP    = $01		; a BRK or an NMI happened
WHY_SETUP   = $02		; a setup command returned an error
WHY_SCENE   = $03		; the scene/loop sequence answered unexpectedly
WHY_POST    = $04		; a post-stop check answered unexpectedly
WHY_ROT     = $05		; a logged frame's ROTATE_LOCAL failed
WHY_COMMIT  = $06		; a logged commit answered neither OK nor BUSY
WHY_PAGE    = $07		; an accepted commit reported a page outside 0-2
WHY_READY   = $08		; FRAME_READY was already set right after a commit
WHY_NOFRAME = $09		; the loop ran and not one commit was ever accepted

; Trap markers.
TRAP_BRK = $01
TRAP_NMI = $02

; KERNAL vectors and calls.
CBINV = $0316			; BRK
NMINV = $0318			; NMI
PLOT  = $fff0

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	; Remembered so a trap can put the stack back the way BASIC left it and
	; still let the final RTS return there.
	tsx
	stx entrySP

	jsr clearScreen
	lda #<txtTitle
	ldy #>txtTitle
	ldx #0
	jsr printAt

	jsr installTraps

	; Same generated palette/texture as gpu64_3d_cube.a -- see there for
	; why they are built rather than shipped as data.
	jsr buildPalette
	jsr buildTexture

	lda #PH_SETUP
	jsr phase
	jsr doSetup
	jsr showSetup
	jsr showLabels

	lda #PH_SCENE
	jsr phase
	jsr doSceneSetup
	jsr showScene

	; If LOOP_START (the real one, sceneErr+5) failed there is nothing to
	; animate -- skip straight to the verdict rather than spinning on a
	; loop that never started. The breadcrumb records which of the two
	; happened, because "no FRAME count" on its own does not say whether
	; the animation was skipped or hung on its first commit.
	lda sceneErr+5
	beq runAnim

	lda #PH_SKIP
	jsr phase
	jmp skipAnim

runAnim
	lda #PH_ANIM
	jsr phase
	jsr animLoop

skipAnim
	; Once more with the final numbers -- also the only thing that fills
	; the live rows in at all when the animation was skipped.
	jsr showAnim

	lda #PH_POST
	jsr phase
	jsr doPostChecks
	jsr showPost

	jsr showLog

	lda #PH_VERDICT
	jsr phase
	jsr verdict

	jsr removeTraps

	lda #0
	sta CMD_HI

	; Park the cursor below the report so BASIC's READY. and whatever the
	; operator types next does not scroll the thing they came to read off
	; the top of the screen.
	clc
	ldx #ROW_CURSOR
	ldy #0
	jsr PLOT
	rts

; ----------------------------------------------------------------------
; Breadcrumb, traps, spinner: the three things that tell an operator at
; the bench whether the C64 is alive, and if not, where it died. All of
; them write the screen directly rather than through printAt, so they are
; safe to call from an interrupt handler.
; ----------------------------------------------------------------------

; A = screen code. Appends one letter to the phase row.
phase
	ldx phaseIdx
	cpx #16
	bcs phaseFull
	sta SCREEN + ROW_PHASE * 40 + COL_VAL, x
	inc phaseIdx
phaseFull
	rts

installTraps
	lda CBINV
	sta oldBrk
	lda CBINV+1
	sta oldBrk+1
	lda NMINV
	sta oldNmi
	lda NMINV+1
	sta oldNmi+1

	sei
	lda #<brkTrap
	sta CBINV
	lda #>brkTrap
	sta CBINV+1
	lda #<nmiTrap
	sta NMINV
	lda #>nmiTrap
	sta NMINV+1
	cli
	rts

; Put them back before returning to BASIC -- these vectors point into a
; program BASIC is free to overwrite, so leaving them installed turns the
; next RESTORE keypress into a jump into whatever is there now.
removeTraps
	sei
	lda oldBrk
	sta CBINV
	lda oldBrk+1
	sta CBINV+1
	lda oldNmi
	sta NMINV
	lda oldNmi+1
	sta NMINV+1
	cli
	rts

; The KERNAL's IRQ entry has already pushed Y, X and A on top of the P/PCL/
; PCH the hardware pushed, so the interrupted address is six and seven
; bytes above the stack pointer. (The KERNAL NMI entry pushes nothing, but
; nmiTrap below pushes the same three itself, which lines the offsets up.)
brkTrap
	tsx
	lda $0105,x
	sta trapPC
	lda $0106,x
	sta trapPC+1
	lda #TRAP_BRK
	sta trapKind
	jsr showTrap

	; Nothing here is trustworthy any more, but the report is worth more
	; than the crash: put the stack back to what BASIC handed us and fall
	; into the post-stop path, so LOOP_STOP still runs and a verdict still
	; prints. trapKind makes that verdict a FAIL.
	ldx entrySP
	txs
	cli
	jmp skipAnim

; An NMI is not necessarily fatal -- RESTORE is one -- so this one records
; and resumes rather than unwinding. It still fails the verdict: on this
; program nothing should be generating NMIs at all.
nmiTrap
	pha
	txa
	pha
	tya
	pha
	tsx
	lda $0105,x
	sta trapPC
	lda $0106,x
	sta trapPC+1
	lda #TRAP_NMI
	sta trapKind

	; showTrap goes through printAt, which owns SRC/DST, and rowAddr, which
	; owns rowTmp. This handler resumes, so it has to hand all three back
	; exactly as it found them -- otherwise the trap that was supposed to
	; diagnose a fault causes one. rowTmp matters even though it looks like
	; a pure scratch byte: it stays live across the four instructions
	; between rowAddr's `sta rowTmp` and its `ldx rowTmp`, and every display
	; routine in this program goes through rowAddr while the traps are
	; installed, so an NMI landing in that window would otherwise resume the
	; interrupted call with the trap row's number in place of its own.
	lda SRC
	sta nmiZp+0
	lda SRC+1
	sta nmiZp+1
	lda DST
	sta nmiZp+2
	lda DST+1
	sta nmiZp+3
	lda rowTmp
	sta nmiZp+4
	jsr showTrap
	lda nmiZp+0
	sta SRC
	lda nmiZp+1
	sta SRC+1
	lda nmiZp+2
	sta DST
	lda nmiZp+3
	sta DST+1
	lda nmiZp+4
	sta rowTmp

	pla
	tay
	pla
	tax
	pla
	rti

showTrap
	lda #<txtTrap
	ldy #>txtTrap
	ldx #ROW_TRAP
	jsr printAt
	lda #ROW_TRAP
	jsr rowAddr
	ldy #COL_VAL
	lda trapKind
	jsr putHex
	iny
	lda trapPC+1
	jsr putHex
	lda trapPC
	jsr putHex
	rts

; One glyph per animation frame. A frozen spinner and a frozen HDMI picture
; is a dead C64; a turning spinner and a frozen picture is not.
spin
	inc spinIdx
	lda spinIdx
	and #3
	sta spinIdx
	tax
	lda spinTable,x
	sta SCREEN + ROW_ALIVE * 40 + COL_VAL
	rts

; A = where in the frame we are; see the ALIVE line in the header. Written
; straight to the screen so it is current even if the next instruction is
; the one that never returns.
setStage
	sta stageVal
	pha
	lsr
	lsr
	lsr
	lsr
	jsr hexDigit
	sta SCREEN + ROW_ALIVE * 40 + COL_VAL + 8
	pla
	and #$0f
	jsr hexDigit
	sta SCREEN + ROW_ALIVE * 40 + COL_VAL + 9
	rts

; ----------------------------------------------------------------------
; Command helpers.
;
; Writing CMD_LO is what dispatches; CMD_HI is sticky and selects the class.
; The C64 is DMA-halted for the whole dispatch, so there is nothing to poll
; and no handshake -- ERRCODE is valid on the very next instruction.
; ----------------------------------------------------------------------

cmd0
	ldx #0
	stx CMD_HI
	sta CMD_LO
	lda ERRCODE
	rts

cmd1
	ldx #1
	stx CMD_HI
	sta CMD_LO
	lda ERRCODE
	rts

; A = opcode. Same contract as cmd1, but also writes an incrementing SEQ
; before dispatch and checks SEQACK after dispatch -- detector-only, no
; retry (dev/reliability_protocol_design.md, "Recommended next step").
; A mismatch means the SEQ write, an ARG write, or CMD_LO itself was not
; sampled by reuUsingPolling() -- the pre-existing bus-reliability defect
; CLAUDE.md documents, not a new bug. Counted in missed/missed+1.
cmdSeq1
	pha
	inc seqCounter
	lda seqCounter
	cmp #255
	bne cs1ok
	lda #1
	sta seqCounter
cs1ok
	lda seqCounter
	sta SEQ
	pla
	jsr cmd1
	pha
	lda SEQACK
	cmp seqCounter
	beq cs1match
	inc missed
	bne cs1match
	inc missed+1
cs1match
	pla
	rts

; Records the ERRCODE in A into the setup log, in order.
logSetup
	ldx setupIdx
	sta setupErr,x
	inc setupIdx
	rts

logScene
	ldx sceneIdx
	sta sceneErr,x
	lda #0
	sta sceneMiss,x
	lda missed
	cmp scMissSnap
	beq lsSame
	sta scMissSnap
	lda #1
	sta sceneMiss,x
lsSame
	inc sceneIdx
	rts

logPost
	ldx postIdx
	sta postErr,x
	lda #0
	sta postMiss,x
	lda missed
	cmp scMissSnap
	beq lpSame
	sta scMissSnap
	lda #1
	sta postMiss,x
lpSame
	inc postIdx
	rts

; ----------------------------------------------------------------------
; Setup: the same nine steps as gpu64_3d_cube.a, each logged. Identical
; scene (viewport/perspective/light/background/colormap/texture/mesh) --
; only how the box gets drawn differs from there.
; ----------------------------------------------------------------------

doSetup
	lda #0
	sta setupIdx

	lda #0
	jsr palLoadHalf
	jsr logSetup

	lda #128
	jsr palLoadHalf
	jsr logSetup

	; viewport 256x160, centred
	lda #32
	sta ARG+0
	lda #0
	sta ARG+1
	lda #20
	sta ARG+2
	lda #0
	sta ARG+3
	lda #<256
	sta ARG+4
	lda #>256
	sta ARG+5
	lda #<160
	sta ARG+6
	lda #>160
	sta ARG+7
	lda #OP_SET_VIEWPORT
	jsr cmdSeq1
	jsr logSetup

	; perspective: fov $2AAB (60 degrees), near 1.0, far 120.0 (8.8)
	lda #$AB
	sta ARG+0
	lda #$2A
	sta ARG+1
	lda #$00
	sta ARG+2
	lda #$01
	sta ARG+3
	lda #$00
	sta ARG+4
	lda #$78
	sta ARG+5
	lda #OP_SET_PERSPECTIVE
	jsr cmdSeq1
	jsr logSetup

	; light: direction (-5, 7, -6) in 8.8, ambient 3 of 15
	lda #<-1280
	sta ARG+0
	lda #>-1280
	sta ARG+1
	lda #<1792
	sta ARG+2
	lda #>1792
	sta ARG+3
	lda #<-1536
	sta ARG+4
	lda #>-1536
	sta ARG+5
	lda #3
	sta ARG+6
	lda #OP_SET_LIGHT
	jsr cmdSeq1
	jsr logSetup

	lda #0
	sta ARG+0
	lda #OP_SET_BACKGROUND
	jsr cmdSeq1
	jsr logSetup

	lda #OP_BUILD_COLORMAP
	jsr cmdSeq1
	jsr logSetup

	; texture
	lda #<TEX_ID
	sta ID_LO
	lda #>TEX_ID
	sta ID_HI
	lda #0
	sta ARG+0
	lda #<TEXBUF
	sta ARG+1
	lda #>TEXBUF
	sta ARG+2
	lda #0
	sta ARG+3
	lda #<4096
	sta ARG+4
	lda #>4096
	sta ARG+5
	lda #6
	sta ARG+6
	lda #6
	sta ARG+7
	lda #OP_UPLOAD_TEXTURE
	jsr cmdSeq1
	jsr logSetup

	; mesh -- the box, unchanged from gpu64_3d_cube.a
	lda #<MESH_ID
	sta ID_LO
	lda #>MESH_ID
	sta ID_HI
	lda #0
	sta ARG+0
	lda #<vertBlob
	sta ARG+1
	lda #>vertBlob
	sta ARG+2
	lda #0
	sta ARG+3
	lda #48
	sta ARG+4
	lda #0
	sta ARG+5
	lda #0
	sta ARG+6
	lda #<faceBlob
	sta ARG+7
	lda #>faceBlob
	sta ARG+8
	lda #0
	sta ARG+9
	lda #144
	sta ARG+10
	lda #0
	sta ARG+11
	lda #OP_UPLOAD_MESH
	jsr cmdSeq1
	jsr logSetup

	rts

; A = first palette index; loads 128 entries from PALBUF + A*3.
palLoadHalf
	sta palFirst

	sta $fb
	lda #0
	sta $fc
	asl $fb
	rol $fc				; x2
	clc
	lda $fb
	adc palFirst
	sta $fb
	lda $fc
	adc #0
	sta $fc				; x3

	clc
	lda $fb
	adc #<PALBUF
	sta ARG+1
	lda $fc
	adc #>PALBUF
	sta ARG+2

	lda #0
	sta ARG+0
	sta ARG+3
	lda #<384
	sta ARG+4
	lda #>384
	sta ARG+5
	lda palFirst
	sta ARG+6
	lda #128
	sta ARG+7

	lda #OP_PAL_LOAD
	jmp cmd0

; ----------------------------------------------------------------------
; Scene-graph setup: CREATE_CAMERA, the deliberate premature LOOP_START,
; SET_ACTIVE_CAMERA, CREATE_OBJECT/SET_POSITION, then the real LOOP_START
; and the two BUSY preconditions. Eight steps, sceneErr+0 .. sceneErr+7.
; ----------------------------------------------------------------------

doSceneSetup
	lda #0
	sta sceneIdx
	; Every step below now goes through cmdSeq1, so a step whose dispatch
	; the bus never sampled is identifiable instead of being read as an
	; answer. It matters most here: the eight steps are a fixed expected
	; sequence, and a dropped write leaves ERRCODE holding the PREVIOUS
	; step's answer -- which for step 6 (a second LOOP_START, expected
	; BUSY) is indistinguishable from the OK that step 5 just returned.
	; That is exactly the shape of the 2026-09-08 bench FAIL.
	lda missed
	sta scMissSnap

	; step 0: CREATE_CAMERA -- expect OK
	lda #<CAM_ID
	sta ID_LO
	lda #>CAM_ID
	sta ID_HI
	lda #OP_CREATE_CAMERA
	jsr cmdSeq1
	jsr logScene

	; step 1: LOOP_START with no active camera yet -- expect NO_CAMERA
	lda #0
	sta ARG+0
	lda #OP_LOOP_START
	jsr cmdSeq1
	jsr logScene

	; step 2: SET_ACTIVE_CAMERA -- expect OK
	lda #<CAM_ID
	sta ID_LO
	lda #>CAM_ID
	sta ID_HI
	lda #OP_SET_ACTIVE_CAMERA
	jsr cmdSeq1
	jsr logScene

	; step 3: CREATE_OBJECT, mesh id 2 -- expect OK
	lda #<OBJ_ID
	sta ID_LO
	lda #>OBJ_ID
	sta ID_HI
	lda #<MESH_ID
	sta ARG+0
	lda #>MESH_ID
	sta ARG+1
	lda #OP_CREATE_OBJECT
	jsr cmdSeq1
	jsr logScene

	; step 4: SET_POSITION (0, 0, 70.0), s32 16.16 -- expect OK. The
	; camera stays at its CREATE_CAMERA default (origin, identity
	; rotation), same convention tools/hostsim's setCamera() and
	; gpu64_3dSceneApplyCamera() share -- so the box sits the same 70
	; units in front of it that gpu64_3d_cube.a places it in front of
	; the implicit immediate-mode camera.
	lda #<OBJ_ID
	sta ID_LO
	lda #>OBJ_ID
	sta ID_HI
	lda #0
	sta ARG+0
	sta ARG+1
	sta ARG+2
	sta ARG+3
	sta ARG+4
	sta ARG+5
	sta ARG+6
	sta ARG+7
	sta ARG+8
	sta ARG+9
	lda #$46			; 70 << 16, low mid byte
	sta ARG+10
	lda #0
	sta ARG+11
	lda #OP_SET_POSITION
	jsr cmdSeq1
	jsr logScene

	; step 5: LOOP_START for real -- expect OK
	lda #0
	sta ARG+0
	lda #OP_LOOP_START
	jsr cmdSeq1
	jsr logScene

	; step 6: LOOP_START again while running -- expect BUSY
	lda #0
	sta ARG+0
	lda #OP_LOOP_START
	jsr cmdSeq1
	jsr logScene

	; step 7: CLEAR_VIEWPORT (immediate mode) while running -- expect BUSY
	lda #OP_CLEAR_VIEWPORT
	jsr cmdSeq1
	jsr logScene

	rts

; ----------------------------------------------------------------------
; The animation: ROTATE_LOCAL (shadow-redirected, returns at once) then
; SCENE_COMMIT (publishes the shadow, arms the flip, queues the next
; frame -- draining any frame already in flight first, so this never
; needs a BUSY retry loop of its own; see gpu64_3d_class1.cpp's
; SCENE_COMMIT case for why). Runs until RUN/STOP.
; ----------------------------------------------------------------------

animLoop
	lda #0
	sta commitIdx
	sta missed
	sta missed+1
	sta okFrames
	sta okFrames+1
	sta firstErrSet
	lda #1
	sta seqCounter

animFrame
	jsr spin

	lda #$10
	jsr setStage

	lda #<OBJ_ID
	sta ID_LO
	lda #>OBJ_ID
	sta ID_HI
	lda #<$0200			; ~2.8 degrees/frame, same step as
	sta ARG+0			; gpu64_3d_cube.a's angle
	lda #>$0200
	sta ARG+1
	lda #0				; pitch, roll unchanged
	sta ARG+2
	sta ARG+3
	sta ARG+4
	sta ARG+5
	lda missed			; miss flags for this frame's two
	sta missSnap			; dispatches -- see commitMiss

	lda #OP_ROTATE_LOCAL
	jsr cmdSeq1
	sta lastRotErr

	lda #0
	sta frMiss
	lda missed
	cmp missSnap
	beq +
	lda #1
	sta frMiss
+	lda missed
	sta missSnap

	lda #$11
	jsr setStage
	lda #$20
	jsr setStage

	lda #OP_SCENE_COMMIT
	jsr cmdSeq1
	sta lastCommitErr
	lda RESULT
	sta lastPage
	lda STATUS
	sta lastStatus

	lda missed
	cmp missSnap
	beq +
	lda frMiss
	ora #2
	sta frMiss
+
	lda #$21
	jsr setStage

	; Attempted and accepted are counted separately: a run in which every
	; commit is refused still advances FRAME, and the single counter this
	; replaced could not tell that from a healthy run at a glance.
	lda lastCommitErr
	bne cmtBad
	inc okFrames
	bne cmtDone
	inc okFrames+1
	jmp cmtDone
cmtBad
	; Sticky, because COMMIT ERR shows only the most recent one and a
	; single good frame afterwards erases the evidence.
	ldx firstErrSet
	bne cmtDone
	sta firstErr
	lda frames
	sta firstErrFrame
	lda frames+1
	sta firstErrFrame+1
	inc firstErrSet
cmtDone

	ldx commitIdx
	cpx #COMMIT_LOG_COUNT
	bcs animNoLog
	lda lastRotErr
	sta commitRotErr,x
	lda lastCommitErr
	sta commitErr,x
	lda lastPage
	sta commitPage,x
	lda lastStatus
	sta commitStatus,x
	lda frMiss
	sta commitMiss,x
	inc commitIdx
animNoLog

	inc frames
	bne +
	inc frames+1
+
	jsr showAnim

	lda #$30
	jsr setStage

	; RUN/STOP, read the way the KERNAL does.
	lda $91
	cmp #$7f
	beq animDone

	; ...and the deadline, so a run nobody is watching still reaches the
	; POST checks and the verdict.
	lda frames+1
	cmp #>AUTO_STOP_FRAMES
	bcc animAgain
	bne animDone
	lda frames
	cmp #<AUTO_STOP_FRAMES
	bcs animDone
animAgain
	jmp animFrame

animDone
	rts

; ----------------------------------------------------------------------
; Post-stop checks: LOOP_STOP, then SCENE_COMMIT and CLEAR_VIEWPORT
; against the now-stopped loop. postErr+0 .. postErr+2.
; ----------------------------------------------------------------------

doPostChecks
	lda #0
	sta postIdx
	lda missed
	sta scMissSnap

	; LOOP_STOP -- always OK, even if LOOP_START never actually ran.
	; The one-shot key in ARG15 is what makes it OK rather than BAD_ARGS
	; (gpu64_api.h); without it this check would be measuring the key.
	lda #$a5
	sta ARG+15
	lda #OP_LOOP_STOP
	jsr cmdSeq1
	jsr logPost

	; CLEAR_VIEWPORT -- immediate mode restored, expect OK. This has to
	; come BEFORE the commit below, not after it: since the self-healing
	; commit landed (2026-09-10) a SCENE_COMMIT against a stopped loop
	; restarts the loop, and immediate mode is refused with BUSY while the
	; loop runs (precheckClearViewport()).
	lda #OP_CLEAR_VIEWPORT
	jsr cmdSeq1
	jsr logPost

	; SCENE_COMMIT with no loop running -- expect OK: it re-arms the loop.
	lda #OP_SCENE_COMMIT
	jsr cmdSeq1
	jsr logPost

	; CLEAR_VIEWPORT again -- expect BUSY. This is the assertion that the
	; re-arm above really happened; without it "SCENE_COMMIT answered OK"
	; would be satisfied by a firmware that simply ignored the commit.
	lda #OP_CLEAR_VIEWPORT
	jsr cmdSeq1
	jsr logPost

	rts

; ----------------------------------------------------------------------
; Verdict.
; ----------------------------------------------------------------------

verdict
	; A BRK or an NMI is a failure on its own, whatever the logs say --
	; and it is the first thing to check, because everything below it was
	; recorded by a program that may have been derailed at the time.
	lda trapKind
	beq vNoTrap
	ldx #0
	lda #WHY_TRAP
	jmp vFail
vNoTrap

	; SETUP: all nine must be OK.
	ldx #0
vSetupLoop
	lda setupErr,x
	beq +
	lda #WHY_SETUP
	jmp vFail
+	inx
	cpx #9
	bne vSetupLoop

	; SCENE: fixed expected sequence, minus any step whose dispatch the bus
	; never sampled -- that step's ERRCODE is the step before it, so testing
	; it reports a firmware defect that is not there. Same reasoning as
	; vRowLive below, and the reason every step now goes through cmdSeq1.
	ldx #0
vSceneLoop
	lda sceneMiss,x
	beq vSceneLive
	inc vSkipped
	jmp vSceneNext
vSceneLive
	lda sceneErr,x
	cmp sceneExpect,x
	beq vSceneNext
	lda #WHY_SCENE
	jmp vFail
vSceneNext
	inx
	cpx #8
	bne vSceneLoop

	; POST: fixed expected sequence, same skip.
	ldx #0
vPostLoop
	lda postMiss,x
	beq vPostLive
	inc vSkipped
	jmp vPostNext
vPostLive
	lda postErr,x
	cmp postExpect,x
	beq vPostNext
	lda #WHY_POST
	jmp vFail
vPostNext
	inx
	cpx #4
	bne vPostLoop

	; The logged commits: ERRCODE must be OK, RESULT (page) must be one
	; of the three flip pages, and STATUS read right after must not
	; already show FRAME_READY -- SCENE_COMMIT just armed a new frame,
	; it cannot have finished by the time this instruction runs.
	ldx #0
vCommitLoop
	cpx commitIdx
	bcs vCommitDone

	; A frame whose ROTATE_LOCAL or SCENE_COMMIT was not sampled by the
	; polling loop is not evidence about anything: the ERRCODE, RESULT and
	; STATUS this row holds were read after a dispatch that never happened,
	; so they belong to the frame before it. That is the documented bus
	; defect (CLAUDE.md, "The bus is not reliable"), one write in 180000,
	; and failing the whole run on it reports a firmware defect that is not
	; there. Skipped, and counted, so the verdict row still says how much
	; of the log it had to ignore.
	lda commitMiss,x
	beq vRowLive
	inc vSkipped
	jmp vCommitNext
vRowLive

	lda commitRotErr,x
	beq +
	lda #WHY_ROT
	jmp vFail
+	lda commitErr,x
	beq vCommitOk
	; BUSY is a legal answer, not a defect: it means a frame was still in
	; flight, which is a scheduling outcome rather than a broken commit.
	; Anything else is. RESULT and STATUS are only meaningful for a commit
	; that was actually accepted, so a BUSY skips the rest of the row.
	cmp #ERR_BUSY
	beq vCommitNext
	lda #WHY_COMMIT
	jmp vFail
vCommitOk
	lda commitPage,x
	cmp #3
	bcc +
	lda #WHY_PAGE
	jmp vFail
+	lda commitStatus,x
	and #STATUS_FRAME_READY
	beq vCommitNext
	lda #WHY_READY
	jmp vFail
vCommitNext
	inx
	jmp vCommitLoop
vCommitDone

	; If the loop did start, at least one commit has to have been accepted.
	; Six BUSY answers in a row would otherwise pass every check above
	; while nothing was ever rendered.
	lda sceneErr+5
	bne vNoLoop
	lda okFrames
	ora okFrames+1
	bne vNoLoop
	ldx #0
	lda #WHY_NOFRAME
	jmp vFail
vNoLoop

	lda #<txtPass
	ldy #>txtPass
	ldx #ROW_VERDICT
	jsr printAt
	jmp vSkipShow

; A = the reason code, X = the log index it was found at. Both are printed
; after the word FAIL: "which check" is the whole difference between a bench
; run that localises a defect and one that only says something is wrong --
; the first FAIL this program ever produced on hardware (2026-09-08) cost a
; whole run precisely because the verdict was one bit wide.
vFail
	sta failWhy
	stx failIdx
	lda #<txtFail
	ldy #>txtFail
	ldx #ROW_VERDICT
	jsr printAt
	lda #ROW_VERDICT
	jsr rowAddr
	ldy #13
	lda failWhy
	jsr putHex
	iny
	lda failIdx
	jsr putHex

vSkipShow
	lda #ROW_VERDICT
	jsr rowAddr
	ldy #19
	lda #$13			; S
	sta (DST),y
	iny
	lda #$0b			; K
	sta (DST),y
	iny
	lda #$09			; I
	sta (DST),y
	iny
	lda #$10			; P
	sta (DST),y
	iny
	iny
	lda vSkipped
	jsr putHex
	rts

; The six logged commits, in full: rot ERRCODE, commit ERRCODE, RESULT
; (page), STATUS, and the miss flags (bit 0 the rotate, bit 1 the commit).
; Printed whatever the verdict says, because a PASS with a skipped row is
; worth as much to read as a FAIL.
showLog
	lda #<txtLog1
	ldy #>txtLog1
	ldx #ROW_LOG1
	jsr printAt
	lda #<txtLog2
	ldy #>txtLog2
	ldx #ROW_LOG2
	jsr printAt

	; The index lives in memory, not in X: rowAddr uses X as its own row
	; counter and returns with it clobbered.
	lda #0
	sta logIdx
slNext
	lda logIdx
	cmp #3
	bcs slRow2
	lda #ROW_LOG1
	jsr rowAddr
	lda logIdx
	jmp slCol
slRow2
	lda #ROW_LOG2
	jsr rowAddr
	lda logIdx
	sec
	sbc #3
slCol
	; column = 7 + n * 11, which is the eight hex digits of a row plus the
	; two of the miss flags plus one space.
	sta logTmp
	clc
	asl
	asl
	asl
	adc logTmp
	adc logTmp
	adc logTmp
	adc #7
	tay
	ldx logIdx
	lda commitRotErr,x
	jsr putHex
	lda commitErr,x
	jsr putHex
	lda commitPage,x
	jsr putHex
	lda commitStatus,x
	jsr putHex
	lda commitMiss,x
	jsr putHex
	inc logIdx
	lda logIdx
	cmp #COMMIT_LOG_COUNT
	bne slNext
	rts

sceneExpect
	.byte $00, $0B, $00, $00, $00, $00, $07, $07
postExpect
	; LOOP_STOP OK, CLEAR_VIEWPORT OK (immediate mode is back),
	; SCENE_COMMIT OK (it re-arms the loop it found stopped), then
	; CLEAR_VIEWPORT BUSY because that re-arm took effect.
	.byte $00, $00, $00, $07

; ----------------------------------------------------------------------
; Screen output.
; ----------------------------------------------------------------------

showSetup
	lda #<txtSetup
	ldy #>txtSetup
	ldx #2
	jsr printAt

	lda #2
	jsr rowAddr
	ldy #8
	ldx #0
ssLoop
	lda setupErr,x
	jsr putHex
	iny
	inx
	cpx #9
	bne ssLoop
	rts

showScene
	lda #<txtScene
	ldy #>txtScene
	ldx #3
	jsr printAt

	lda #3
	jsr rowAddr
	ldy #8
	ldx #0
scLoop
	lda sceneErr,x
	jsr putHex
	iny
	inx
	cpx #8
	bne scLoop

	; One digit per step at the row's right-hand end: 1 means the bus did
	; not sample that step's dispatch, so its ERRCODE above belongs to the
	; step before it. Eight columns, no separator -- there is exactly room.
	ldy #32
	ldx #0
scMissLoop
	lda sceneMiss,x
	clc
	adc #$30
	sta (DST),y
	iny
	inx
	cpx #8
	bne scMissLoop
	rts

showPost
	lda #<txtPost
	ldy #>txtPost
	ldx #4
	jsr printAt

	lda #4
	jsr rowAddr
	ldy #8
	ldx #0
poLoop
	lda postErr,x
	jsr putHex
	iny
	inx
	cpx #4
	bne poLoop

	ldy #32
	ldx #0
poMissLoop
	lda postMiss,x
	clc
	adc #$30
	sta (DST),y
	iny
	inx
	cpx #4
	bne poMissLoop
	rts

; Labels for the live rows, shown once before the animation starts.
showLabels
	lda #<txtFrame
	ldy #>txtFrame
	ldx #ROW_FRAME
	jsr printAt
	lda #<txtRot
	ldy #>txtRot
	ldx #ROW_ROT
	jsr printAt
	lda #<txtCommit
	ldy #>txtCommit
	ldx #ROW_COMMIT
	jsr printAt
	lda #<txtPage
	ldy #>txtPage
	ldx #ROW_PAGE
	jsr printAt
	lda #<txtMissed
	ldy #>txtMissed
	ldx #ROW_MISSED
	jsr printAt
	lda #<txtFirstErr
	ldy #>txtFirstErr
	ldx #ROW_FIRSTERR
	jsr printAt
	lda #<txtPhase
	ldy #>txtPhase
	ldx #ROW_PHASE
	jsr printAt
	lda #<txtAlive
	ldy #>txtAlive
	ldx #ROW_ALIVE
	jmp printAt

showAnim
	lda #ROW_FRAME
	jsr rowAddr
	ldy #COL_VAL
	lda frames+1
	jsr putHex
	lda frames
	jsr putHex
	lda #$2f			; '/'
	sta (DST),y
	iny
	lda okFrames+1
	jsr putHex
	lda okFrames
	jsr putHex

	lda #ROW_ROT
	jsr rowAddr
	ldy #COL_VAL
	lda lastRotErr
	jsr putHex

	lda #ROW_COMMIT
	jsr rowAddr
	ldy #COL_VAL
	lda lastCommitErr
	jsr putHex

	lda #ROW_PAGE
	jsr rowAddr
	ldy #COL_VAL
	lda lastPage
	jsr putHex

	lda #ROW_MISSED
	jsr rowAddr
	ldy #COL_VAL
	lda missed+1
	jsr putHex
	lda missed
	jsr putHex

	lda #ROW_FIRSTERR
	jsr rowAddr
	ldy #COL_VAL
	lda firstErr
	jsr putHex
	iny
	lda #$00			; '@' is screen code $00
	sta (DST),y
	iny
	iny
	lda firstErrFrame+1
	jsr putHex
	lda firstErrFrame
	jsr putHex
	rts

; ----------------------------------------------------------------------
; The palette: 32 hues x 8 brightnesses. Identical to gpu64_3d_cube.a.
; ----------------------------------------------------------------------

buildPalette
	lda #<PALBUF
	sta DST
	lda #>PALBUF
	sta DST+1

	lda #<hueTable
	sta SRC
	lda #>hueTable
	sta SRC+1

	lda #0
	sta hueIdx

palHue
	lda #0
	sta briIdx

palBri
	ldy #0
palChan
	lda (SRC),y
	sta mulA
	lda #0
	sta mulL
	sta mulH
	ldx briIdx
	inx
palMulLoop
	clc
	lda mulL
	adc mulA
	sta mulL
	lda mulH
	adc #0
	sta mulH
	dex
	bne palMulLoop

	lsr mulH
	ror mulL
	lsr mulH
	ror mulL
	lsr mulH
	ror mulL

	lda mulL
	sta (DST),y
	iny
	cpy #3
	bne palChan

	clc
	lda DST
	adc #3
	sta DST
	lda DST+1
	adc #0
	sta DST+1

	inc briIdx
	lda briIdx
	cmp #8
	bne palBri

	clc
	lda SRC
	adc #3
	sta SRC
	lda SRC+1
	adc #0
	sta SRC+1

	inc hueIdx
	lda hueIdx
	cmp #32
	bne palHue

	lda #16
	sta PALBUF+0
	sta PALBUF+1
	sta PALBUF+2
	lda #255
	sta PALBUF+765
	sta PALBUF+766
	sta PALBUF+767
	rts

; ----------------------------------------------------------------------
; The texture: a 64x64 checker with one off-centre marker block.
; Identical to gpu64_3d_cube.a.
; ----------------------------------------------------------------------

buildTexture
	lda #<TEXBUF
	sta DST
	lda #>TEXBUF
	sta DST+1

	lda #0
	sta texY

texRow
	ldy #0
texCol
	tya
	lsr
	lsr
	lsr
	sta texTmp
	lda texY
	lsr
	lsr
	lsr
	eor texTmp
	and #1
	beq texB

	lda #(10*8)+7
	jmp texStore
texB
	lda #(13*8)+4

texStore
	sta texPix

	lda texY
	cmp #4
	bcc texPut
	cmp #10
	bcs texPut
	cpy #4
	bcc texPut
	cpy #16
	bcs texPut
	lda #(3*8)+7
	sta texPix

texPut
	lda texPix
	sta (DST),y
	iny
	cpy #64
	bne texCol

	clc
	lda DST
	adc #64
	sta DST
	lda DST+1
	adc #0
	sta DST+1

	inc texY
	lda texY
	cmp #64
	bne texRow
	rts

; ----------------------------------------------------------------------
; Screen output helpers. Identical to gpu64_3d_cube.a's.
; ----------------------------------------------------------------------

clearScreen
	ldx #0
	lda #$20
cls1
	sta SCREEN,x
	sta SCREEN+$100,x
	sta SCREEN+$200,x
	sta SCREEN+$300,x
	inx
	bne cls1
	rts

; A/Y = string pointer (zero-terminated PETSCII), X = row.
printAt
	sta SRC
	sty SRC+1
	txa
	jsr rowAddr
	ldy #0
prLoop
	lda (SRC),y
	beq prDone
	cmp #$41
	bcc prPut
	cmp #$5b
	bcs prPut
	sec
	sbc #$40
prPut
	sta (DST),y
	iny
	bne prLoop
prDone
	rts

; A = row; leaves the row's screen address in DST.
rowAddr
	sta rowTmp
	lda #<SCREEN
	sta DST
	lda #>SCREEN
	sta DST+1
	ldx rowTmp
	beq rowDone
rowAdd
	clc
	lda DST
	adc #40
	sta DST
	lda DST+1
	adc #0
	sta DST+1
	dex
	bne rowAdd
rowDone
	rts

; A = byte, Y = column offset within the row DST already points at.
putHex
	pha
	lsr
	lsr
	lsr
	lsr
	jsr hexDigit
	sta (DST),y
	iny
	pla
	and #$0f
	jsr hexDigit
	sta (DST),y
	iny
	rts

hexDigit
	cmp #10
	bcs hexAlpha
	clc
	adc #$30
	rts
hexAlpha
	sec
	sbc #9
	rts

; ----------------------------------------------------------------------
; Data.
; ----------------------------------------------------------------------

txtTitle	.text "GPU64 LOOP TEST"
		.byte 0
txtSetup	.text "SETUP"
		.byte 0
txtScene	.text "SCENE"
		.byte 0
txtPost		.text "POST"
		.byte 0
txtFrame	.text "FRAME"
		.byte 0
txtRot		.text "ROT ERR"
		.byte 0
txtCommit	.text "COMMIT ERR"
		.byte 0
txtPage		.text "PAGE"
		.byte 0
txtMissed	.text "MISSED"
		.byte 0
txtFirstErr	.text "FIRST ERR"
		.byte 0
txtPhase	.text "PHASE"
		.byte 0
txtAlive	.text "ALIVE"
		.byte 0
txtTrap		.text "TRAP"
		.byte 0

; Screen codes, not PETSCII: these go straight to the screen. $2d/$4e/$5d/
; $4d are - / | \ in the uppercase/graphics character set.
spinTable	.byte $2d, $4e, $5d, $4d
txtLog1		.text "LOG0-2"
		.byte 0
txtLog2		.text "LOG3-5"
		.byte 0
txtPass		.text "VERDICT PASS"
		.byte 0
txtFail		.text "VERDICT FAIL"
		.byte 0

hueTable
	.byte 255,  64,  64
	.byte 255, 112,  48
	.byte 255, 160,  32
	.byte 255, 208,  32
	.byte 240, 255,  32
	.byte 176, 255,  32
	.byte 112, 255,  48
	.byte  48, 255,  64
	.byte  32, 255, 128
	.byte  32, 255, 192
	.byte  32, 240, 255
	.byte  32, 192, 255
	.byte  48, 144, 255
	.byte  64,  96, 255
	.byte  96,  64, 255
	.byte 144,  48, 255
	.byte 192,  32, 255
	.byte 240,  32, 255
	.byte 255,  32, 192
	.byte 255,  48, 128
	.byte 176, 112,  80
	.byte 208, 144, 104
	.byte 128,  96,  64
	.byte  96, 128,  96
	.byte 255, 255, 255
	.byte 224, 224, 224
	.byte 192, 192, 192
	.byte 160, 160, 160
	.byte 128, 128, 128
	.byte  96,  96,  96
	.byte  64,  64,  64
	.byte  32,  32,  32

; The box, unchanged from gpu64_3d_cube.a -- see there for why it is
; asymmetric and clockwise-from-outside wound.

vertBlob
	.byte $00, $e8, $00, $f2, $00, $ec, $00, $18, $00, $f2, $00, $ec
	.byte $00, $18, $00, $f2, $00, $14, $00, $e8, $00, $f2, $00, $14
	.byte $00, $ef, $00, $0e, $00, $ec, $00, $1f, $00, $0e, $00, $ec
	.byte $00, $1f, $00, $0e, $00, $14, $00, $ef, $00, $0e, $00, $14

faceBlob
	.byte $00, $01, $02, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $00, $02, $03, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $07, $06, $05, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $07, $05, $04, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $00, $04, $05, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $00, $05, $01, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $02, $06, $07, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $02, $07, $03, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $03, $07, $04, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $03, $04, $00, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00
	.byte $01, $05, $06, $00, $00, $3f, $00, $3f, $3f, $01, $00, $00
	.byte $01, $06, $02, $00, $00, $3f, $3f, $00, $3f, $01, $00, $00

; ----------------------------------------------------------------------
; Variables.
; ----------------------------------------------------------------------

setupIdx	.byte 0
setupErr	.fill 9, $ff
sceneIdx	.byte 0
sceneErr	.fill 8, $ff
sceneMiss	.fill 8, 0
postMiss	.fill 4, 0
scMissSnap	.byte 0
postIdx		.byte 0
postErr		.fill 4, $ff

palFirst	.byte 0
hueIdx		.byte 0
briIdx		.byte 0
mulA		.byte 0
mulL		.byte 0
mulH		.byte 0
texY		.byte 0
texTmp		.byte 0
texPix		.byte 0
rowTmp		.byte 0

frames		.word 0
commitIdx	.byte 0
seqCounter	.byte 1
missed		.word 0
lastRotErr	.byte 0
lastCommitErr	.byte 0
lastPage	.byte 0
lastStatus	.byte 0
commitRotErr	.fill COMMIT_LOG_COUNT, $ff
commitErr	.fill COMMIT_LOG_COUNT, $ff
commitPage	.fill COMMIT_LOG_COUNT, $ff
commitStatus	.fill COMMIT_LOG_COUNT, $ff
; Bit 0: this frame's ROTATE_LOCAL was not sampled. Bit 1: its SCENE_COMMIT
; was not. Either way the row's ERRCODE/RESULT/STATUS describe the dispatch
; before it, so the verdict skips the row -- see vRowLive.
commitMiss	.fill COMMIT_LOG_COUNT, $ff
missSnap	.byte 0
frMiss		.byte 0
failWhy		.byte 0
failIdx		.byte 0
vSkipped	.byte 0
logIdx		.byte 0
logTmp		.byte 0

okFrames	.word 0
firstErr	.byte 0
firstErrFrame	.word 0
firstErrSet	.byte 0

entrySP		.byte 0
phaseIdx	.byte 0
spinIdx		.byte 0
stageVal	.byte 0
trapKind	.byte 0
trapPC		.word 0
oldBrk		.word 0
oldNmi		.word 0
nmiZp		.fill 5, 0
