;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- API conformance suite 6/6: paging and the frame clock.
;
;      WHAT THIS TESTS
;
;      Double buffering and vblank: SET_DRAW_PAGE, PAGE_FLIP in both its
;      forms, VBLANK_ARM, VBLANK_ACK and VBLANK_SYNC.
;
;      Paging is checked by content, not by a status bit. The three pages
;      are cleared to different colours and then READ_RECT is used to ask
;      which one is currently being drawn into -- so "the flip happened"
;      means the bytes moved, not that a register says so. A flip that
;      updated its own bookkeeping and nothing else passes a status check
;      and fails this.
;
;      There are three pages, and a flip ROTATES them: the new draw page is
;      the one that is neither now visible nor visible a moment ago. A
;      posted flip does not reach the screen until the display's next
;      vsync, so handing the just-vacated page straight back to be drawn
;      into paints the next frame on screen as it is built.
;
;      ADAPTS TO THE DISPLAY. The frame clock is measured once at boot, and
;      a display gpu64 could not measure leaves every vblank feature
;      answering UNSUPPORTED. That is a documented, supported state, not a
;      fault -- so this program reads the frame period out of GET_INFO first
;      and demands OK or UNSUPPORTED accordingly. FRAMECLOCK shows what it
;      found: $4E20 is 20000us and a PAL 50Hz display, 0000 means no clock.
;      Both cases are expected to reach VERDICT PASS, and a run that passes
;      in one mode says nothing about the other.
;
;      THE TIMED PARTS. Two tests wait on the display rather than on gpu64:
;      the vblank-pending bit has to set on its own, and a deferred flip has
;      to land on its own. Each polls up to 65536 times -- around half a
;      second, or two dozen frames -- and reports $E4 if the signal never
;      came. When there is no frame clock the same wait is the pass: nothing
;      must ever arrive.
;
;      Requires the RAD menu switched to REU mode with T.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64_testkit.inc"

INFO	= $2000
RB	= $3000

CA	= 1				; the colour page 0 is cleared to
CB	= 2				; ...and page 1
CC	= 3				; ...and page 2

; Expect OK where the frame clock exists and UNSUPPORTED where it does not.
; A = the ERRCODE that came back.
wantVb	.macro
	ldy #ERR_OK
	ldx hasVb
	bne +
	ldy #ERR_UNSUPPORTED
+
	jsr kitExpect
	.endm

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	jsr kitInit
	#title "GPU64 API TEST 6 - PAGES/VBLANK"

; ----------------------------------------------------------------------
; Find out what kind of display this is before demanding anything of it.
; ----------------------------------------------------------------------

	#argblob 0, SPACE_C64, INFO, 16
	lda #OP_GET_INFO
	jsr cmd0
	#wantOk
	#check "GET INFO"

	lda INFO+14
	ora INFO+15
	beq noClock
	lda #1
	sta hasVb
noClock
	#showw INFO+14, "FRAMECLOCK"

; ----------------------------------------------------------------------
; The pages are three distinct buffers.
;
; Cleared to different colours, then read back through the draw page
; selector: if SET_DRAW_PAGE did nothing, both reads return the same byte
; and both of these fail.
; ----------------------------------------------------------------------

	lda #OP_RESET_STATE
	jsr cmd0
	#wantOk
	#check "RESET STATE"

	#argb 0, 0
	lda #OP_SET_DRAW_PAGE
	jsr cmd0
	#argb 0, CA
	lda #OP_CLEAR
	jsr cmd0
	#wantOk
	#check "CLEAR PAGE 0"

	#argb 0, 1
	lda #OP_SET_DRAW_PAGE
	jsr cmd0
	#argb 0, CB
	lda #OP_CLEAR
	jsr cmd0
	#wantOk
	#check "CLEAR PAGE 1"

	#argb 0, 2
	lda #OP_SET_DRAW_PAGE
	jsr cmd0
	#argb 0, CC
	lda #OP_CLEAR
	jsr cmd0
	#wantOk
	#check "CLEAR PAGE 2"

	#argb 0, 1
	lda #OP_SET_DRAW_PAGE
	jsr cmd0
	jsr readOne
	#clracc
	#expectb RB+0, CB
	#useacc
	#check "DRAW IS PAGE1"

	#argb 0, 0
	lda #OP_SET_DRAW_PAGE
	jsr cmd0
	jsr readOne
	#clracc
	#expectb RB+0, CA
	#useacc
	#check "DRAW IS PAGE0"

	; ...and page 1 kept its own contents while page 0 was being read.
	#argb 0, 1
	lda #OP_SET_DRAW_PAGE
	jsr cmd0
	jsr readOne
	#clracc
	#expectb RB+0, CB
	#useacc
	#check "PAGES KEPT"

; ----------------------------------------------------------------------
; The immediate flip. It rotates the three pages, so the page a program
; draws into after a flip is never one the display could still be scanning
; out -- which is what makes SET_DRAW_PAGE a once-at-startup call rather
; than a per frame one.
; ----------------------------------------------------------------------

	; Draw page 1, visible page 0. After the flip: visible 1, and the
	; draw page is 2 -- page 0 is skipped because the display may still
	; be showing it.
	#argb 0, 0
	lda #OP_PAGE_FLIP
	jsr cmd0
	#wantOk
	#check "FLIP NOW"

	jsr readOne
	#clracc
	#expectb RB+0, CC			; page 2 is now the draw page
	#useacc
	#check "FLIP ROTATED"

	#argb 0, 0
	lda #OP_PAGE_FLIP
	jsr cmd0
	jsr readOne
	#clracc
	#expectb RB+0, CA			; 2 visible, 1 just was: page 0
	#useacc
	#check "FLIP TWICE"

	#argb 0, 0
	lda #OP_PAGE_FLIP
	jsr cmd0
	jsr readOne
	#clracc
	#expectb RB+0, CB			; and round to the start again
	#useacc
	#check "FLIP THRICE"

	; RESET_STATE puts the pages back to 0 without touching what is in
	; them, so the draw page must now read page 0's colour.
	lda #OP_RESET_STATE
	jsr cmd0
	jsr readOne
	#clracc
	#expectb RB+0, CA
	#useacc
	#check "RESET PAGES"

; ----------------------------------------------------------------------
; Arming. VBLANK_ARM(1) needs a frame clock; VBLANK_ARM(0) never does,
; because disarming something that was never armed has to be harmless.
; ----------------------------------------------------------------------

	#argb 0, 1
	lda #OP_VBLANK_ARM
	jsr cmd0
	#wantVb
	#check "ARM"

	lda STATUS
	and #ST_VB_ARMED
	ldx hasVb
	beq armExpectClear
	jsr kitWantSet
	jmp armDone
armExpectClear
	jsr kitWantClear
armDone
	#check "ARMED BIT"

	#argb 0, 0
	lda #OP_VBLANK_ARM
	jsr cmd0
	#wantOk
	#check "DISARM"

	lda STATUS
	and #ST_VB_ARMED
	jsr kitWantClear
	#check "DISARMED BIT"

	lda #OP_VBLANK_SYNC
	jsr cmd0
	#wantVb
	#check "VBLANK SYNC"

; ----------------------------------------------------------------------
; The pending bit, which sets on its own and is cleared only by an ack.
; ----------------------------------------------------------------------

	lda #OP_VBLANK_ACK
	jsr cmd0
	#wantOk
	#check "VBLANK ACK"

	jsr waitPending
	; With a frame clock the signal must arrive; without one it must never
	; arrive, and the wait timing out IS the pass.
	ldy hasVb
	bne pendWant
	; invert: X is 0 if it arrived, which is now the failure
	cpx #0
	bne pendClear
	ldx #F_RANGE
	bne pendDone
pendClear
	ldx #0
	jmp pendDone
pendWant
	; X already carries the verdict
pendDone
	#check "PENDING SETS"

	lda hasVb
	bne haveClock
	jmp skipAck
haveClock

	lda #OP_VBLANK_ACK
	jsr cmd0
	lda STATUS
	and #ST_VB_PEND
	jsr kitWantClear
	#check "ACK CLEARS"

; ----------------------------------------------------------------------
; The deferred flip: the one place the API makes the C64 wait on something
; other than gpu64's own work. Busy stays set until the frame boundary
; arrives, and a second request while one is outstanding is refused
; without disturbing the one already queued.
; ----------------------------------------------------------------------

	#argb 0, 1
	lda #OP_PAGE_FLIP
	jsr cmd0
	#wantOk
	#check "FLIP DEFERRED"

	lda STATUS
	and #ST_BUSY
	jsr kitWantSet
	#check "BUSY SET"

	; The draw page hands over when the flip is ARMED, not when it lands.
	; Page 0 is drawn and visible here, so arming queues page 0 and the
	; draw page must already be page 1 -- while the flip is still pending.
	; The alternative (hand over at the frame boundary) would leave a
	; program drawing into the page it just asked to be displayed, for up
	; to a whole frame; that is what made a class 1 autonomous frame paint
	; onto the screen as it was being scanned. See dev/progress_tracker.md,
	; Stage 16 Finding 2.
	jsr readOne
	#clracc
	#expectb RB+0, CB
	#useacc
	#check "DEFER ROTATES"

	; A second deferred flip while the first is pending. The rule being
	; tested is not only that it is refused, but that it changes nothing:
	; the queued flip still lands, which the wait below proves.
	#argb 0, 1
	lda #OP_PAGE_FLIP
	jsr cmd0
	#wantErr ERR_BUSY
	#check "SECOND IS BUSY"

	jsr waitNotBusy
	#check "FLIP LANDS"

	; ...and landing does not move the draw page a second time. The commit
	; half only publishes what was queued; if it rotated as well, a frame
	; drawn between the arm and the boundary would be thrown away.
	jsr readOne
	#clracc
	#expectb RB+0, CB
	#useacc
	#check "LAND KEEPS PAGE"

	; An immediate flip is always available, clock or no clock -- it is the
	; documented fallback for a display that never calibrated.
	#argb 0, 0
	lda #OP_PAGE_FLIP
	jsr cmd0
	#wantOk
	#check "FLIP NOW AGAIN"

	jmp done

skipAck
	; No frame clock: the deferred flip must be refused outright and busy
	; must never set, which is what a program falls back from.
	#argb 0, 1
	lda #OP_PAGE_FLIP
	jsr cmd0
	#wantErr ERR_UNSUPPORTED
	#check "DEFER REFUSED"

	lda STATUS
	and #ST_BUSY
	jsr kitWantClear
	#check "NOT BUSY"

	#argb 0, 0
	lda #OP_PAGE_FLIP
	jsr cmd0
	#wantOk
	#check "FLIP NOW AGAIN"

done
	lda #OP_RESET_STATE
	jsr cmd0
	jmp kitFinish

; ----------------------------------------------------------------------
; Read one pixel of the draw page. Any pixel will do -- the pages are
; cleared to a flat colour -- so this reads the cheapest rectangle there
; is rather than a whole row.
; ----------------------------------------------------------------------

readOne
	#poison RB, 1
	#stgRead RB, 160, 100, 1, 1
	lda #OP_READ_RECT
	jsr cmd0
	rts

; Poll for the vblank-pending bit. X = 0 if it arrived, F_RANGE if 65536
; polls went by without it -- about half a second, or two dozen frames on
; any display gpu64 can drive.
waitPending
	lda #0
	sta wCount
	sta wCount+1
wpLoop
	lda STATUS
	and #ST_VB_PEND
	bne wpGot
	inc wCount
	bne wpLoop
	inc wCount+1
	bne wpLoop
	ldx #F_RANGE
	rts
wpGot
	ldx #0
	rts

; The same wait, for the busy bit clearing after a deferred flip.
waitNotBusy
	lda #0
	sta wCount
	sta wCount+1
wnLoop
	lda STATUS
	and #ST_BUSY
	beq wnGot
	inc wCount
	bne wnLoop
	inc wCount+1
	bne wnLoop
	ldx #F_RANGE
	rts
wnGot
	ldx #0
	rts

hasVb	.byte 0
wCount	.word 0

	.include "gpu64_testkit_rt.inc"
