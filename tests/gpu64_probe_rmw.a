;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- does a read-modify-write on a gpu64 register still kill
;      the C64?
;
;      WHY THIS EXISTS
;
;      Polling-loop rule 7 (CLAUDE.md) says a DMA hold may only be opened
;      immediately after a sampled IO2 access, because asserting DMA
;      pulls RDY *and* AEC: RDY halts the 6510 only on a read cycle,
;      while AEC tri-states the address bus regardless. A write already
;      in flight therefore completes at a floating address and corrupts
;      the machine. That is the Stage 16 derail, solved 2026-09-06.
;
;      The rule rested on "an IO2 access is always the last cycle of its
;      instruction". True for absolute loads and stores -- which is all
;      the API itself ever emits -- and false for two shapes a C64
;      program is entitled to write:
;
;        inc $DF56        c4 reads $DF56, c5 writes the old value, c6
;                         the new one. A hold opened after c4 asserts
;                         into a write.
;        sta $DFFF,X      c4 is an *unconditional* dummy read at the
;                         un-fixed address -- in IO2 -- and c5 is the
;                         write, anywhere.
;
;      That exposure was recorded as an API constraint rather than
;      fixed, and the CMD_LO dispatch hold had carried it since
;      milestone 4. The firmware of 2026-09-07 closes it: a hold now
;      arms on the access and opens one C64 cycle later, only once that
;      cycle has proved itself a read at a different address
;      (Source/Firmware/gpu64_holdgate.h).
;
;      This program is the instrument for that fix. Every rung drives one
;      of the shapes above at a rate no real program would, with a
;      deferred PAGE_FLIP armed so that the loop-fired commit hold is
;      trying to open in exactly the window the shape is unsafe in.
;
;        Phase   Inside the armed window     The shape under test
;        -----   -------------------------   -------------------------
;        BASE    NOP dispatches              none -- the control rung,
;                                              today's hardened path
;        STAP    sta $DFFF,X  (X=$57)        indexed store: IO2 dummy
;                                              read at $DF56, then a
;                                              write to $E056
;        INCA    inc $DF56                   absolute RMW: IO2 read,
;                                              then two IO2 writes
;        INCP    inc $DFFF,X  (X=$57)        indexed RMW across a page:
;                                              IO2 dummy read at $DF56,
;                                              a real read at $E056 with
;                                              the SAME low byte, then
;                                              two writes
;
;      and two more that put the same shapes on CMD_LO itself, where the
;      dispatch hold lives:
;
;        DISS    sta CMD_LO,X (X=0)          the dummy read lands on
;                                              CMD_LO, one cycle before
;                                              the write that dispatches
;        DISI    inc CMD_LO                  CMD_LO reads back as $FF,
;                                              so this writes $FF and
;                                              then $00 -- one NOP
;                                              dispatch, from an RMW
;
;      INCP is the rung the fix's fourth term exists for. Indexed
;      addressing only ever fixes up the *high* address byte, so the
;      dummy read at $DF56 and the real read at $E056 share a low byte,
;      and a gate that only asked "is the next cycle a read?" would let
;      the real read confirm the dummy one and open the hold into a
;      write after all.
;
;      HOW TO READ THE RESULT
;
;        GPU64 PROBE RMW
;
;        HEALTH ee tt ss lo hi dd pp cc
;        GATE   aaaa ffff gggg dddd     armed, fired, worst arm-to-fire
;                                       wait in C64 cycles, declines
;        DISP   rrrr eeee               CMD_LO writes deferred as an RMW,
;                                       and deferred dispatches that ran
;
;               ATT  ACC  MISS DUR      per rung, hexadecimal, as in
;        BASE   4E20 4E20 0000 0198     gpu64_probe_latch
;        ...
;
;        FIRST ERR  EE @ P NNNN
;        PHASE  BSAPDIV                 one letter per rung reached. If
;                                       it stops short, THAT rung is
;                                       where the machine died
;        ALIVE  -  STAGE 30
;        TRAP  00 PC 0000               only if a BRK or NMI was taken
;        VERDICT PASS
;
;      WHAT EACH OUTCOME MEANS
;
;        FAIL (NO DEFER)
;              -- every rung was clean, but DISP is zero: the CMD_LO
;                 ambiguity test never recognised a read-modify-write, so
;                 DISS and DISI proved nothing. This is also what a desk
;                 check under tools/prgsim/runsim.py always reports,
;                 because the model has no polling loop to have a gate in
;        PASS, all seven letters
;              -- the gate holds. Every shape that used to be able to
;                 catch a hold mid-write ran tens of thousands of times
;                 with a commit trying to fire into it, and the C64
;                 finished the program.
;        BASE dies
;              -- nothing to do with this fix. Something regressed in
;                 the ordinary dispatch path; go and look there first.
;        BASE clean, STAP or INCA dies
;              -- the gate is not confirming what it thinks it is. Read
;                 GATE: armed far above fired means arms are being made
;                 and never honoured, and ARMED-FIRED is how many holds
;                 the run is missing.
;        STAP and INCA clean, INCP dies
;              -- the low-address-byte term is wrong or is not being
;                 reached, which is the one part of the rule that cannot
;                 be checked by reading the C64 side.
;        DISS or DISI dies, or ACC < ATT there
;              -- the deferred *dispatch* is the broken half. DISP says
;                 whether the deferral path ran at all.
;
;      DISP is also those two rungs' own self-check, and the two numbers
;      in it are deliberately not equal. Both rungs defer, so rrrr should
;      come out near N_DISS + N_DISI. Only DISS *fires* the deferral: its
;      write is the instruction's last cycle, so the deferred dispatch
;      opens on the next opcode fetch. DISI's first write is deferred and
;      then thrown away, because its second write arrives with an IO2
;      write behind it rather than a read, which is unambiguous -- so it
;      dispatches inline, once, with the value that matters. eeee should
;      therefore come out near N_DISS alone.
;
;      If either number is zero the rungs measured nothing: the writes
;      went down the ordinary path, which would mean the ambiguity test
;      is not seeing the dummy read at all.
;
;      Class 0 only: no viewport, no camera, no core 1. The gate is
;      indifferent to what the command does, and a rung that cannot fail
;      for an unrelated reason is worth more here than a realistic one.
;
;      Requires the RAD menu switched to REU mode with T. Power-cycle
;      between runs: a re-launch from the RAD menu inherits firmware
;      state from its predecessor.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

CMD_HI   = $df50
CMD_LO   = $df51
STATUS   = $df52
ERRCODE  = $df53
ID_LO    = $df54
ID_HI    = $df55
ARG      = $df56
RESULT   = $df66
SEQ      = $df67
SEQACK   = $df68

ERR_BUSY = $07

; class 0
OP_NOP           = $00
OP_PAGE_FLIP     = $05
OP_GET_HEALTH    = $0A

SCREEN   = $0400

; zero page scratch. $fb-$fe are free in a BASIC-hosted program.
SRC      = $fb
DST      = $fd

; The page-crossing pair, chosen so the dummy read lands on ARG+0 and the
; real access lands on RAM under the KERNAL that nothing else touches:
;
;   $DFFF + $57 = $E056, and the un-fixed address is $DF56 = ARG+0.
;
; Both bytes matter. $DF56 is what makes the dummy read an IO2 access the
; polling loop samples and can arm on; $56 being the low byte of BOTH
; addresses is what the gate's fourth term has to notice.
XBASE    = $dfff
XOFF     = $57

; ----------------------------------------------------------------------
; Rung budgets. Sized for events per minute, not for statistical power --
; bench time is the scarce resource (CLAUDE.md). The four window rungs
; are paced by the frame clock: they arm a flip when none is in flight
; and hammer their shape when one is, so an iteration is cheap and the
; count is really a wall-clock budget. 20000 is about six seconds and
; about 400 armed windows -- five times the 74 that killed the old FLIP
; rung in gpu64_probe_latch.
;
; The two dispatch rungs are paced by dispatch, at ~2400/s, so 6000 is
; about 2.5 seconds each.
;
; Declared weak so a desk run can shrink them without editing the source:
;   64tass -D N_BASE=200 -D N_STAP=200 ...
; The bench always builds the defaults.
.weak
N_BASE   = 20000
N_STAP   = 20000
N_INCA   = 20000
N_INCP   = 20000
N_DISS   = 6000
N_DISI   = 6000
; How many times the shape under test is repeated per iteration once a
; flip is in flight. Eight keeps the dangerous cycles dense inside the
; armed window without making an iteration long enough to miss the
; window's close.
N_SHAPE  = 8
.endweak

; Screen rows.
ROW_HEALTH   = 2
ROW_GATE     = 3
ROW_DISP     = 4
ROW_HEAD     = 5
ROW_BASE     = 6
ROW_STAP     = 7
ROW_INCA     = 8
ROW_INCP     = 9
ROW_DISS     = 10
ROW_DISI     = 11
ROW_FIRSTERR = 13
ROW_PHASE    = 14
ROW_ALIVE    = 15
ROW_TRAP     = 17
ROW_VERDICT  = 19
ROW_CURSOR   = 21

COL_VAL      = 7		; first count column; the rest are +5 apart
COL_LBL      = 14		; value column for the label rows below

; Phase breadcrumb letters, as screen codes (letter - $40).
PH_BASE    = $02		; B
PH_STAP    = $13		; S
PH_INCA    = $01		; A
PH_INCP    = $10		; P
PH_DISS    = $04		; D
PH_DISI    = $09		; I
PH_VERDICT = $16		; V

; Trap markers.
TRAP_BRK = $01
TRAP_NMI = $02

; KERNAL vectors and calls.
CBINV = $0316			; BRK
NMINV = $0318			; NMI
PLOT  = $fff0

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	; Remembered so a trap can put the stack back the way BASIC left it and
	; still let the final RTS return there.
	tsx
	stx entrySP

	jsr clearScreen
	lda #<txtTitle
	ldy #>txtTitle
	ldx #0
	jsr printAt

	jsr installTraps
	jsr showLabels

	; CMD_HI is sticky, and every command in this program is class 0.
	; Set once here so the rungs never have to touch it -- DISI in
	; particular must reach CMD_LO with nothing else written in between.
	lda #0
	sta CMD_HI

	jsr doHealth

	lda #PH_BASE
	jsr phase
	lda #0
	sta curPhase
	jsr runBase

	lda abortFlag
	bne allDone

	lda #PH_STAP
	jsr phase
	lda #1
	sta curPhase
	jsr runStap

	lda abortFlag
	bne allDone

	lda #PH_INCA
	jsr phase
	lda #2
	sta curPhase
	jsr runInca

	lda abortFlag
	bne allDone

	lda #PH_INCP
	jsr phase
	lda #3
	sta curPhase
	jsr runIncp

	lda abortFlag
	bne allDone

	lda #PH_DISS
	jsr phase
	lda #4
	sta curPhase
	jsr runDiss

	lda abortFlag
	bne allDone

	lda #PH_DISI
	jsr phase
	lda #5
	sta curPhase
	jsr runDisi

allDone
	lda #PH_VERDICT
	jsr phase
	jsr verdict

	jsr removeTraps

	lda #0
	sta CMD_HI

	; Park the cursor below the report so BASIC's READY. does not scroll
	; the thing the operator came to read off the top of the screen.
	clc
	ldx #ROW_CURSOR
	ldy #0
	jsr PLOT
	rts

; ----------------------------------------------------------------------
; The four armed-window rungs.
;
; All four share one iteration, and it is the same one gpu64_probe_latch's
; FLIS rung uses: read STATUS, and if no flip is in flight arm one --
; which is a dispatch made with the window CLOSED, so it can never be
; refused and ACC == ATT is a fair standard. If a flip IS in flight, run
; the shape under test instead. The rungs differ in those few
; instructions and in nothing else.
;
; The arming flip is the only command any of them sends. Everything else
; is raw bus traffic aimed at the window the commit hold has to open in.
; ----------------------------------------------------------------------

runBase
	lda #<N_BASE
	sta budLo
	lda #>N_BASE
	sta budHi
	lda #0
	sta allowBusy
	jsr beginPhase
baseLoop
	lda #$10
	jsr setStage
	lda STATUS
	and #$01			; GPU64_STATUS_BUSY
	bne baseShape
	jsr armFlip
	jsr tally
	jmp baseNext
baseShape
	; The control shape: an ordinary absolute-addressed dispatch, which
	; is what every program in this tree emits and what the hold gate
	; must keep treating exactly as before.
	ldx #N_SHAPE
baseRep
	lda #OP_NOP
	sta CMD_LO
	dex
	bne baseRep
	lda #0
	jsr tally
baseNext
	lda #$11
	jsr setStage
	jsr endIter
	lda phaseDone
	beq baseLoop
	jmp finishPhase

runStap
	lda #<N_STAP
	sta budLo
	lda #>N_STAP
	sta budHi
	lda #0
	sta allowBusy
	jsr beginPhase
stapLoop
	lda #$20
	jsr setStage
	lda STATUS
	and #$01
	bne stapShape
	jsr armFlip
	jsr tally
	jmp stapNext
stapShape
	; sta XBASE,X with X = XOFF. Cycle 4 is an unconditional dummy read
	; at $DF56 -- an IO2 access the polling loop samples and can arm on --
	; and cycle 5 is a write to $E056. Under the old rule a commit hold
	; armed on that dummy read opened into the write.
	ldx #XOFF
	lda #0
	sta XBASE,x
	sta XBASE,x
	sta XBASE,x
	sta XBASE,x
	sta XBASE,x
	sta XBASE,x
	sta XBASE,x
	sta XBASE,x
	lda #0
	jsr tally
stapNext
	lda #$21
	jsr setStage
	jsr endIter
	lda phaseDone
	beq stapLoop
	jmp finishPhase

runInca
	lda #<N_INCA
	sta budLo
	lda #>N_INCA
	sta budHi
	lda #0
	sta allowBusy
	jsr beginPhase
incaLoop
	lda #$30
	jsr setStage
	lda STATUS
	and #$01
	bne incaShape
	jsr armFlip
	jsr tally
	jmp incaNext
incaShape
	; inc ARG+0: c4 reads $DF56 (which reads back as $FF -- see
	; gpu64_apiReadReg), c5 writes $FF and c6 writes $00. Two IO2 writes
	; in a row, straight after an IO2 read at the same address. Nothing
	; observable happens: ARG+0 is a staging byte and no command in this
	; rung consumes it.
	ldx #N_SHAPE
incaRep
	inc ARG+0
	dex
	bne incaRep
	lda #0
	jsr tally
incaNext
	lda #$31
	jsr setStage
	jsr endIter
	lda phaseDone
	beq incaLoop
	jmp finishPhase

runIncp
	lda #<N_INCP
	sta budLo
	lda #>N_INCP
	sta budHi
	lda #0
	sta allowBusy
	jsr beginPhase
incpLoop
	lda #$40
	jsr setStage
	lda STATUS
	and #$01
	bne incpShape
	jsr armFlip
	jsr tally
	jmp incpNext
incpShape
	; inc XBASE,X with X = XOFF: c4 dummy-reads $DF56 (IO2), c5 reads
	; $E056, c6 and c7 write it. The two reads share a low byte, which is
	; the whole point -- a gate that only asked "is the next cycle a
	; read?" would let c5 confirm c4's arm and open the hold into c6.
	ldx #XOFF
	inc XBASE,x
	inc XBASE,x
	inc XBASE,x
	inc XBASE,x
	inc XBASE,x
	inc XBASE,x
	inc XBASE,x
	inc XBASE,x
	lda #0
	jsr tally
incpNext
	lda #$41
	jsr setStage
	jsr endIter
	lda phaseDone
	beq incpLoop
	jmp finishPhase

; ----------------------------------------------------------------------
; The two dispatch rungs.
;
; These do not arm a flip: they are about the CMD_LO hold, not the commit
; hold, and a pending flip would only add a legitimate reason to answer
; BUSY. Every dispatch here must be accepted.
; ----------------------------------------------------------------------

runDiss
	lda #<N_DISS
	sta budLo
	lda #>N_DISS
	sta budHi
	lda #0
	sta allowBusy
	jsr beginPhase
dissLoop
	lda #$50
	jsr setStage
	jsr nextSeq
	; sta CMD_LO,X with X = 0. The dummy read on c4 lands on CMD_LO
	; itself, one cycle before the write that dispatches -- which is
	; exactly the read-modify-write signature the firmware defers on, so
	; this is the rung that exercises the deferred dispatch path.
	ldx #0
	lda #OP_NOP
	sta CMD_LO,x
	lda ERRCODE
	jsr checkSeq
	jsr tally
	lda #$51
	jsr setStage
	jsr endIter
	lda phaseDone
	beq dissLoop
	jmp finishPhase

runDisi
	lda #<N_DISI
	sta budLo
	lda #>N_DISI
	sta budHi
	lda #0
	sta allowBusy
	jsr beginPhase
disiLoop
	lda #$60
	jsr setStage
	jsr nextSeq
	; inc CMD_LO. CMD_LO reads back as $FF, so c5 writes $FF and c6
	; writes $00: the deferred arm from c5 is discarded and c6
	; dispatches, once, with opcode $00 -- a NOP. If the firmware ever
	; dispatched on c5 instead, this rung would issue opcode $FF and
	; ERRCODE would say BAD_OPCODE.
	inc CMD_LO
	lda ERRCODE
	jsr checkSeq
	jsr tally
	lda #$61
	jsr setStage
	jsr endIter
	lda phaseDone
	beq disiLoop
	jmp finishPhase

; Arms a deferred PAGE_FLIP. Only ever called with STATUS clear, so it
; cannot legitimately be refused. Returns the ERRCODE in A.
armFlip
	lda #1				; 1 = defer to the vblank boundary
	sta ARG+0
	lda #OP_PAGE_FLIP
	jmp cmdSeq0

; ----------------------------------------------------------------------
; Phase bookkeeping. Identical to gpu64_probe_latch's.
; ----------------------------------------------------------------------

beginPhase
	lda #0
	sta att
	sta att+1
	sta acc
	sta acc+1
	sta missed
	sta missed+1
	sta phaseDone
	lda #1
	sta seqCounter
	jsr readJiffy
	sta durStart
	stx durStart+1
	jmp showPhaseRow

finishPhase
	jsr readJiffy
	sec
	sbc durStart
	sta dur
	txa
	sbc durStart+1
	sta dur+1
	jsr showPhaseRow
	jsr savePhase
	jsr doHealth
	lda #$30
	jmp setStage

; A = the ERRCODE the dispatch answered.
tally
	cmp #0
	bne tBad
	inc acc
	bne tDone
	inc acc+1
	rts
tBad
	ldx allowBusy
	beq tRecord
	cmp #ERR_BUSY
	beq tDone
tRecord
	ldx firstErrSet
	bne tDone
	sta firstErr
	lda curPhase
	sta firstErrPhase
	lda att
	sta firstErrAt
	lda att+1
	sta firstErrAt+1
	inc firstErrSet
	jmp showFirstErr
tDone
	rts

endIter
	inc att
	bne eiCounted
	inc att+1
eiCounted
	; Refreshing the row costs more 6502 time than the shape does, so it
	; happens every 32 iterations -- often enough that the spinner still
	; reads as alive at the bench, rare enough not to throttle the rate
	; this is trying to maximise.
	lda att
	and #$1f
	bne eiNoShow
	jsr spin
	jsr showPhaseRow
eiNoShow
	; RUN/STOP, read the way the KERNAL does.
	lda $91
	cmp #$7f
	bne eiNoStop
	lda #1
	sta abortFlag
	sta phaseDone
	rts
eiNoStop
	lda att+1
	cmp budHi
	bcc eiDone
	bne eiFull
	lda att
	cmp budLo
	bcc eiDone
eiFull
	lda #1
	sta phaseDone
eiDone
	rts

; Copies the live counters into this phase's slot for the verdict.
savePhase
	lda curPhase
	asl
	tax
	lda att
	sta attTbl,x
	lda att+1
	sta attTbl+1,x
	lda acc
	sta accTbl,x
	lda acc+1
	sta accTbl+1,x
	rts

; The jiffy clock, low word: A = low byte, X = high byte. Read twice
; because the IRQ that advances it can land between the two loads.
readJiffy
	lda $a1
	sta rowTmp
	lda $a2
	ldx $a1
	cpx rowTmp
	bne readJiffy
	rts

; ----------------------------------------------------------------------
; Breadcrumb, traps, spinner. Identical to gpu64_probe_latch's.
; ----------------------------------------------------------------------

; A = screen code. Appends one letter to the phase row.
phase
	ldx phaseIdx
	cpx #16
	bcs phaseFull
	sta SCREEN + ROW_PHASE * 40 + COL_LBL, x
	inc phaseIdx
phaseFull
	rts

installTraps
	lda CBINV
	sta oldBrk
	lda CBINV+1
	sta oldBrk+1
	lda NMINV
	sta oldNmi
	lda NMINV+1
	sta oldNmi+1

	sei
	lda #<brkTrap
	sta CBINV
	lda #>brkTrap
	sta CBINV+1
	lda #<nmiTrap
	sta NMINV
	lda #>nmiTrap
	sta NMINV+1
	cli
	rts

; Put them back before returning to BASIC -- these vectors point into a
; program BASIC is free to overwrite.
removeTraps
	sei
	lda oldBrk
	sta CBINV
	lda oldBrk+1
	sta CBINV+1
	lda oldNmi
	sta NMINV
	lda oldNmi+1
	sta NMINV+1
	cli
	rts

; The KERNAL's IRQ entry has already pushed Y, X and A on top of the P/PCL/
; PCH the hardware pushed, so the interrupted address is six and seven
; bytes above the stack pointer.
brkTrap
	tsx
	lda $0105,x
	sta trapPC
	lda $0106,x
	sta trapPC+1
	lda #TRAP_BRK
	sta trapKind
	jsr showTrap

	ldx entrySP
	txs
	cli
	jmp allDone

; An NMI is not necessarily fatal -- RESTORE is one -- so this one records
; and resumes rather than unwinding. It still fails the verdict.
nmiTrap
	pha
	txa
	pha
	tya
	pha
	tsx
	lda $0105,x
	sta trapPC
	lda $0106,x
	sta trapPC+1
	lda #TRAP_NMI
	sta trapKind

	; showTrap goes through printAt, which owns SRC/DST, and rowAddr,
	; which owns rowTmp. This handler resumes, so it has to hand all
	; three back exactly as it found them.
	lda SRC
	sta nmiZp+0
	lda SRC+1
	sta nmiZp+1
	lda DST
	sta nmiZp+2
	lda DST+1
	sta nmiZp+3
	lda rowTmp
	sta nmiZp+4
	jsr showTrap
	lda nmiZp+0
	sta SRC
	lda nmiZp+1
	sta SRC+1
	lda nmiZp+2
	sta DST
	lda nmiZp+3
	sta DST+1
	lda nmiZp+4
	sta rowTmp

	pla
	tay
	pla
	tax
	pla
	rti

showTrap
	lda #<txtTrap
	ldy #>txtTrap
	ldx #ROW_TRAP
	jsr printAt
	lda #ROW_TRAP
	jsr rowAddr
	ldy #COL_LBL
	lda trapKind
	jsr putHex
	iny
	lda trapPC+1
	jsr putHex
	lda trapPC
	jsr putHex
	rts

; One glyph every 32 iterations. A frozen spinner with a dead interface is
; a dead C64; a turning one is a C64 that is merely being ignored.
spin
	inc spinIdx
	lda spinIdx
	and #3
	sta spinIdx
	tax
	lda spinTable,x
	sta SCREEN + ROW_ALIVE * 40 + COL_LBL
	rts

; A = where in the iteration we are; see the ALIVE line in the header.
setStage
	pha
	lsr
	lsr
	lsr
	lsr
	jsr hexDigit
	sta SCREEN + ROW_ALIVE * 40 + COL_LBL + 8
	pla
	and #$0f
	jsr hexDigit
	sta SCREEN + ROW_ALIVE * 40 + COL_LBL + 9
	rts

; ----------------------------------------------------------------------
; Command helpers.
;
; Writing CMD_LO is what dispatches; CMD_HI is sticky and was set once at
; start-up. The C64 is DMA-halted for the whole dispatch, so there is
; nothing to poll -- ERRCODE is valid on the very next instruction, and
; that stays true for a deferred dispatch, because the hold opens on the
; next instruction's opcode fetch and stretches it.
; ----------------------------------------------------------------------

cmd0
	sta CMD_LO
	lda ERRCODE
	rts

; A = opcode. Also writes an incrementing SEQ before dispatch and checks
; SEQACK after it -- detector only, no retry. A mismatch means a register
; write was not sampled by reuUsingPolling(): the pre-existing
; bus-reliability defect CLAUDE.md documents. Counted in missed, and NOT
; a verdict failure.
cmdSeq0
	jsr nextSeq
	jsr cmd0
	jmp checkSeq

; Preserves A (the opcode); cycles SEQ over $01-$FE.
nextSeq
	pha
	inc seqCounter
	lda seqCounter
	cmp #255
	bne nsOk
	lda #1
	sta seqCounter
nsOk
	lda seqCounter
	sta SEQ
	pla
	rts

; Preserves A (the ERRCODE the caller is about to judge).
checkSeq
	pha
	lda SEQACK
	cmp seqCounter
	beq csDone
	inc missed
	bne csDone
	inc missed+1
csDone
	pla
	rts

; ----------------------------------------------------------------------
; The verdict.
;
; MISSED is reported, never judged: the drop floor is pre-existing and a
; nonzero count is a measurement, not a regression. What fails a run is a
; trap, an abort, a rung that never ran, or any rung whose ACC is short
; of its ATT -- every rung here is built so that BUSY is not a legal
; answer, so a single refusal is the interface failing.
; ----------------------------------------------------------------------

verdict
	lda trapKind
	beq vNoTrap
	jmp vFail
vNoTrap

	lda abortFlag
	beq vNoAbort
	lda #<txtAbort
	ldy #>txtAbort
	ldx #ROW_VERDICT
	jmp printAt
vNoAbort

	ldx #0
vLoop
	; ACC must equal ATT ...
	lda attTbl,x
	cmp accTbl,x
	bne vFail
	lda attTbl+1,x
	cmp accTbl+1,x
	bne vFail
	; ... and must not be zero, which would be a rung that never ran.
	lda accTbl,x
	ora accTbl+1,x
	beq vFail
	inx
	inx
	cpx #12
	bne vLoop

	; Every rung is clean. What is left to check is whether the two
	; dispatch rungs went through the deferral path at all -- if they did
	; not, the C64 survived a test that never ran.
	;
	; This gets its own verdict rather than a bare FAIL because it is a
	; different finding, and because it is what a desk check under
	; tools/prgsim/runsim.py always reports: the model has no polling
	; loop and therefore no hold gate, so it leaves these two counters at
	; zero however the program behaves. On hardware it means the
	; ambiguity test in the CMD_LO path is not recognising the dummy
	; read, and DISS and DISI proved nothing.
	lda healthBuf+44
	ora healthBuf+45
	beq vNoDefer
	lda healthBuf+46
	ora healthBuf+47
	beq vNoDefer

	lda #<txtPass
	ldy #>txtPass
	ldx #ROW_VERDICT
	jmp printAt
vNoDefer
	lda #<txtNoDefer
	ldy #>txtNoDefer
	ldx #ROW_VERDICT
	jmp printAt
vFail
	lda #<txtFail
	ldy #>txtFail
	ldx #ROW_VERDICT
	jmp printAt

; ----------------------------------------------------------------------
; Screen output.
; ----------------------------------------------------------------------

showLabels
	lda #<txtHealth
	ldy #>txtHealth
	ldx #ROW_HEALTH
	jsr printAt
	lda #<txtGate
	ldy #>txtGate
	ldx #ROW_GATE
	jsr printAt
	lda #<txtDisp
	ldy #>txtDisp
	ldx #ROW_DISP
	jsr printAt
	lda #<txtHead
	ldy #>txtHead
	ldx #ROW_HEAD
	jsr printAt
	lda #<txtBase
	ldy #>txtBase
	ldx #ROW_BASE
	jsr printAt
	lda #<txtStap
	ldy #>txtStap
	ldx #ROW_STAP
	jsr printAt
	lda #<txtInca
	ldy #>txtInca
	ldx #ROW_INCA
	jsr printAt
	lda #<txtIncp
	ldy #>txtIncp
	ldx #ROW_INCP
	jsr printAt
	lda #<txtDiss
	ldy #>txtDiss
	ldx #ROW_DISS
	jsr printAt
	lda #<txtDisi
	ldy #>txtDisi
	ldx #ROW_DISI
	jsr printAt
	lda #<txtFirstErr
	ldy #>txtFirstErr
	ldx #ROW_FIRSTERR
	jsr printAt
	lda #<txtPhase
	ldy #>txtPhase
	ldx #ROW_PHASE
	jsr printAt
	lda #<txtAlive
	ldy #>txtAlive
	ldx #ROW_ALIVE
	jmp printAt

; The current phase's row, from the live counters. DUR is recomputed here
; rather than read from what finishPhase left behind, so a rung that dies
; mid-way still reports the time it actually ran.
showPhaseRow
	jsr readJiffy
	sec
	sbc durStart
	sta dur
	txa
	sbc durStart+1
	sta dur+1
	clc
	lda curPhase
	adc #ROW_BASE
	jsr rowAddr
	ldy #COL_VAL
	lda att+1
	jsr putHex
	lda att
	jsr putHex
	iny
	lda acc+1
	jsr putHex
	lda acc
	jsr putHex
	iny
	lda missed+1
	jsr putHex
	lda missed
	jsr putHex
	iny
	lda dur+1
	jsr putHex
	lda dur
	jsr putHex
	rts

showFirstErr
	lda #ROW_FIRSTERR
	jsr rowAddr
	ldy #COL_LBL
	lda firstErr
	jsr putHex
	iny
	lda #$00			; '@' is screen code $00
	sta (DST),y
	iny
	iny
	lda firstErrPhase
	jsr putHex
	iny
	lda firstErrAt+1
	jsr putHex
	lda firstErrAt
	jsr putHex
	rts

; ----------------------------------------------------------------------
; Screen output helpers. Identical to gpu64_probe_latch.a's.
; ----------------------------------------------------------------------

clearScreen
	ldx #0
	lda #$20
cls1
	sta SCREEN,x
	sta SCREEN+$100,x
	sta SCREEN+$200,x
	sta SCREEN+$300,x
	inx
	bne cls1
	rts

; A/Y = string pointer (zero-terminated PETSCII), X = row.
printAt
	sta SRC
	sty SRC+1
	txa
	jsr rowAddr
	ldy #0
prLoop
	lda (SRC),y
	beq prDone
	cmp #$41
	bcc prPut
	cmp #$5b
	bcs prPut
	sec
	sbc #$40
prPut
	sta (DST),y
	iny
	bne prLoop
prDone
	rts

; A = row; leaves the row's screen address in DST.
rowAddr
	sta rowTmp
	lda #<SCREEN
	sta DST
	lda #>SCREEN
	sta DST+1
	ldx rowTmp
	beq rowDone
rowAdd
	clc
	lda DST
	adc #40
	sta DST
	lda DST+1
	adc #0
	sta DST+1
	dex
	bne rowAdd
rowDone
	rts

; ----------------------------------------------------------------------
; The Pi's opinion of itself, and the hold gate's own counters.
;
;   HEALTH ee tt ss lo hi dd pp cc      as in gpu64_probe_latch
;
;   GATE   aaaa ffff gggg dddd
;          aaaa  gates armed: accesses that asked for the bus
;          ffff  gates fired: arms that confirmed and opened a hold.
;                aaaa - ffff is how many are still outstanding, which on
;                a healthy run is 0 or 1
;          gggg  worst wait from arm to hold, in C64 cycles. A handful is
;                normal; the INCA rung alone should push this to at least
;                3, because an arm taken on inc's read cannot fire until
;                after both of its writes
;          dddd  passes an armed gate could not fire on. Large by
;                construction -- most passes have no IO2 access on the
;                cycle before -- and only interesting next to gggg
;
;   DISP   rrrr eeee
;          rrrr  CMD_LO writes deferred as a read-modify-write. Both
;                dispatch rungs defer, so about N_DISS + N_DISI
;          eeee  deferred dispatches that then fired. Only DISS's do --
;                DISI's deferred arm is superseded by its second write --
;                so about N_DISS. Nonzero on both is what says the two
;                rungs measured anything at all
;
; Called after every rung -- never inside one, because a property-mailbox
; round trip inside the dispatch hold is exactly the kind of load the
; rungs are trying to hold constant.
; ----------------------------------------------------------------------

doHealth
	lda #0
	sta ARG+0			; GPU64_SPACE_C64
	lda #<healthBuf
	sta ARG+1
	lda #>healthBuf
	sta ARG+2
	lda #0
	sta ARG+3
	lda #48
	sta ARG+4
	lda #0
	sta ARG+5
	lda #OP_GET_HEALTH
	jsr cmd0
	sta healthErr

showHealth
	lda #ROW_HEALTH
	jsr rowAddr
	lda #COL_VAL
	sta hCol
	lda healthErr
	jsr hPut
	ldx #0
hhLoop
	ldy healthIdx,x
	lda healthBuf,y
	jsr hPut
	inx
	cpx #7
	bne hhLoop

	lda #ROW_GATE
	jsr rowAddr
	lda #COL_VAL
	sta hCol
	ldx #0
sgLoop
	lda gateIdx,x
	jsr hPut16
	inx
	cpx #4
	bne sgLoop

	lda #ROW_DISP
	jsr rowAddr
	lda #COL_VAL
	sta hCol
	ldx #0
sdLoop
	lda dispIdx,x
	jsr hPut16
	inx
	cpx #2
	bne sdLoop
	rts

; A = offset of a little-endian 16-bit field in healthBuf. Prints it
; big-endian at hCol, then steps hCol on by five.
hPut16
	sta gapTmp
	ldy gapTmp
	iny
	lda healthBuf,y		; high byte first, so it reads as a number
	ldy hCol
	jsr putHex
	inc hCol
	inc hCol
	ldy gapTmp
	lda healthBuf,y		; then the low byte
	ldy hCol
	jsr putHex
	clc
	lda hCol
	adc #3
	sta hCol
	rts

; A = byte; prints it at hCol on the row DST already points at, then
; steps hCol on by three.
hPut
	ldy hCol
	jsr putHex
	clc
	lda hCol
	adc #3
	sta hCol
	rts

; A = byte, Y = column offset within the row DST already points at.
putHex
	pha
	lsr
	lsr
	lsr
	lsr
	jsr hexDigit
	sta (DST),y
	iny
	pla
	and #$0f
	jsr hexDigit
	sta (DST),y
	iny
	rts

hexDigit
	cmp #10
	bcs hexAlpha
	clc
	adc #$30
	rts
hexAlpha
	sec
	sbc #9
	rts

; ----------------------------------------------------------------------
; Data.
; ----------------------------------------------------------------------

txtTitle	.text "GPU64 PROBE RMW"
		.byte 0
txtHead		.text "       ATT  ACC  MISS DUR"
		.byte 0
txtBase		.text "BASE"
		.byte 0
txtStap		.text "STAP"
		.byte 0
txtInca		.text "INCA"
		.byte 0
txtIncp		.text "INCP"
		.byte 0
txtDiss		.text "DISS"
		.byte 0
txtDisi		.text "DISI"
		.byte 0
txtFirstErr	.text "FIRST ERR"
		.byte 0
txtPhase	.text "PHASE"
		.byte 0
txtAlive	.text "ALIVE           STAGE"
		.byte 0
txtHealth	.text "HEALTH"
		.byte 0
txtGate		.text "GATE"
		.byte 0
txtDisp		.text "DISP"
		.byte 0
txtTrap		.text "TRAP"
		.byte 0

; -, N-shape, ], M-shape: four screen codes that read as a turning bar.
spinTable	.byte $2d, $4e, $5d, $4d

txtPass		.text "VERDICT PASS"
		.byte 0
txtFail		.text "VERDICT FAIL"
		.byte 0
txtAbort	.text "VERDICT ABORT (RUN/STOP)"
		.byte 0
txtNoDefer	.text "VERDICT FAIL (NO DEFER)"
		.byte 0

; ----------------------------------------------------------------------
; Variables.
; ----------------------------------------------------------------------

curPhase	.byte 0
budLo		.byte 0
budHi		.byte 0
allowBusy	.byte 0
phaseDone	.byte 0
abortFlag	.byte 0

att		.word 0
acc		.word 0
missed		.word 0
dur		.word 0
durStart	.word 0

attTbl		.fill 12, 0
accTbl		.fill 12, 0

seqCounter	.byte 1
firstErr	.byte 0
firstErrPhase	.byte 0
firstErrAt	.word 0
firstErrSet	.byte 0

rowTmp		.byte 0
entrySP		.byte 0
phaseIdx	.byte 0
spinIdx		.byte 0
trapKind	.byte 0
trapPC		.word 0

healthIdx	.byte 0, 6, 8, 9, 12, 14, 16
gateIdx		.byte 36, 38, 40, 42
dispIdx		.byte 44, 46
gapTmp		.byte 0
hCol		.byte 0
healthErr	.byte 0
healthBuf	.fill 48, 0
oldBrk		.word 0
oldNmi		.word 0
nmiZp		.fill 5, 0
