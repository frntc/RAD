;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- API conformance suite 7/7: class 2, the raster layer.
;
;      WHAT THIS TESTS
;
;      Every class 2 opcode: SET_VIEW, SET_COLORMAP, UPLOAD_TEXTURE,
;      FREE_TEXTURE, FILL_VIEW, DRAW_COLUMNS, DRAW_SPANS, DRAW_SPRITE and
;      RASTER_STATS -- and, as with the drawing suite, it tests them by
;      reading the framebuffer back with class 0's READ_RECT rather than by
;      looking at the screen.
;
;      Four properties are asserted about the batch primitives, because
;      each is a different way for a column renderer to be wrong:
;
;        the RUN is right -- the pixels inside y0..y1 are painted and the
;        ones just outside are not. An off-by-one at the end of a run is
;        the classic column bug and is invisible at 320x200.
;
;        the TEXTURE COORDINATE is right -- v steps by dv per row and wraps
;        at the texture height, so a column taller than its texture repeats
;        rather than running off the end of it.
;
;        CLIPPING advances v across the rows it clipped away, so a wall
;        does not slide up its own texture as its top leaves the screen.
;        This one is a real trap: clamping y0 without advancing v looks
;        perfect until the player walks close to a wall.
;
;        a BAD RECORD is rejected and counted, and the batch still returns
;        OK. RASTER_STATS is the only way a program can see that, and it is
;        also the length readback the bus's known write-drop floor demands
;        (CLAUDE.md rule 3) -- so a batch that lost bytes on the way over
;        shows up as a rejected count that should have been zero.
;
;      HOW TO READ THE RESULT
;
;      One line per assertion, OK or F<hex>, exactly like the other six.
;      $E3 is a framebuffer byte that was wrong; $FE is a command that
;      answered OK where an error was demanded.
;
;      A wall of $FF is not a class 2 failure -- it is nothing on the bus
;      answering at all. A wall of $02 (BAD_CLASS) means this firmware does
;      not have class 2 compiled in; GET_INFO byte 11 bit 2 says so up
;      front, and this program asks before it does anything else.
;
;      Requires the RAD menu switched to REU mode with T.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64_testkit.inc"

RB	= $3000				; framebuffer readback buffer
STATS	= $3100				; RASTER_STATS destination
BATCH	= $3200				; the record array a batch names
TEX	= $3400				; texture source bytes
CMAP	= $3600				; colormap source bytes, 2 x 256

BG	= 0				; the colour the page is cleared to

; Colours the wall section asserts. Named because the assertions read as
; geometry and a bare 7 in an #expectb reads as nothing at all.
WALLC	= 7				; the wall itself
CEILC	= 3				; ceiling, when CAM_PAINT is on
FLOORC	= 2				; floor, likewise
FARC	= 1				; the wall that is behind the camera
TEXID	= 5				; the id everything uploads to
TEXW	= 4				; the test texture is 4 wide ...
TEXH	= 4				; ... and 4 tall, a power of two

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	jsr kitInit
	#title "GPU64 API TEST 7 - RASTER"

	; ---------------------------------------------------------------
	; Is class 2 there at all? GET_INFO byte 11 bit 2 says so, and if
	; it is clear then every line below would fail as BAD_CLASS for a
	; reason that is not a defect. Ask first.
	; ---------------------------------------------------------------
	#poison RB, 16, $aa
	#argblob 0, SPACE_C64, RB, 16
	lda #OP_GET_INFO
	jsr cmd0
	#wantOk
	#check "GET INFO"

	#clracc
	lda RB+11
	and #$04
	bne +
	jsr kitBad
+
	#useacc
	#check "CLASS 2 BIT"

	; A clean page to draw on, and a known class 2 state.
	#argb 0, BG
	lda #OP_CLEAR
	jsr cmd0
	#wantOk
	#check "CLEAR"

	lda #R2_RESET
	jsr cmd2
	#wantOk
	#check "RESET"

	; ---------------------------------------------------------------
	; SET_VIEW -- the clip rectangle every class 2 primitive obeys,
	; which is Doom's 3D window above its status bar.
	; ---------------------------------------------------------------
	#argw 0, 0
	#argw 2, 0
	#argw 4, FB_W
	#argw 6, FB_H
	lda #R2_SET_VIEW
	jsr cmd2
	#wantOk
	#check "VIEW FULL"

	#argw 0, 0
	#argw 2, 0
	#argw 4, 0
	#argw 6, 10
	lda #R2_SET_VIEW
	jsr cmd2
	#wantErr ERR_BAD_ARGS
	#check "VIEW W0"

	#argw 0, 300
	#argw 2, 0
	#argw 4, 40
	#argw 6, 10
	lda #R2_SET_VIEW
	jsr cmd2
	#wantErr ERR_BAD_ARGS
	#check "VIEW OFF PAGE"

	; ---------------------------------------------------------------
	; UPLOAD_TEXTURE. Column-major: texel(u,v) is byte u*h+v.
	;
	; The test texture is texel(u,v) = $10 * (u+1) + v, so every byte
	; read back names both coordinates it came from -- $30 is u=2,
	; v=0 -- and a draw that samples the wrong u or the wrong v is
	; legible as such rather than as "some other colour".
	; ---------------------------------------------------------------
	jsr buildTexture

	lda #<TEXID
	sta ID_LO
	lda #>TEXID
	sta ID_HI
	#argblob 0, SPACE_C64, TEX, TEXW*TEXH
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0			; source is already column-major
	lda #R2_UPLOAD_TEX
	jsr cmd2
	#wantOk
	#check "UPLOAD TEX"

	; h must be a power of two -- the column loop masks v with h-1.
	#argblob 0, SPACE_C64, TEX, TEXW*3
	#argw 6, TEXW
	#argw 8, 3
	#argb 10, 0
	lda #R2_UPLOAD_TEX
	jsr cmd2
	#wantErr ERR_BAD_ARGS
	#check "UPLOAD ODD H"

	; len has to agree with w * h.
	#argblob 0, SPACE_C64, TEX, TEXW*TEXH-1
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #R2_UPLOAD_TEX
	jsr cmd2
	#wantErr ERR_BAD_ARGS
	#check "UPLOAD BAD LEN"

	; id 0 is not a texture id -- it is the record format's "solid
	; colour" marker, so it can never name an upload.
	lda #0
	sta ID_LO
	sta ID_HI
	#argblob 0, SPACE_C64, TEX, TEXW*TEXH
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #R2_UPLOAD_TEX
	jsr cmd2
	#wantErr ERR_BAD_ID
	#check "UPLOAD ID 0"

	; ---------------------------------------------------------------
	; FILL_VIEW paints the view rectangle and nothing outside it.
	; ---------------------------------------------------------------
	#argw 0, 10
	#argw 2, 10
	#argw 4, 8
	#argw 6, 8
	lda #R2_SET_VIEW
	jsr cmd2
	#wantOk
	#check "VIEW SMALL"

	#argb 0, 7
	lda #R2_FILL_VIEW
	jsr cmd2
	#wantOk
	#check "FILL VIEW"

	; Read a 10x10 window whose top-left is (9,9), so the ring of
	; pixels around the filled 8x8 comes back in the same readback.
	; Stride is 10: pixel (x,y) is RB + (y-9)*10 + (x-9).
	#poison RB, 100, $aa
	#stgRead RB, 9, 9, 10, 10
	lda #OP_READ_RECT
	jsr cmd0
	#wantOk
	#check "READ FILL"

	#clracc
	#expectb RB+0, BG		; (9,9)   outside, top-left
	#expectb RB+11, 7		; (10,10) the first filled pixel
	#expectb RB+18, 7		; (17,10) the last of that row
	#expectb RB+19, BG		; (18,10) one past the right edge
	#expectb RB+81, 7		; (10,17) the last filled row
	#expectb RB+91, BG		; (10,18) one past the bottom
	#useacc
	#check "FILL BOUNDS"

	; ---------------------------------------------------------------
	; DRAW_COLUMNS, the primitive the whole class exists for.
	;
	; Back to the full view, then one solid column and one textured
	; one in a SINGLE batch -- a batch of one proves nothing about the
	; record stride.
	; ---------------------------------------------------------------
	#argw 0, 0
	#argw 2, 0
	#argw 4, FB_W
	#argw 6, FB_H
	lda #R2_SET_VIEW
	jsr cmd2
	#wantOk
	#check "VIEW FULL 2"

	; Record 0: solid colour 3 down x=40, rows 4..7.
	#r2col BATCH, 40, 4, 7, R2_SOLID, 0, 3, 0, 0
	; Record 1: the texture down x=41, rows 4..11, sampling texture
	; column u=2 from v=0 stepping exactly one texel per row -- so the
	; eight rows read texels 0,1,2,3,0,1,2,3 and prove the wrap.
	#r2col BATCH+R2_REC, 41, 4, 11, TEXID, 0, 2, 0, $0100

	#r2batch BATCH, 2
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantOk
	#check "DRAW COLUMNS"

	; x=39..42, y=3..12 -- both columns plus a margin all round.
	; Stride is 4: pixel (x,y) is RB + (y-3)*4 + (x-39).
	#poison RB, 40, $aa
	#stgRead RB, 39, 3, 4, 10
	lda #OP_READ_RECT
	jsr cmd0
	#wantOk
	#check "READ COLUMNS"

	#clracc
	#expectb RB+1, BG		; (40,3) one row above the run
	#expectb RB+5, 3		; (40,4) first row of the run
	#expectb RB+17, 3		; (40,7) last row of the run
	#expectb RB+21, BG		; (40,8) one row below it
	#expectb RB+2, BG		; (41,3) above the textured column
	#useacc
	#check "COLUMN RUN"

	#clracc
	#expectb RB+6, $30		; (41,4)  v=0
	#expectb RB+10, $31		; (41,5)  v=1
	#expectb RB+14, $32		; (41,6)  v=2
	#expectb RB+18, $33		; (41,7)  v=3
	#expectb RB+22, $30		; (41,8)  v wrapped back to 0
	#expectb RB+34, $33		; (41,11) v=3 again
	#expectb RB+38, BG		; (41,12) one past the run
	#useacc
	#check "COLUMN TEXEL"

	; ---------------------------------------------------------------
	; Clipping must advance v across the rows it threw away. y0 = -2
	; with dv = one texel per row means the first VISIBLE row is row 0
	; and it must show v = 2, not v = 0.
	; ---------------------------------------------------------------
	#r2col BATCH, 60, -2, 5, TEXID, 0, 0, 0, $0100
	#r2batch BATCH, 1
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantOk
	#check "COLUMN CLIP"

	#poison RB, 8, $aa
	#stgRead RB, 60, 0, 1, 8
	lda #OP_READ_RECT
	jsr cmd0
	#wantOk
	#check "READ CLIP"

	#clracc
	#expectb RB+0, $12		; row 0 shows v=2, not v=0
	#expectb RB+1, $13		; row 1, v=3
	#expectb RB+2, $10		; row 2, wrapped to v=0
	#expectb RB+5, $13		; row 5, the last row of the run
	#expectb RB+6, BG		; row 6, past it
	#useacc
	#check "CLIP TEXEL"

	; ---------------------------------------------------------------
	; A rejected record. x = 900 is outside any view; the batch still
	; returns OK and RASTER_STATS is where the rejection shows up.
	; ---------------------------------------------------------------
	#r2col BATCH, 900, 0, 5, R2_SOLID, 0, 1, 0, 0
	#r2col BATCH+R2_REC, 70, 0, 5, R2_SOLID, 0, 1, 0, 0
	#r2batch BATCH, 2
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantOk
	#check "BATCH BAD REC"

	#poison STATS, 16, $aa
	#argblob 0, SPACE_C64, STATS, 16
	lda #R2_STATS
	jsr cmd2
	#wantOk
	#check "STATS"

	#clracc
	#expectb STATS+0, $52		; 'R'
	#expectb STATS+1, $32		; '2'
	#expectw STATS+2, 1		; accepted
	#expectw STATS+4, 1		; rejected
	#expectw STATS+6, 2		; requested
	#useacc
	#check "STATS COUNTS"

	; An unknown texture id is the other rejection, and it is the one a
	; real program hits: a record left over from a level that has been
	; unloaded.
	#r2col BATCH, 70, 0, 5, 200, 0, 0, 0, 0
	#r2batch BATCH, 1
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantOk
	#check "BAD TEXID"

	#argblob 0, SPACE_C64, STATS, 16
	lda #R2_STATS
	jsr cmd2
	#clracc
	#expectw STATS+2, 0		; nothing accepted
	#expectw STATS+4, 1		; one rejected
	#useacc
	#check "BAD TEXID REJ"

	; ---------------------------------------------------------------
	; The optional checksum. Rule 3 of the working agreement: a bulk
	; upload over this bus needs a way to notice it did not arrive.
	; ---------------------------------------------------------------
	#r2col BATCH, 80, 0, 3, R2_SOLID, 0, 5, 0, 0
	jsr sumBatch1			; correct sum into BATCH+R2_REC
	#r2batch BATCH, 1, R2_BATCH_SUM
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantOk
	#check "BATCH SUM OK"

	#poison RB, 4, $aa
	#stgRead RB, 80, 0, 1, 4
	lda #OP_READ_RECT
	jsr cmd0
	#clracc
	#expectb RB+0, 5
	#expectb RB+3, 5
	#useacc
	#check "BATCH SUM DREW"

	; Corrupt one byte of the sum and the whole batch must be refused
	; without drawing anything -- "a failed dispatch does nothing".
	lda BATCH+R2_REC
	eor #$ff
	sta BATCH+R2_REC
	#r2col BATCH, 81, 0, 3, R2_SOLID, 0, 5, 0, 0
	#r2batch BATCH, 1, R2_BATCH_SUM
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantErr ERR_BAD_ARGS
	#check "BATCH SUM BAD"

	#poison RB, 4, $aa
	#stgRead RB, 81, 0, 1, 4
	lda #OP_READ_RECT
	jsr cmd0
	#clracc
	#expectb RB+0, BG		; nothing was drawn
	#expectb RB+3, BG
	#useacc
	#check "SUM BAD NODRAW"

	; A count that does not agree with the blob length.
	#argblob 0, SPACE_C64, BATCH, 17
	#argw 6, 1
	#argb 8, 0
	#argb 9, 0
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantErr ERR_BAD_ARGS
	#check "BATCH BAD LEN"

	; count = 0 is a no-op, not an error -- a frame with nothing
	; visible must not have to special-case itself.
	#argblob 0, SPACE_C64, BATCH, 0
	#argw 6, 0
	#argb 8, 0
	#argb 9, 0
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantOk
	#check "BATCH COUNT 0"

	; ---------------------------------------------------------------
	; DRAW_SPANS. A span wraps u every pixel, so it needs the texture
	; width to be a power of two as well -- 4 is, so this one draws.
	; Stride is 10: pixel (x,30) is RB + (x-99).
	; ---------------------------------------------------------------
	#r2span BATCH, 30, 100, 107, TEXID, 0, 0, 0, $0100, 0
	#r2batch BATCH, 1
	lda #R2_DRAW_SPANS
	jsr cmd2
	#wantOk
	#check "DRAW SPANS"

	#poison RB, 10, $aa
	#stgRead RB, 99, 30, 10, 1
	lda #OP_READ_RECT
	jsr cmd0
	#clracc
	#expectb RB+0, BG		; x=99, just left of the span
	#expectb RB+1, $10		; x=100, u=0
	#expectb RB+2, $20		; x=101, u=1
	#expectb RB+3, $30		; x=102, u=2
	#expectb RB+4, $40		; x=103, u=3
	#expectb RB+5, $10		; x=104, u wrapped
	#expectb RB+9, BG		; x=108, past the span
	#useacc
	#check "SPAN TEXEL"

	; A solid span: texid 0, the colour in the low byte of u.
	#r2span BATCH, 31, 100, 103, R2_SOLID, 0, 12, 0, 0, 0
	#r2batch BATCH, 1
	lda #R2_DRAW_SPANS
	jsr cmd2
	#wantOk
	#check "SPAN SOLID"

	#poison RB, 6, $aa
	#stgRead RB, 99, 31, 6, 1
	lda #OP_READ_RECT
	jsr cmd0
	#clracc
	#expectb RB+0, BG
	#expectb RB+1, 12
	#expectb RB+4, 12
	#expectb RB+5, BG
	#useacc
	#check "SPAN SOLID BND"

	; ---------------------------------------------------------------
	; DRAW_SPRITE -- the texture scaled into a screen rectangle, with a
	; scalar top/bottom clip for the case where it stands behind a wall
	; edge. 4x4 into 8x8 means every texel becomes a 2x2 block.
	; Stride is 10: pixel (x,y) is RB + (y-39)*10 + (x-149).
	; ---------------------------------------------------------------
	lda #<TEXID
	sta ID_LO
	lda #>TEXID
	sta ID_HI
	#argw 0, 150			; x
	#argw 2, 40			; y
	#argw 4, 8			; w on screen
	#argw 6, 8			; h on screen
	#argb 8, 0			; light
	#argb 9, 0			; key
	#argw 10, 0			; clipY0
	#argw 12, 199			; clipY1
	#argb 14, 0			; flags: opaque
	lda #R2_DRAW_SPRITE
	jsr cmd2
	#wantOk
	#check "DRAW SPRITE"

	#poison RB, 100, $aa
	#stgRead RB, 149, 39, 10, 10
	lda #OP_READ_RECT
	jsr cmd0
	#clracc
	#expectb RB+0, BG		; (149,39) outside, top-left
	#expectb RB+11, $10		; (150,40) texel (0,0)
	#expectb RB+13, $20		; (152,40) texel (1,0)
	#expectb RB+21, $10		; (150,41) still texel (0,0) -- 2x
	#expectb RB+31, $11		; (150,42) texel (0,1)
	#expectb RB+18, $40		; (157,40) texel (3,0), last column
	#expectb RB+19, BG		; (158,40) one past the right edge
	#useacc
	#check "SPRITE TEXEL"

	; The same sprite, clipped so only its bottom half may draw. The
	; scale must be unchanged by the clip: row 44 shows texel (0,2),
	; which is where it would have been without the clip.
	#argb 0, BG
	lda #OP_CLEAR
	jsr cmd0
	#raw

	#argw 0, 150
	#argw 2, 40
	#argw 4, 8
	#argw 6, 8
	#argb 8, 0
	#argb 9, 0
	#argw 10, 44			; clipY0 -- rows 40..43 are cut
	#argw 12, 199
	#argb 14, 0
	lda #R2_DRAW_SPRITE
	jsr cmd2
	#wantOk
	#check "SPRITE CLIPPED"

	#poison RB, 8, $aa
	#stgRead RB, 150, 40, 1, 8
	lda #OP_READ_RECT
	jsr cmd0
	#clracc
	#expectb RB+0, BG		; row 40, clipped away
	#expectb RB+3, BG		; row 43, the last clipped one
	#expectb RB+4, $12		; row 44, texel (0,2)
	#expectb RB+7, $13		; row 47, the last row
	#useacc
	#check "SPRITE CLIP TX"

	; A sprite naming a texture that does not exist is an error, not a
	; rejection: there is no batch for a rejection to be counted in,
	; and silently drawing nothing would be indistinguishable from a
	; sprite that was simply off screen.
	lda #200
	sta ID_LO
	lda #0
	sta ID_HI
	#argw 0, 0
	#argw 2, 0
	#argw 4, 8
	#argw 6, 8
	#argb 8, 0
	#argb 9, 0
	#argw 10, 0
	#argw 12, 199
	#argb 14, 0
	lda #R2_DRAW_SPRITE
	jsr cmd2
	#wantErr ERR_BAD_ID
	#check "SPRITE BAD ID"

	; ---------------------------------------------------------------
	; SET_COLORMAP. Two levels: level 0 maps everything to 1, level 1
	; is the identity. A record's light byte picks the level, and a
	; light past the end of the table clamps rather than failing.
	; ---------------------------------------------------------------
	jsr buildColormap

	#argblob 0, SPACE_C64, CMAP, 512
	#argb 6, 2
	lda #R2_SET_COLORMAP
	jsr cmd2
	#wantOk
	#check "SET COLORMAP"

	#argblob 0, SPACE_C64, CMAP, 511
	#argb 6, 2
	lda #R2_SET_COLORMAP
	jsr cmd2
	#wantErr ERR_BAD_ARGS
	#check "CMAP BAD LEN"

	; Solid colour 9 at light 0 must come out as 1; at light 1 as 9;
	; at light 200 as 9 as well, clamped to the last level.
	#r2col BATCH, 90, 0, 1, R2_SOLID, 0, 9, 0, 0
	#r2col BATCH+R2_REC, 91, 0, 1, R2_SOLID, 1, 9, 0, 0
	#r2col BATCH+2*R2_REC, 92, 0, 1, R2_SOLID, 200, 9, 0, 0
	#r2batch BATCH, 3
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#wantOk
	#check "LIT COLUMNS"

	#poison RB, 3, $aa
	#stgRead RB, 90, 0, 3, 1
	lda #OP_READ_RECT
	jsr cmd0
	#clracc
	#expectb RB+0, 1		; light 0 -> mapped
	#expectb RB+1, 9		; light 1 -> identity
	#expectb RB+2, 9		; light 200 -> clamped to level 1
	#useacc
	#check "LIGHT LEVELS"

	; levels = 0 is the way back to no lighting at all, and takes no
	; blob with it.
	#argb 6, 0
	lda #R2_SET_COLORMAP
	jsr cmd2
	#wantOk
	#check "COLORMAP OFF"

	; ---------------------------------------------------------------
	; FREE_TEXTURE, and the fact that freeing twice is an error.
	; ---------------------------------------------------------------
	lda #<TEXID
	sta ID_LO
	lda #>TEXID
	sta ID_HI
	lda #R2_FREE_TEX
	jsr cmd2
	#wantOk
	#check "FREE TEX"

	lda #R2_FREE_TEX
	jsr cmd2
	#wantErr ERR_BAD_ID
	#check "FREE TWICE"

	; And a record naming it is now a rejection rather than a draw.
	#r2col BATCH, 95, 0, 5, TEXID, 0, 0, 0, 0
	#r2batch BATCH, 1
	lda #R2_DRAW_COLUMNS
	jsr cmd2
	#raw

	#argblob 0, SPACE_C64, STATS, 16
	lda #R2_STATS
	jsr cmd2
	#clracc
	#expectw STATS+4, 1		; rejected
	#useacc
	#check "FREED TEX REJ"

	; ---------------------------------------------------------------
	; An opcode class 2 does not have.
	; ---------------------------------------------------------------
	lda #$7f
	jsr cmd2
	#wantErr ERR_BAD_OPCODE
	#check "BAD OPCODE"

	jmp kitFinish

; ----------------------------------------------------------------------
; Test data.
; ----------------------------------------------------------------------

; The 4x4 test texture, column-major, texel(u,v) = $10 * (u+1) + v. The
; running index is exactly u * TEXH + v, because the loops walk u then v
; in storage order.
buildTexture
	ldx #0				; running index into TEX
	lda #$10			; ( u + 1 ) * 16, for u = 0
	sta kitTmp
btCol
	ldy #0
btRow
	tya
	ora kitTmp
	sta TEX,x
	inx
	iny
	cpy #TEXH
	bne btRow

	lda kitTmp
	clc
	adc #$10
	sta kitTmp
	cmp #$10*(TEXW+1)
	bne btCol
	rts

; Two light levels, 256 bytes each. Level 0 maps every colour to 1; level
; 1 is the identity, so a record at light 1 is unlit.
buildColormap
	ldy #0
bcLoop
	lda #1
	sta CMAP,y			; level 0
	tya
	sta CMAP+256,y			; level 1, identity
	iny
	bne bcLoop
	rts

; The 16-bit sum of one record, written as the two bytes that follow it.
; A checksum a 6502 can afford is a plain sum, not a CRC -- see
; dev/milestone8_raster_design.md.
sumBatch1
	lda #0
	sta kitVal16
	sta kitVal16+1
	ldy #0
sbLoop
	lda kitVal16
	clc
	adc BATCH,y
	sta kitVal16
	bcc +
	inc kitVal16+1
+
	iny
	cpy #R2_REC
	bne sbLoop
	lda kitVal16
	sta BATCH+R2_REC
	lda kitVal16+1
	sta BATCH+R2_REC+1
	rts

	.include "gpu64_testkit_rt.inc"
