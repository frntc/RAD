;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- stage 14: the scene table's limits, on purpose.
;
;      WHAT THIS TESTS
;
;      The same spirit as gpu64_3d_arena_test.a, aimed at the scene graph's
;      256-node table instead of the resource arena:
;
;        1. CREATE_OBJECT succeeds exactly 256 times in a row (the table's
;           documented cap) and the 257th fails with OUT_OF_MEMORY -- an
;           error path that has never fired is not a tested error path.
;
;        2. Re-creating over a LIVE id replaces it in place rather than
;           needing a free slot -- checked by creating over id 1 while the
;           table is completely full and requiring that to still succeed.
;
;        3. DESTROY_NODE reclaims its slot for a later CREATE_OBJECT -- and
;           only that one slot: the table refuses again one node later.
;
;        4. BAD_ID and BAD_ARGS are real, distinct, and returned instead of
;           OK: an unknown id to DESTROY_NODE, and an out-of-range boolean to
;           SET_VISIBLE and a zero to SET_SCALE.
;
;      CREATE_OBJECT never resolves the mesh id it is given -- that lookup
;      happens later, at DRAW_NODE -- so this test uses mesh id 0 throughout
;      and never uploads a mesh at all. That keeps 256 creates cheap: each is
;      one four-byte command, not a DMA pull, so the whole test runs in a
;      fraction of the arena test's runtime.
;
;      HOW TO READ THE RESULT
;
;        GPU64 3D SCENE TABLE TEST
;
;        FILLED       0100      objects accepted before the table refused
;                                one. 256 decimal, i.e. GPU64_3D_MAX_NODES.
;        FILL ERR     08        the error the 257th create got: OUT_OF_MEMORY
;        REPLACE ERR  00        create over the live id 1, table still full
;        DESTROY ERR  00        destroying id 1
;        RECLAIM ERR  00        create into the slot DESTROY_NODE just freed
;        REFULL ERR   08        one more create, table full again
;        BAD ID ERR   0A        DESTROY_NODE on an id that was never created
;        BAD ARG1 ERR 04        SET_VISIBLE with a value that isn't 0 or 1
;        BAD ARG2 ERR 04        SET_SCALE with a scale of zero
;        NO KEY ERR   04        DESTROY_NODE without the one-shot key in
;                                ARG15 -- refused, and DESTROY ERR above
;                                proves the node survived the refusal
;
;        VERDICT PASS
;
;      FILLED under 0100 means something is refusing creates before the
;      table is actually full. FILLED over 0100, or a run that never
;      reaches FILL ERR, means the cap is not being enforced at all, which
;      is the most interesting outcome of all.
;
;      Requires a firmware built with GPU64_3D_ENABLED, and the RAD menu
;      switched to REU mode with T.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

CMD_HI   = $df50
CMD_LO   = $df51
ERRCODE  = $df53
ID_LO    = $df54
ID_HI    = $df55
ARG      = $df56

OP_CREATE_OBJECT = $20
OP_DESTROY_NODE  = $22

; The one-shot key DESTROY_NODE (and SCENE_RESET, LOOP_STOP, FREE_RESOURCE)
; carry in ARG15 -- gpu64_api.h. The firmware spends ARG15 on every dispatch,
; so it is staged immediately before each destructive command and never once
; up front.
KEY      = $a5
ARG_KEY  = 15
OP_SET_VISIBLE   = $24
OP_SET_SCALE     = $35

ERR_OK           = $00
ERR_BAD_ARGS     = $04
ERR_OUT_OF_MEM   = $08
ERR_BAD_ID       = $0a

SCREEN   = $0400
DST      = $fd
SRC      = $fb

; The table holds exactly this many nodes; the fill loop is expected to stop
; one past it.
EXPECT_FILLED_LO = <256
EXPECT_FILLED_HI = >256

; An id nothing in this run ever creates, for the BAD_ID check.
BAD_ID_LO = <9999
BAD_ID_HI = >9999

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	jsr clearScreen
	lda #<txtTitle
	ldy #>txtTitle
	ldx #0
	jsr printAt
	jsr showLabels

	; --- fill the table until CREATE_OBJECT refuses one --------------
	lda #0
	sta curId
	sta curId+1
fillLoop
	inc curId
	bne +
	inc curId+1
+
	lda curId
	sta ID_LO
	lda curId+1
	sta ID_HI
	lda #0				; mesh id 0 -- never resolved here
	sta ARG+0
	sta ARG+1
	lda #OP_CREATE_OBJECT
	jsr cmd1
	cmp #ERR_OK
	beq fillLoop
	sta fillErr

	; curId is the id that just failed (expected 257); filled = curId-1.
	sec
	lda curId
	sbc #1
	sta filled
	lda curId+1
	sbc #0
	sta filled+1

	; --- replace over a live id while the table is full ---------------
	lda #1
	sta ID_LO
	lda #0
	sta ID_HI
	sta ARG+0
	sta ARG+1
	lda #OP_CREATE_OBJECT
	jsr cmd1
	sta replaceErr

	; --- the one-shot key: an UNKEYED destroy must be refused -----------
	; ARG15 is spent by every dispatch (gpu64_api.h), so the
	; CREATE_OBJECT above has already cleared whatever was there. This
	; must answer BAD_ARGS, and node 1 must survive it -- which the keyed
	; destroy immediately below proves by answering OK.
	lda #1
	sta ID_LO
	lda #0
	sta ID_HI
	lda #OP_DESTROY_NODE
	jsr cmd1
	sta noKeyErr

	; --- destroy that node, freeing its slot ---------------------------
	lda #1
	sta ID_LO
	lda #0
	sta ID_HI
	lda #KEY
	sta ARG+ARG_KEY
	lda #OP_DESTROY_NODE
	jsr cmd1
	sta destroyErr

	; --- reclaim: create into the freed slot using the id that failed --
	lda curId
	sta ID_LO
	lda curId+1
	sta ID_HI
	lda #0
	sta ARG+0
	sta ARG+1
	lda #OP_CREATE_OBJECT
	jsr cmd1
	sta reclaimErr

	; --- one more: the table is full again -----------------------------
	inc curId
	bne +
	inc curId+1
+
	lda curId
	sta ID_LO
	lda curId+1
	sta ID_HI
	lda #0
	sta ARG+0
	sta ARG+1
	lda #OP_CREATE_OBJECT
	jsr cmd1
	sta refullErr

	; --- BAD_ID: destroy an id nothing here ever created ----------------
	lda #BAD_ID_LO
	sta ID_LO
	lda #BAD_ID_HI
	sta ID_HI
	lda #KEY
	sta ARG+ARG_KEY
	lda #OP_DESTROY_NODE
	jsr cmd1
	sta badIdErr

	; --- BAD_ARGS: SET_VISIBLE with neither 0 nor 1. id 2 is live -- it
	; was created by the fill loop and never touched since.
	lda #2
	sta ID_LO
	lda #0
	sta ID_HI
	lda #2
	sta ARG+0
	lda #OP_SET_VISIBLE
	jsr cmd1
	sta badArgs1Err

	; --- BAD_ARGS: SET_SCALE with a scale of zero -----------------------
	lda #2
	sta ID_LO
	lda #0
	sta ID_HI
	lda #0
	sta ARG+0
	sta ARG+1
	lda #OP_SET_SCALE
	jsr cmd1
	sta badArgs2Err

	jsr showAll
	jsr verdict

	lda #0
	sta CMD_HI
	rts

; ----------------------------------------------------------------------

cmd1
	ldx #1
	stx CMD_HI
	sta CMD_LO
	lda ERRCODE
	rts

verdict
	; Every field is checked; VERDICT is the whole result, so a run can be
	; read from across the room and only looked at closely when it says
	; FAIL.
	lda filled
	cmp #EXPECT_FILLED_LO
	bne vFail
	lda filled+1
	cmp #EXPECT_FILLED_HI
	bne vFail
	lda fillErr
	cmp #ERR_OUT_OF_MEM
	bne vFail
	lda replaceErr
	cmp #ERR_OK
	bne vFail
	lda noKeyErr
	cmp #ERR_BAD_ARGS
	bne vFail
	lda destroyErr
	cmp #ERR_OK
	bne vFail
	lda reclaimErr
	cmp #ERR_OK
	bne vFail
	lda refullErr
	cmp #ERR_OUT_OF_MEM
	bne vFail
	lda badIdErr
	cmp #ERR_BAD_ID
	bne vFail
	lda badArgs1Err
	cmp #ERR_BAD_ARGS
	bne vFail
	lda badArgs2Err
	cmp #ERR_BAD_ARGS
	bne vFail

	lda #<txtPass
	ldy #>txtPass
	ldx #12
	jmp printAt
vFail
	lda #<txtFail
	ldy #>txtFail
	ldx #12
	jmp printAt

showAll
	lda #2
	jsr rowAddr
	ldy #13
	lda filled+1
	jsr putHex
	lda filled
	jsr putHex

	lda #3
	jsr rowAddr
	ldy #13
	lda fillErr
	jsr putHex

	lda #4
	jsr rowAddr
	ldy #13
	lda replaceErr
	jsr putHex

	lda #5
	jsr rowAddr
	ldy #13
	lda destroyErr
	jsr putHex

	lda #6
	jsr rowAddr
	ldy #13
	lda reclaimErr
	jsr putHex

	lda #7
	jsr rowAddr
	ldy #13
	lda refullErr
	jsr putHex

	lda #8
	jsr rowAddr
	ldy #13
	lda badIdErr
	jsr putHex

	lda #9
	jsr rowAddr
	ldy #13
	lda badArgs1Err
	jsr putHex

	lda #10
	jsr rowAddr
	ldy #13
	lda badArgs2Err
	jsr putHex

	lda #11
	jsr rowAddr
	ldy #13
	lda noKeyErr
	jsr putHex
	rts

; ----------------------------------------------------------------------
; Screen output. Identical to gpu64_3d_arena_test.a's helpers.
; ----------------------------------------------------------------------

clearScreen
	ldx #0
	lda #$20
cls1
	sta SCREEN,x
	sta SCREEN+$100,x
	sta SCREEN+$200,x
	sta SCREEN+$300,x
	inx
	bne cls1
	rts

showLabels
	lda #<txtFilled
	ldy #>txtFilled
	ldx #2
	jsr printAt
	lda #<txtFillErr
	ldy #>txtFillErr
	ldx #3
	jsr printAt
	lda #<txtReplaceErr
	ldy #>txtReplaceErr
	ldx #4
	jsr printAt
	lda #<txtDestroyErr
	ldy #>txtDestroyErr
	ldx #5
	jsr printAt
	lda #<txtReclaimErr
	ldy #>txtReclaimErr
	ldx #6
	jsr printAt
	lda #<txtRefullErr
	ldy #>txtRefullErr
	ldx #7
	jsr printAt
	lda #<txtBadIdErr
	ldy #>txtBadIdErr
	ldx #8
	jsr printAt
	lda #<txtBadArgs1Err
	ldy #>txtBadArgs1Err
	ldx #9
	jsr printAt
	lda #<txtBadArgs2Err
	ldy #>txtBadArgs2Err
	ldx #10
	jsr printAt
	lda #<txtNoKeyErr
	ldy #>txtNoKeyErr
	ldx #11
	jmp printAt

printAt
	sta SRC
	sty SRC+1
	txa
	jsr rowAddr
	ldy #0
prLoop
	lda (SRC),y
	beq prDone
	cmp #$41
	bcc prPut
	cmp #$5b
	bcs prPut
	sec
	sbc #$40			; PETSCII upper case -> screen code
prPut
	sta (DST),y
	iny
	bne prLoop
prDone
	rts

rowAddr
	sta rowTmp
	lda #<SCREEN
	sta DST
	lda #>SCREEN
	sta DST+1
	ldx rowTmp
	beq rowDone
rowAdd
	clc
	lda DST
	adc #40
	sta DST
	lda DST+1
	adc #0
	sta DST+1
	dex
	bne rowAdd
rowDone
	rts

putHex
	pha
	lsr
	lsr
	lsr
	lsr
	jsr hexDigit
	sta (DST),y
	iny
	pla
	and #$0f
	jsr hexDigit
	sta (DST),y
	iny
	rts

hexDigit
	cmp #10
	bcs hexAlpha
	clc
	adc #$30
	rts
hexAlpha
	sec
	sbc #9
	rts

; ----------------------------------------------------------------------

txtTitle	.text "GPU64 3D SCENE TABLE TEST"
		.byte 0
txtFilled	.text "FILLED"
		.byte 0
txtFillErr	.text "FILL ERR"
		.byte 0
txtReplaceErr	.text "REPLACE ERR"
		.byte 0
txtDestroyErr	.text "DESTROY ERR"
		.byte 0
txtReclaimErr	.text "RECLAIM ERR"
		.byte 0
txtRefullErr	.text "REFULL ERR"
		.byte 0
txtBadIdErr	.text "BAD ID ERR"
		.byte 0
txtBadArgs1Err	.text "BAD ARG1 ERR"
		.byte 0
txtBadArgs2Err	.text "BAD ARG2 ERR"
		.byte 0
txtNoKeyErr	.text "NO KEY ERR"
		.byte 0
txtPass		.text "VERDICT PASS"
		.byte 0
txtFail		.text "VERDICT FAIL"
		.byte 0

curId		.word 0
filled		.word 0
fillErr		.byte 0
replaceErr	.byte 0
destroyErr	.byte 0
noKeyErr	.byte 0
reclaimErr	.byte 0
refullErr	.byte 0
badIdErr	.byte 0
badArgs1Err	.byte 0
badArgs2Err	.byte 0
rowTmp		.byte 0
