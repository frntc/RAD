;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- API conformance suite 4/6: the fixed-point matrix ops.
;
;      WHAT THIS TESTS
;
;      Opcodes $80-$86, whose elements are signed 16-bit 8.8 fixed point:
;      $0100 is 1.0, $FF00 is -1.0, $0080 is 0.5. Range +-127.99, resolution
;      1/256, two bytes an element, little-endian.
;
;      These are the only opcodes in class 0 that compute rather than draw,
;      and they are the ones a 3D program on the C64 side actually leans on.
;      Every operand here is a .byte table inside this program and every
;      result is compared against a value worked out by hand, so a failure
;      names the exact element that is wrong.
;
;      Three things get pinned that the drawing tests have no equivalent of:
;
;      ROUNDING. Products come back rounded half away from zero. The
;      positive and the negative side are tested separately and on purpose:
;      an implementation that shifts a negative accumulator right instead of
;      dividing it rounds the wrong way, and gets every negative product
;      wrong by one least-significant bit while every positive one stays
;      perfect. That is invisible in a rendered frame and obvious here.
;
;      SATURATION. A value past +-127.99 clamps rather than wrapping. This
;      matters more than it sounds: a saturated highlight looks like
;      clipping, and a wrapped one looks like a hardware fault.
;
;      DESTINATION DISCIPLINE. A failed dispatch does nothing -- so a
;      singular matrix must leave the destination exactly as it found it.
;      The destination is poisoned first and checked afterwards.
;
;      HOW TO READ THE RESULT
;
;      A fail code on a value test is the low byte of the element that was
;      wrong, or $E3 if that byte was zero. Since 8.8 puts the fractional
;      part in the low byte, F01 on a test expecting $FF00 means the answer
;      was one least-significant bit off -- which is the rounding failure
;      described above, not a wild result.
;
;      KNOWN FAILURES AS OF 2026-08-24
;
;      Three lines are expected to be red on current firmware, and they are
;      all the same defect:
;
;        ROUND NEG      F7F
;        MUL MINUS ONE  FFF
;        SCALE NEG      FFF
;
;      gpu64_api.cpp's fixWrite() adds a bias of +-128 and then shifts the
;      accumulator right by 8. The shift floors, so for a negative
;      accumulator the bias lands twice and the answer comes back one
;      least-significant bit further from zero than it should: -1.0 times
;      1.0 returns $FEFF, or -1.00391, instead of $FF00. Every negative
;      product is affected; no positive one is, which is why the rest of
;      this file is green.
;
;      The tests assert the documented behaviour, not the current one. If
;      these three go green, the firmware was fixed and this note is stale.
;      Anything ELSE red here is a new finding.
;
;      tools/prgsim/runsim.py --firmware-rounding reproduces exactly this
;      result on a PC, which is where the prediction above comes from.
;
;      Requires the RAD menu switched to REU mode with T.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64_testkit.inc"

MC	= $3000				; results land here
MC2	= $3200

; 8.8 constants, named so the operand tables below read as arithmetic.
F0	= $0000
F1	= $0100
F2	= $0200
F3	= $0300
F4	= $0400
FHALF	= $0080
FQTR	= $0040
FM1	= $ff00
FMHALF	= $ff80
FMQTR	= $ffc0
F100	= $6400
FM100	= $9c00
F127	= $7f00
FSATP	= $7fff
FSATN	= $8000

REU_CMD		= $df01
REU_C64LO	= $df02
REU_C64HI	= $df03
REU_EXT0	= $df04
REU_EXT1	= $df05
REU_EXT2	= $df06
REU_LENLO	= $df07
REU_LENHI	= $df08
REU_CTRL	= $df0a

* = $0801
	.byte $0b, $08, $0a, $00, $9e
	.text "2064"
	.byte $00, $00, $00

* = $0810

start
	jsr kitInit
	#title "GPU64 API TEST 4 - FIXED MATH"

; ----------------------------------------------------------------------
; MAT_IDENTITY, which everything else is checked against.
; ----------------------------------------------------------------------

	#poison MC, 32
	#argb 0, 4
	#argcd 1, SPACE_C64, MC
	lda #OP_MAT_IDENTITY
	jsr cmd0
	#wantOk
	#check "IDENTITY"

	#clracc
	#expectw MC+0, F1			; (0,0)
	#expectw MC+2, F0
	#expectw MC+10, F1			; (1,1)
	#expectw MC+20, F1			; (2,2)
	#expectw MC+30, F1			; (3,3)
	#expectw MC+6, F0			; (0,3)
	#expectw MC+24, F0			; (3,0)
	#useacc
	#check "IDENT EXACT"

; ----------------------------------------------------------------------
; MAT_MUL. A vector is just a matrix with one column, so transforming a
; 4-vector is m=4 k=4 n=1 -- which is the call a 3D program makes most.
; ----------------------------------------------------------------------

	#poison MC2, 8
	#argb 0, 4				; m
	#argb 1, 4				; k
	#argb 2, 1				; n
	#argcd 3, SPACE_C64, MC			; A = the identity just built
	#argcd 7, SPACE_C64, vec4
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#wantOk
	#check "MUL VECTOR"

	; Identity times a vector is the vector, unchanged.
	#setptr P1, vec4
	#setptr P2, MC2
	#setlen 8
	jsr kitCmp
	#check "MUL IDENTITY"

	; A 2x2 product worked out by hand. Every term is positive so this
	; test says nothing about rounding -- that is isolated below, on
	; purpose, so one defect turns one line red instead of half the file.
	#poison MC2, 8
	#argb 0, 2
	#argb 1, 2
	#argb 2, 2
	#argcd 3, SPACE_C64, mulA
	#argcd 7, SPACE_C64, mulB
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#clracc
	#expectw MC2+0, $0240			; 2*1 + 0.5*0.5 = 2.25
	#expectw MC2+2, F4			; 2*2 + 0.5*0   = 4.0
	#expectw MC2+4, $0120			; 1*1 + 0.25*0.5 = 1.125
	#expectw MC2+6, F2			; 1*2 + 0.25*0  = 2.0
	#useacc
	#check "MUL 2X2"

; ----------------------------------------------------------------------
; Rounding, both signs. See the header -- these two lines are the whole
; reason the products above were kept positive.
; ----------------------------------------------------------------------

	#poison MC2, 4
	#argb 0, 1
	#argb 1, 1
	#argb 2, 2
	#argcd 3, SPACE_C64, rowPos
	#argcd 7, SPACE_C64, rowHalf
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#clracc
	#expectw MC2+0, FHALF			; 1.0 * 0.5 = 0.5
	#expectw MC2+2, FQTR			; 1.0 * 0.25 = 0.25
	#useacc
	#check "ROUND POS"

	#poison MC2, 4
	#argb 0, 1
	#argb 1, 1
	#argb 2, 2
	#argcd 3, SPACE_C64, rowNeg
	#argcd 7, SPACE_C64, rowHalf
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#clracc
	#expectw MC2+0, FMHALF			; -1.0 * 0.5  = -0.5
	#expectw MC2+2, FMQTR			; -1.0 * 0.25 = -0.25
	#useacc
	#check "ROUND NEG"

	; The cleanest statement of the same thing: -1.0 times 1.0 is -1.0.
	#poison MC2, 2
	#argb 0, 1
	#argb 1, 1
	#argb 2, 1
	#argcd 3, SPACE_C64, rowNeg
	#argcd 7, SPACE_C64, rowPos
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#clracc
	#expectw MC2+0, FM1
	#useacc
	#check "MUL MINUS ONE"

; ----------------------------------------------------------------------
; Saturation, both ways.
; ----------------------------------------------------------------------

	#poison MC2, 2
	#argb 0, 1
	#argb 1, 1
	#argb 2, 1
	#argcd 3, SPACE_C64, row100
	#argcd 7, SPACE_C64, rowTwo
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#clracc
	#expectw MC2+0, FSATP			; 200.0 clamps, does not wrap
	#useacc
	#check "SAT POS"

	#poison MC2, 2
	#argb 0, 1
	#argb 1, 1
	#argb 2, 1
	#argcd 3, SPACE_C64, rowM100
	#argcd 7, SPACE_C64, rowTwo
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#clracc
	#expectw MC2+0, FSATN
	#useacc
	#check "SAT NEG"

; ----------------------------------------------------------------------
; MAT_ADD and MAT_SUB.
; ----------------------------------------------------------------------

	#poison MC2, 4
	#argb 0, 1
	#argb 1, 2
	#argcd 2, SPACE_C64, addA
	#argcd 6, SPACE_C64, addB
	#argcd 10, SPACE_C64, MC2
	lda #OP_MAT_ADD
	jsr cmd0
	#clracc
	#expectw MC2+0, $0180			; 1.0 + 0.5 = 1.5
	#expectw MC2+2, F1			; 2.0 + -1.0 = 1.0
	#useacc
	#check "ADD"

	#poison MC2, 4
	#argb 0, 1
	#argb 1, 2
	#argcd 2, SPACE_C64, addA
	#argcd 6, SPACE_C64, addB
	#argcd 10, SPACE_C64, MC2
	lda #OP_MAT_SUB
	jsr cmd0
	#clracc
	#expectw MC2+0, FHALF			; 1.0 - 0.5 = 0.5
	#expectw MC2+2, F3			; 2.0 - -1.0 = 3.0
	#useacc
	#check "SUB"

	; An addition that overflows the format clamps as well -- the sum path
	; has its own saturation and it is not the product path's.
	#poison MC2, 4
	#argb 0, 1
	#argb 1, 2
	#argcd 2, SPACE_C64, satA
	#argcd 6, SPACE_C64, satA
	#argcd 10, SPACE_C64, MC2
	lda #OP_MAT_ADD
	jsr cmd0
	#clracc
	#expectw MC2+0, FSATP			; 127.0 + 127.0
	#expectw MC2+2, FSATN			; -127.0 + -127.0
	#useacc
	#check "ADD SATURATES"

; ----------------------------------------------------------------------
; MAT_SCALE. The scalar is inline in the argument block, not behind a
; descriptor -- ARG10-11 for the 8.8 set.
; ----------------------------------------------------------------------

	#poison MC2, 4
	#argb 0, 1
	#argb 1, 2
	#argcd 2, SPACE_C64, scaleA
	#argcd 6, SPACE_C64, MC2
	#argw 10, F2
	lda #OP_MAT_SCALE
	jsr cmd0
	#clracc
	#expectw MC2+0, F2			; 1.0 * 2.0
	#expectw MC2+2, F1			; 0.5 * 2.0
	#useacc
	#check "SCALE"

	#poison MC2, 2
	#argb 0, 1
	#argb 1, 1
	#argcd 2, SPACE_C64, rowNeg
	#argcd 6, SPACE_C64, MC2
	#argw 10, F2
	lda #OP_MAT_SCALE
	jsr cmd0
	#clracc
	#expectw MC2+0, $fe00			; -1.0 * 2.0 = -2.0
	#useacc
	#check "SCALE NEG"

; ----------------------------------------------------------------------
; MAT_TRANSPOSE. A 2x3 becomes a 3x2, so this also proves the result's
; dimensions are taken the right way round.
; ----------------------------------------------------------------------

	#poison MC2, 12
	#argb 0, 2
	#argb 1, 3
	#argcd 2, SPACE_C64, trA
	#argcd 6, SPACE_C64, MC2
	lda #OP_MAT_TRANSPOSE
	jsr cmd0
	#clracc
	#expectw MC2+0, F1			; (0,0)
	#expectw MC2+2, F4			; (0,1) was (1,0)
	#expectw MC2+4, F2			; (1,0) was (0,1)
	#expectw MC2+6, $0500
	#expectw MC2+8, F3
	#expectw MC2+10, $0600
	#useacc
	#check "TRANSPOSE"

; ----------------------------------------------------------------------
; MAT_INVERSE. The elimination runs in double precision whatever the
; element format is, so an 8.8 operand keeps its precision through it.
; ----------------------------------------------------------------------

	#poison MC2, 8
	#argb 0, 2
	#argcd 1, SPACE_C64, invA
	#argcd 5, SPACE_C64, MC2
	lda #OP_MAT_INVERSE
	jsr cmd0
	#wantOk
	#check "INVERSE"

	#clracc
	#expectw MC2+0, FHALF			; 1/2
	#expectw MC2+2, F0
	#expectw MC2+4, F0
	#expectw MC2+6, FQTR			; 1/4
	#useacc
	#check "INVERSE EXACT"

	; A matrix with no inverse. The rule under test is not just the error
	; code -- it is that a failed dispatch does nothing, so the poison must
	; still be there afterwards.
	#poison MC2, 8
	#argb 0, 2
	#argcd 1, SPACE_C64, singA
	#argcd 5, SPACE_C64, MC2
	lda #OP_MAT_INVERSE
	jsr cmd0
	#wantErr ERR_SINGULAR
	#check "SINGULAR"

	#setptr P1, MC2
	#setlen 8
	lda #$aa
	sta kitVal
	jsr kitChkFill
	#check "SINGULAR KEPT"

	; n is capped at 64 for the inverse; 65 is BAD_ARGS, not a hang.
	#argb 0, 65
	#argcd 1, SPACE_C64, invA
	#argcd 5, SPACE_C64, MC2
	lda #OP_MAT_INVERSE
	jsr cmd0
	#wantErr ERR_BAD_ARGS
	#check "INVERSE N65"

; ----------------------------------------------------------------------
; Argument validation.
; ----------------------------------------------------------------------

	#argb 0, 0
	#argb 1, 2
	#argb 2, 2
	#argcd 3, SPACE_C64, mulA
	#argcd 7, SPACE_C64, mulB
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#wantErr ERR_BAD_ARGS
	#check "MUL M0"

	#argb 0, 2
	#argb 1, 0
	#argb 2, 2
	#argcd 3, SPACE_C64, mulA
	#argcd 7, SPACE_C64, mulB
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#wantErr ERR_BAD_ARGS
	#check "MUL K0"

	#argb 0, 1
	#argb 1, 0
	#argcd 2, SPACE_C64, addA
	#argcd 6, SPACE_C64, addB
	#argcd 10, SPACE_C64, MC2
	lda #OP_MAT_ADD
	jsr cmd0
	#wantErr ERR_BAD_ARGS
	#check "ADD N0"

	#argb 0, 0
	#argcd 1, SPACE_C64, MC2
	lda #OP_MAT_IDENTITY
	jsr cmd0
	#wantErr ERR_BAD_ARGS
	#check "IDENTITY N0"

	; A result that would not fit a blob at all: 255 x 255 x 2 bytes.
	#argb 0, 255
	#argcd 1, SPACE_C64, MC2
	lda #OP_MAT_IDENTITY
	jsr cmd0
	#wantErr ERR_OUT_OF_RANGE
	#check "RESULT TOOBIG"

	; A result that fits a blob but not the space it was pointed at. The
	; compact descriptor has no len, so the bounds are checked against the
	; byte count the dimensions imply -- exactly as if it had been written
	; out.
	#argb 0, 16
	#argcd 1, SPACE_C64, $ff00
	lda #OP_MAT_IDENTITY
	jsr cmd0
	#wantErr ERR_OUT_OF_RANGE
	#check "RESULT OVERRUN"

	#argb 0, 2
	#argb 1, 2
	#argb 2, 2
	#argcd 3, 4, mulA
	#argcd 7, SPACE_C64, mulB
	#argcd 11, SPACE_C64, MC2
	lda #OP_MAT_MUL
	jsr cmd0
	#wantErr ERR_OUT_OF_RANGE
	#check "MUL BAD SPACE"

; ----------------------------------------------------------------------
; Operands in different spaces: compute from REU, write back to C64 RAM.
; ----------------------------------------------------------------------

	jsr stashScale
	#poison MC2, 4
	#argb 0, 1
	#argb 1, 2
	#argcd 2, SPACE_REU, 0
	#argcd 6, SPACE_C64, MC2
	#argw 10, F2
	lda #OP_MAT_SCALE
	jsr cmd0
	#wantOk
	#check "REU OPERAND"

	#clracc
	#expectw MC2+0, F2
	#expectw MC2+2, F1
	#useacc
	#check "REU EXACT"

	jmp kitFinish

; ----------------------------------------------------------------------

stashScale
	lda #0
	sta REU_CTRL
	lda #<scaleA
	sta REU_C64LO
	lda #>scaleA
	sta REU_C64HI
	lda #0
	sta REU_EXT0
	sta REU_EXT1
	sta REU_EXT2
	lda #4
	sta REU_LENLO
	lda #0
	sta REU_LENHI
	lda #$90
	sta REU_CMD
	rts

; ----------------------------------------------------------------------
; Operands. Row-major, little-endian, two bytes an element.
; ----------------------------------------------------------------------

vec4	.word F1, F2, F3, F4

mulA	.word F2, FHALF				; [ 2.0  0.5 ]
	.word F1, FQTR				; [ 1.0  0.25]
mulB	.word F1, F2				; [ 1.0  2.0 ]
	.word FHALF, F0				; [ 0.5  0.0 ]

rowPos	.word F1
rowNeg	.word FM1
rowTwo	.word F2
row100	.word F100
rowM100	.word FM100
rowHalf	.word FHALF, FQTR

addA	.word F1, F2
addB	.word FHALF, FM1
satA	.word F127, $8100			; 127.0 and -127.0
scaleA	.word F1, FHALF

trA	.word F1, F2, F3			; [ 1 2 3 ]
	.word F4, $0500, $0600			; [ 4 5 6 ]

invA	.word F2, F0				; [ 2  0 ]
	.word F0, F4				; [ 0  4 ]
singA	.word F1, F2				; [ 1  2 ]
	.word F2, F4				; [ 2  4 ] -- twice the first row

	.include "gpu64_testkit_rt.inc"
