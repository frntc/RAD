;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- milestone 2 test PRG: writes one byte to the gpu64 trigger
;      register to kick off CRAD's showTestPattern() checkerboard pattern.
;
;      gpu64 uses the unused remainder of REU's IO2 window, $DF50-$DFFF, so
;      it coexists with REU emulation (RAD's own, or a real 1750-compatible
;      REU / the Ultimate's) which only ever decodes $DF00-$DF0A -- see
;      dev/project_description.md's "IO address space allocation" section.
;      No data payload yet, just a single STA to arm the trigger register.
;
;      Assemble with 64tass (matches Source/Firmware/C64Side's convention) --
;      64tass gpu64_trigger_pattern.a -o gpu64_trigger_pattern.prg
;      then LOAD and RUN it from the RAD menu or a real drive.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

GPU64_TRIGGER = $df50		; gpu64's trigger register (see rad_reu.cpp)

	* = $0801			; standard BASIC load address

	; minimal "10 SYS 2061" BASIC stub so RUN launches the code below
	.word next_line
	.word 10
	.byte $9e			; SYS token
	.text "2061"
	.byte 0
next_line
	.word 0				; end of BASIC program (next line link = 0)

	* = $080d			; = 2061, matches the SYS target above

start
	sei
	lda #1
	sta GPU64_TRIGGER		; any value triggers the test pattern
	cli
	rts
