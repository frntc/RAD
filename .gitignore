# Circle SDK checkout + build output, fetched/rebuilt by tools/build.sh
/external/

# generated per-build by tools/build.sh (stamped into the boot log)
/Source/Firmware/build_id.h

# gpu64 host sim: build products and rendered output
tools/hostsim/hostsim
tools/hostsim/scenesim
tools/hostsim/levelsim
tools/hostsim/hulltest
tools/hostsim/libclipmove.so
tools/hostsim/out/

# gpu64 rastercheck: build product and scratch scenario
tools/rastercheck/rastercheck
tools/rastercheck/out/
tools/rastercheck/.scenario.bin
__pycache__/

# reference copy of shareware Quake, not part of the project
/games/quake/ID1/

# sim output written into the repo root
/*.ppm

# converted levels, rebuilt from PAK0.PAK by tools/gen_quakelevel.py
/build/

# Quake sounds extracted from PAK0.PAK for auditioning, not part of the project
/loops/

# 64tass listings (-L), rebuilt with the PRG
*.lst

# Unfinished, not part of the public tree
/million/
# built programs and data: `make examples` / `make games` rebuild them
*.prg
/games/*/*.reu
/games/*/gpu64_tune.bin
/examples/out/
/tests/out/
/out/
/.claude/

# Firmware and board design live outside this repo (see README)
/Source/
/Gerber/
/Images/
