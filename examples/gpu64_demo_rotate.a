;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 demo 5 of 7 -- ROTATE: the matrix ops doing real work.
;
;      gpu64 will do linear algebra for the C64 at ARM speed. This demo
;      uses it for the obvious thing: a shape is stored once, and every
;      frame it is scaled and rotated by gpu64 and drawn from the result.
;      The 6502 does no multiplication at all.
;
;      Per frame, two commands:
;
;        MAT_SCALE ($83)  S = base * s      2x12, one scalar
;        MAT_MUL   ($80)  P = R  ·  S       (2x2) · (2x12)
;
;      and then twelve LINEs. Note the shapes. A vector is just a matrix
;      with one row or one column, so a batch of twelve vertices is one
;      MAT_MUL with n = 12, not twelve calls -- and n is a byte, so up to
;      255 vertices go in a single dispatch.
;
;      HOW THE NUMBERS WORK
;
;      Elements are signed 16-bit 8.8 fixed point, little-endian: $0100 is
;      1.0, $FF00 is -1.0, $0080 is 0.5. That gives a range of +-127.99 and
;      a resolution of 1/256, which is why the shape is about 60 units
;      across and not 160 -- the whole scene has to fit in +-128. Products
;      accumulate at full width and come back rounded half away from zero
;      and SATURATED, so a value that runs past the range clamps instead of
;      wrapping into a nonsense coordinate.
;
;      Turning a result into a screen coordinate is then free: the high
;      byte of an 8.8 element IS its integer part, so the drawing code just
;      adds the centre of the screen to it.
;
;      WHERE THE RESULT COMES BACK
;
;      Nowhere near the register window. Math opcodes take a 4-byte COMPACT
;      DESCRIPTOR for each operand -- space and a 24-bit address, with no
;      length, because the dimensions and the element size already say how
;      long it is -- and the destination is one of them. The result is in
;      your own RAM by the time the write to CMD_LO returns.
;
;      One thing this demo deliberately does NOT do: rotate the shape by
;      multiplying it by the same small rotation every frame. That
;      accumulates rounding, and in 8.8 the shape would visibly shrink and
;      wander within a minute. Each frame instead rotates the ORIGINAL by
;      the angle it wants, straight out of a table. The same rule applies
;      to float32 ($90-$96), just further out.
;
;      Run it: LOAD"GPU64-ROTATE",8,1 then RUN. RUN/STOP finishes.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64.inc"

NVERT   = 12
CENTREX = 160
CENTREY = 100

; The three matrices, in C64 RAM. gpu64 reads and writes them by address --
; nothing about them is special to gpu64, they are just bytes.
ROT     = $c000			; R, 2x2   = 8 bytes
SCALED  = $c010			; S, 2x12  = 48 bytes
POINTS  = $c050			; P, 2x12  = 48 bytes

	#basicStub

start
	jsr dmInit

	#argb 0, BLACK
	#cmd OP_SET_BORDER
	#argb 0, 1
	#cmd OP_SET_DRAW_PAGE
	#argb 0, BLACK
	#cmd OP_CLEAR
	#argb 0, 0
	#cmd OP_PAGE_FLIP
	#argb 0, BLACK
	#cmd OP_CLEAR

	lda #1
	jsr dmRow
	jsr dmText
	.text "GPU64 ROTATE"
	.byte 0
	lda #3
	jsr dmRow
	jsr dmText
	.text "TWO MATRIX OPS AND 12 LINES PER"
	.byte 0
	lda #4
	jsr dmRow
	jsr dmText
	.text "FRAME. THE 6502 MULTIPLIES NOTHING."
	.byte 0
	lda #6
	jsr dmRow
	jsr dmText
	.text "RUN/STOP TO FINISH."
	.byte 0

frame
	jsr dmVbWait

	jsr buildRot			; R from the angle tables
	jsr scaleShape			; S = base * scaleTab[angle]
	jsr rotate			; P = R . S

	#argb 0, BLACK
	#cmd OP_CLEAR
	jsr drawShape
	jsr dmFlip

	; One step round the circle per frame; the tables are 32 long, and
	; the scale table is walked at half the speed so the two motions do
	; not lock together.
	inc angle
	lda angle
	and #31
	sta angle
	inc halfTick
	lda halfTick
	and #1
	bne noScaleStep
	inc scaleIdx
	lda scaleIdx
	and #31
	sta scaleIdx
noScaleStep

	jsr dmStop
	bne frame

	#argb 0, 0
	#cmd OP_SET_DRAW_PAGE
	lda #8
	jsr dmRow
	jsr dmText
	.text "LAST ERRCODE "
	.byte 0
	jsr dmErr
	jmp dmHold

; ----------------------------------------------------------------------
; R = [ cos -sin ; sin cos ], row-major, straight into C64 RAM. gpu64 will
; read it from there when MAT_MUL runs.
; ----------------------------------------------------------------------
buildRot
	lda angle
	asl a				; word index
	tax
	lda cosTab,x
	sta ROT+0
	lda cosTab+1,x
	sta ROT+1			; R[0][0] = cos

	sec				; R[0][1] = -sin
	lda #0
	sbc sinTab,x
	sta ROT+2
	lda #0
	sbc sinTab+1,x
	sta ROT+3

	lda sinTab,x
	sta ROT+4
	lda sinTab+1,x
	sta ROT+5			; R[1][0] = sin

	lda cosTab,x
	sta ROT+6
	lda cosTab+1,x
	sta ROT+7			; R[1][1] = cos
	rts

; ----------------------------------------------------------------------
; S = base * s. MAT_SCALE takes the scalar inline in the argument block --
; 2 bytes for 8.8, 4 for float32 -- because a single number does not
; deserve a descriptor.
; ----------------------------------------------------------------------
scaleShape
	#argb 0, 2			; m = 2 rows
	#argb 1, NVERT			; n = 12 columns
	#argcd 2, SPACE_C64, baseShape	; A
	#argcd 6, SPACE_C64, SCALED	; C
	lda scaleIdx
	asl a
	tax
	lda scaleTab,x
	sta ARG+10
	lda scaleTab+1,x
	sta ARG+11			; the scalar, 8.8
	#cmd OP_MAT_SCALE
	rts

; ----------------------------------------------------------------------
; P = R . S -- (2x2) . (2x12), so m = 2, k = 2, n = 12.
; ----------------------------------------------------------------------
rotate
	#argb 0, 2			; m
	#argb 1, 2			; k
	#argb 2, NVERT			; n
	#argcd 3, SPACE_C64, ROT	; A
	#argcd 7, SPACE_C64, SCALED	; B
	#argcd 11, SPACE_C64, POINTS	; C
	#cmd OP_MAT_MUL
	rts

; ----------------------------------------------------------------------
; Draw the twelve transformed points as a closed outline.
;
; POINTS is 2 x 12 row-major: the twelve x elements, then the twelve y
; elements. The high byte of an 8.8 element is its integer part, so the
; screen coordinate is CENTRE + that byte, sign extended.
; ----------------------------------------------------------------------
drawShape
	lda #0
	sta vi
lineLoop
	lda vi
	jsr vertexToArg0		; this vertex -> x0,y0
	lda vi
	clc
	adc #1
	cmp #NVERT
	bcc +
	lda #0				; wrap: the last line closes the shape
+
	jsr vertexToArg4		; next vertex -> x1,y1
	lda vi
	and #3
	tax
	lda lineCol,x
	sta ARG+8
	#cmd OP_LINE
	inc vi
	lda vi
	cmp #NVERT
	bne lineLoop
	rts

; A = vertex number. Leaves its screen x,y in ARG0-3.
vertexToArg0
	jsr vertexScreen
	lda sx
	sta ARG+0
	lda sx+1
	sta ARG+1
	lda sy
	sta ARG+2
	lda sy+1
	sta ARG+3
	rts

; The same, in ARG4-7.
vertexToArg4
	jsr vertexScreen
	lda sx
	sta ARG+4
	lda sx+1
	sta ARG+5
	lda sy
	sta ARG+6
	lda sy+1
	sta ARG+7
	rts

; A = vertex number -> sx, sy as 16-bit screen coordinates.
vertexScreen
	asl a				; two bytes per element
	tax
	lda POINTS+1,x			; integer part of x
	jsr addCentreX
	lda POINTS+1+2*NVERT,x		; integer part of y -- the second row
	jmp addCentreY

; A = a signed byte offset from the centre.
addCentreX
	tay				; keep the sign
	clc
	adc #<CENTREX
	sta sx
	lda #>CENTREX
	adc #0
	sta sx+1
	tya
	bpl +
	dec sx+1			; sign extend: the offset was negative
+
	rts

addCentreY
	tay
	clc
	adc #<CENTREY
	sta sy
	lda #>CENTREY
	adc #0
	sta sy+1
	tya
	bpl +
	dec sy+1
+
	rts

; ----------------------------------------------------------------------
angle	.byte 0
scaleIdx .byte 0
halfTick .byte 0
vi	.byte 0
sx	.word 0
sy	.word 0

lineCol	.byte WHITE, LTBLUE, CYAN, LTGREEN

; the shape, as a 2 x 12 matrix in 8.8: all the x elements, then all the y
; elements -- row-major, which for a two-row matrix means exactly that.
baseShape
	.word $3e00, $1684, $1f00, $0000, $e100, $e97c
	.word $c200, $e97c, $e100, $0000, $1f00, $1684
	.word $0000, $0d00, $35b2, $1a00, $35b2, $0d00
	.word $0000, $f300, $ca4e, $e600, $ca4e, $f300

; cos and sin of 32 angles around the circle, 8.8. $0100 is 1.0.
cosTab
	.word $0100, $00fb, $00ed, $00d5, $00b5, $008e
	.word $0062, $0032, $0000, $ffce, $ff9e, $ff72
	.word $ff4b, $ff2b, $ff13, $ff05, $ff00, $ff05
	.word $ff13, $ff2b, $ff4b, $ff72, $ff9e, $ffce
	.word $0000, $0032, $0062, $008e, $00b5, $00d5
	.word $00ed, $00fb

sinTab
	.word $0000, $0032, $0062, $008e, $00b5, $00d5
	.word $00ed, $00fb, $0100, $00fb, $00ed, $00d5
	.word $00b5, $008e, $0062, $0032, $0000, $ffce
	.word $ff9e, $ff72, $ff4b, $ff2b, $ff13, $ff05
	.word $ff00, $ff05, $ff13, $ff2b, $ff4b, $ff72
	.word $ff9e, $ffce

; a scale factor that breathes between about 0.56 and 1.0.
scaleTab
	.word $00c8, $00d3, $00dd, $00e7, $00f0, $00f7
	.word $00fc, $00ff, $0100, $00ff, $00fc, $00f7
	.word $00f0, $00e7, $00dd, $00d3, $00c8, $00bd
	.word $00b2, $00a8, $00a0, $0099, $0094, $0090
	.word $008f, $0090, $0094, $0099, $00a0, $00a8
	.word $00b2, $00bd

	.include "gpu64_rt.inc"
