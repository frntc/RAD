;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- DRAW_WALLS: a textured level the C64 does not project.
;
;      WHAT THIS DEMONSTRATES
;
;      gpu64_demo_raycast draws the same kind of picture the way a C64 has
;      always had to: march forty rays through a map, work out a wall height
;      for each, expand that into 320 column records, and hand five kilobytes
;      across the bus. Every frame. All of it on a 1 MHz 6502.
;
;      This program draws a bigger level, textured the same way, and the
;      6502's entire contribution to a frame is:
;
;        * add a step to two 16-bit numbers            (the player walks)
;        * look up one byte of the map                 (does he bump a wall)
;        * write ten bytes of camera into the ARG window
;        * fire two commands
;
;      There is no raycaster in this program. There is no per-column
;      anything in this program. The level is 162 wall segments in WORLD
;      coordinates, built by the assembler, uploaded nowhere and never
;      rewritten -- gpu64 fetches the same unchanged bytes every frame and
;      does the projection, the perspective texture mapping, the distance
;      lighting and the depth sorting itself.
;
;      That last one is worth saying plainly: the walls are in map order,
;      not in depth order. DRAW_WALLS depth-tests every column against a
;      1/z buffer it clears itself, so a C64 never has to sort anything.
;      Doom needed a BSP tree to avoid exactly that sort.
;
;      WHAT IT COSTS
;
;      One SET_CAMERA (ten bytes of argument) and one DRAW_WALLS (2592
;      bytes fetched by gpu64 over DMA, the same bytes as last frame). The
;      floor and the ceiling come free with the walls: SET_CAMERA's PAINT
;      flag has each wall column fill its own sky and its own floor, so
;      there is no second batch for them and no DRAW_SPANS at all.
;
;      Because the level never changes, its checksum never changes either.
;      It is computed once at start-up and sent with R2_BATCH_SUM set on
;      every frame, so all 2592 bytes are verified on arrival for the price
;      of two bytes -- which is the answer to rule 3 in CLAUDE.md, and one
;      a program that rebuilt its batch every frame could not afford.
;
;      WHAT IS NOT HERE
;
;      Walls are full height and the floor is flat: one room height for the
;      whole level, which is what SET_CAMERA's ceiling field means. Doom's
;      varying floor and ceiling heights, its two-sided walls and its
;      windows are not in this opcode yet.
;
;      Run it: LOAD"GPU64-WALLS",8,1 then RUN. RUN/STOP finishes.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64.inc"

VIEW_H	= 160			; the 3D view; the status bar is below it
TEXW	= 32
TEXH	= 32			; a power of two: gpu64 masks v with h-1
TEXLEN	= TEXW * TEXH

TEX_BRICK = 1
TEX_STONE = 2
TEX_GUN	  = 3

CMAP_LEVELS = 16

MAPW	= 16			; the level is 16x16 cells, 1 world unit each
MAPH	= 16

; The camera, in 8.8 world units. Eye half a unit up in a room one unit
; tall, projecting 160 pixels across a 320-wide view -- a 90 degree field of
; view, the same as the raycast demo's.
EYE_H	= $0080
CEIL_H	= $0100
PROJ	= $a000

START_X	= $0280			; cell 2.5, 1.5 -- open floor, facing +x
START_Y	= $0180
SPEED	= 0.05			; world units per frame

; Zero page. $f7-$fe is the RS232 area every gpu64 program uses.
posX	= $f7			; the player, 8.8 world units
posY	= $f9
sumPtr	= $fb			; only used at start-up, before the kit prints

	#basicStub

; ======================================================================
; Start-up
; ======================================================================
start
	jsr dmInit

	#argb 0, BLACK
	#cmd OP_SET_BORDER
	#argb 0, BLACK
	#cmd OP_CLEAR

	; The palette: 8 hues x 32 brightnesses, so a colormap can darken by
	; walking down a hue. PAL_LOAD's count is a byte, so 256 entries take
	; two calls.
	#argblob 0, SPACE_C64, palData, 128*3
	#argb 6, 0
	#argb 7, 128
	#cmd OP_PAL_LOAD
	#argblob 0, SPACE_C64, palData+128*3, 128*3
	#argb 6, 128
	#argb 7, 128
	#cmd OP_PAL_LOAD

	lda #2
	sta CMD_HI
	#cmd R2_RESET

	#argw 0, 0
	#argw 2, 0
	#argw 4, FB_W
	#argw 6, VIEW_H
	#cmd R2_SET_VIEW

	; Two wall textures and the weapon, column-major: texel(u,v) at
	; u*h+v, which is the order a wall column reads them in.
	#argblob 0, SPACE_C64, brickTex, TEXLEN
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #TEX_BRICK
	sta ID_LO
	lda #0
	sta ID_HI
	#cmd R2_UPLOAD_TEX

	#argblob 0, SPACE_C64, stoneTex, TEXLEN
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #TEX_STONE
	sta ID_LO
	#cmd R2_UPLOAD_TEX

	#argblob 0, SPACE_C64, gunTex, TEXLEN
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #TEX_GUN
	sta ID_LO
	#cmd R2_UPLOAD_TEX

	; 16 light levels. A wall record carries a base level and DRAW_WALLS
	; adds half its distance to it, so the far end of a corridor darkens
	; without the C64 computing anything.
	#argblob 0, SPACE_C64, cmapData, CMAP_LEVELS*256
	#argb 6, CMAP_LEVELS
	#cmd R2_SET_COLORMAP

	jsr sumWalls

	; The player starts in the open corner at the top left, facing along
	; +x down the long empty row.
	lda #<START_X
	sta posX
	lda #>START_X
	sta posX+1
	lda #<START_Y
	sta posY
	lda #>START_Y
	sta posY+1

; ======================================================================
; A frame
; ======================================================================
frame
	; 1. Where the player is. This is the whole of the per-frame geometry:
	;    five bytes that change, five that never do. Written out rather
	;    than through #r2cam because the position comes from variables.
	lda posX
	sta ARG+0
	lda posX+1
	sta ARG+1
	lda posY
	sta ARG+2
	lda posY+1
	sta ARG+3
	lda plAng
	sta ARG+4
	#argb 5, R2_CAM_PAINT
	#argw 6, EYE_H
	#argw 8, CEIL_H
	#argw 10, PROJ
	#argb 12, 4*32+10		; floor: a mid green-grey
	#argb 13, 6*32+6		; ceiling: a dark blue
	#argb 14, 0			; horizon at the centre of the view
	#cmd2 R2_SET_CAMERA

	; 2. The level. The same bytes as last frame, checksummed once at
	;    start-up, verified by gpu64 on every one.
	#r2batch walls, NWALLS, R2_BATCH_SUM
	#cmd2 R2_DRAW_WALLS
	lda ERRCODE
	beq +
	sta lastErr
	inc errCnt
	bne +
	inc errCnt+1
+

	; 3. What gpu64 made of it.
	#argblob 0, SPACE_C64, statBuf, 16
	#cmd2 R2_STATS

	; 4. The weapon, index 0 keyed out, bobbing with the walk.
	lda bob
	lsr a
	lsr a
	and #$03
	clc
	adc #64
	sta sprY
	#argw 0, 112
	lda sprY
	sta ARG+2
	lda #0
	sta ARG+3
	#argw 4, 96
	#argw 6, 96
	#argb 8, 1
	#argb 9, 0
	#argw 10, 0
	#argw 12, VIEW_H-1
	#argb 14, R2_SPR_MASKED
	lda #TEX_GUN
	sta ID_LO
	lda #0
	sta ID_HI
	#cmd2 R2_DRAW_SPRITE

	jsr statusBar

	jsr dmFlip
	jsr dmVbWait
	jsr report
	jsr movePlayer

	jsr dmStop
	beq frDone
	jmp frame
frDone
	lda #0
	sta CMD_HI
	jsr dmHold
	rts

; ======================================================================
; The player
;
; Walk forward along the current heading; if the cell ahead is solid, turn
; right until it is not. Two table lookups and two 16-bit adds -- which,
; next to gpu64_demo_raycast's castRays, is the point of the whole program.
; ======================================================================

movePlayer
	inc bob

	ldx plAng
	clc
	lda posX
	adc stepXLo,x
	sta tryX
	lda posX+1
	adc stepXHi,x
	sta tryX+1
	clc
	lda posY
	adc stepYLo,x
	sta tryY
	lda posY+1
	adc stepYHi,x
	sta tryY+1

	; The cell the step would put him in. One byte of map, no arithmetic
	; past a shift: the map is 16 wide, so the index is the two high
	; bytes packed.
	lda tryY+1
	and #$0f
	asl a
	asl a
	asl a
	asl a
	sta tmp
	lda tryX+1
	and #$0f
	ora tmp
	tax
	lda mapData,x
	bne mpBlocked

	lda tryX
	sta posX
	lda tryX+1
	sta posX+1
	lda tryY
	sta posY
	lda tryY+1
	sta posY+1

	; A slow drift, so the walk is not a straight line down one corridor.
	lda bob
	and #$1f
	bne mpDone
	inc plAng
	rts

mpBlocked
	; Turn rather than stop. Four steps a frame is a brisk turn but the
	; wall is right there.
	clc
	lda plAng
	adc #4
	sta plAng
mpDone
	rts

; ======================================================================
; The status bar and the numbers on it
; ======================================================================

statusBar
	lda #0
	sta CMD_HI
	#argw 0, 0
	#argw 2, VIEW_H
	#argw 4, FB_W
	#argw 6, FB_H-VIEW_H
	#argb 8, 0*32+8
	#cmd OP_RECT_FILL
	rts

report
	lda #22
	jsr dmRow
	jsr dmText
	.text "GPU64 WALLS  ACC "
	.byte 0
	lda statBuf+3
	jsr dmHexA
	lda statBuf+2
	jsr dmHexA
	jsr dmText
	.text "  REJ "
	.byte 0
	lda statBuf+5
	jsr dmHexA
	lda statBuf+4
	jsr dmHexA

	; ACC and REJ are one frame's snapshot and cannot be read off a
	; moving screen; ERRS and LAST only ever go up.
	lda #23
	jsr dmRow
	jsr dmText
	.text "162 WALLS SENT   ERRS "
	.byte 0
	lda errCnt+1
	jsr dmHexA
	lda errCnt
	jsr dmHexA
	jsr dmText
	.text " "
	.byte 0
	lda lastErr
	jsr dmHexA

	lda #24
	jsr dmRow
	jsr dmText
	.text "RUN/STOP TO END   ERR "
	.byte 0
	jsr dmErr
	rts

; ======================================================================
; The level's checksum, computed once because the level never changes.
; ======================================================================

sumWalls
	lda #<walls
	sta sumPtr
	lda #>walls
	sta sumPtr+1
	lda #0
	sta tmp
	sta tmp+1
	ldy #0
	ldx #>(NWALLS*R2_REC)		; whole pages first
	beq swTail
swPage
	clc
	lda tmp
	adc (sumPtr),y
	sta tmp
	bcc +
	inc tmp+1
+
	iny
	bne swPage
	inc sumPtr+1
	dex
	bne swPage
swTail
	cpy #<(NWALLS*R2_REC)
	beq swDone
	clc
	lda tmp
	adc (sumPtr),y
	sta tmp
	bcc +
	inc tmp+1
+
	iny
	bne swTail
swDone
	lda tmp
	sta walls+NWALLS*R2_REC
	lda tmp+1
	sta walls+NWALLS*R2_REC+1
	rts

	.include "gpu64_rt.inc"

; ======================================================================
; Variables
; ======================================================================
plAng	.byte 0
tryX	.word 0
tryY	.word 0
tmp	.word 0
bob	.byte 0
sprY	.byte 0
errCnt	.word 0
lastErr	.byte 0
statBuf	.fill 16, 0

; ======================================================================
; Tables, all built by the assembler
; ======================================================================

; --- the level ---------------------------------------------------------
; The map, as a picture. Everything below is derived from it, so changing
; the level means changing these sixteen lines and nothing else.
MAPT = [ "################",  "#..............#",  "#..##....####..#",  "#..##....#..#..#",  "#........#..#..#",  "#...####.#..#..#",  "#...#..#.#..#..#",  "#...#..#....#..#",  "#...#..######..#",  "#...#..........#",  "#...######..##.#",  "#........#..##.#",  "#..####..#.....#",  "#..#..#........#",  "#..#...........#",  "################" ]

; Written as one expression because a 64tass function returns the value its
; .endf carries, and there is only ever one of those. The bounds arm is not
; decoration: the perimeter cells are solid and ask about their neighbours
; outside the map.
solid	.function x, y
	.endf (x < 0 || x >= MAPW || y < 0 || y >= MAPH) ? 1 : (MAPT[y][x] == '#')

; One byte per cell, for the collision test in movePlayer.
mapData
	.for cy = 0, cy < MAPH, cy += 1
	  .for cx = 0, cx < MAPW, cx += 1
	  .byte solid(cx, cy)
	  .next
	.next

; One 16-byte record per exposed face of a solid cell, in WORLD units as
; 8.8. The winding is what tells gpu64 which side is the front: a wall is
; drawn only from the side that projects it left to right, so each face is
; wound anticlockwise around the empty cell it faces.
;
; u runs 0 to 32.0 across a cell, so one texture tiles per world unit and
; no wall record ever needs a length or a square root.
wallrec	.macro	x1, y1, x2, y2, tex
	.sint (\x1)*256, (\y1)*256, (\x2)*256, (\y2)*256
	.byte \tex, 0
	.sint 0, $2000
	.byte 0, 0
	.endm

walls
	.for cy = 0, cy < MAPH, cy += 1
	  .for cx = 0, cx < MAPW, cx += 1
	    .if solid(cx, cy)
	      .if !solid(cx-1, cy)
	      #wallrec cx, cy+1, cx, cy, 1 + ((cx + cy) & 1)
	      .endif
	      .if !solid(cx+1, cy)
	      #wallrec cx+1, cy, cx+1, cy+1, 1 + ((cx + cy) & 1)
	      .endif
	      .if !solid(cx, cy-1)
	      #wallrec cx, cy, cx+1, cy, 1 + ((cx + cy) & 1)
	      .endif
	      .if !solid(cx, cy+1)
	      #wallrec cx+1, cy+1, cx, cy+1, 1 + ((cx + cy) & 1)
	      .endif
	    .endif
	  .next
	.next
wallsEnd
	.word 0				; room for the batch checksum

NWALLS	= (wallsEnd - walls) / R2_REC

; --- the walk ----------------------------------------------------------
; One step along each of the 256 headings, 8.8. Angle 0 looks along +x,
; which is the convention SET_CAMERA uses.
stepXLo
	.for a = 0, a < 256, a += 1
	.byte <round(cos(a * 2 * pi / 256) * SPEED * 256)
	.next
stepXHi
	.for a = 0, a < 256, a += 1
	.byte >round(cos(a * 2 * pi / 256) * SPEED * 256)
	.next
stepYLo
	.for a = 0, a < 256, a += 1
	.byte <round(sin(a * 2 * pi / 256) * SPEED * 256)
	.next
stepYHi
	.for a = 0, a < 256, a += 1
	.byte >round(sin(a * 2 * pi / 256) * SPEED * 256)
	.next

; --- the palette: 8 hues x 32 brightnesses -----------------------------
palHues = [[80,60,50], [150,120,95], [110,110,120], [90,130,90],  [170,150,60], [70,90,150], [180,90,60], [200,200,200]]

palData
	.for h = 0, h < 8, h += 1
	  .for s = 0, s < 32, s += 1
	  .byte round(palHues[h][0] * s / 31.0), round(palHues[h][1] * s / 31.0), round(palHues[h][2] * s / 31.0)
	  .next
	.next

; --- the colormap: 16 levels, each two shades darker than the last -----
cmapData
	.for l = 0, l < CMAP_LEVELS, l += 1
	  .for c = 0, c < 256, c += 1
	  .byte (c & $e0) | ((c & 31) - 2 * l < 0 ? 0 : (c & 31) - 2 * l)
	  .next
	.next

; --- the textures, column-major: texel(u,v) at u * TEXH + v ------------
brickTex
	.for u = 0, u < TEXW, u += 1
	  .for v = 0, v < TEXH, v += 1
	  .byte ((v % 8) == 0) || (((u + ((v / 8) % 2) * 8) % 16) < 2) ? 0*32+20 : 1*32+18+((u*5+v*3) % 6)
	  .next
	.next

stoneTex
	.for u = 0, u < TEXW, u += 1
	  .for v = 0, v < TEXH, v += 1
	  .byte ((v % 16) < 1) || ((u % 16) < 1) ? 2*32+12 : 2*32+20+((u*3+v*7) % 5)
	  .next
	.next

; The weapon: index 0 is the key, so the shape is what is not 0.
gunTex
	.for u = 0, u < TEXW, u += 1
	  .for v = 0, v < TEXH, v += 1
	  .byte (u >= 12 && u < 20 && v >= 8) ? (u < 14 || u >= 18 ? 7*32+14 : 7*32+24) :  ((u >= 10 && u < 22 && v >= 20) ? 7*32+8 : 0)
	  .next
	.next
