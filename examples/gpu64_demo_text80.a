;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 demo -- TEXT80: the 80x50 character screen.
;
;      gpu64's other display mode. Instead of a 320x200 framebuffer the
;      HDMI screen becomes 80 columns by 50 rows of 8x8 glyphs taken from
;      the Commodore 64's own character ROM -- the same bitmaps the VIC-II
;      draws, at 640x400. Nothing is emulated and nothing is scaled: a
;      screen code here means what it means at $0400.
;
;      TEXT MODE IS A DISPLAY MODE, NOT A DRAWING OP
;
;      While it is up there is no framebuffer to draw into: CLEAR, LINE,
;      BLIT and the rest have nowhere to land, PAGE_FLIP answers
;      UNSUPPORTED, and so does every class 1 and class 2 command. Go back
;      with TEXT_MODE 0 -- which is exactly what dmInit issues, so running
;      any other demo after this one puts the graphics screen back.
;
;      The mode is also sticky the other way round: the plane commands work
;      with the graphics screen still on the display, so a program can
;      compose a whole text screen and have it appear complete at the
;      switch.
;
;      What each part is here to show:
;
;        TEXT_MODE     into the character screen, and back out of it.
;        TEXT_CLEAR    all 4000 cells, one colour pair.
;        TEXT_FILL     a rectangle of cells -- the title bar, the colour
;                      bars, the panel behind them.
;        TEXT_WRITE    a line of ASCII; gpu64 translates it to screen codes
;                      for whichever character set is up.
;        TEXT_UPLOAD   raw plane bytes out of C64 RAM with no per-cell
;                      dispatch: the 256-glyph chart is 16 of these.
;        TEXT_PUT      one cell, for the blinking cursor.
;        TEXT_CHARSET  the two halves of the ROM. This demo swaps them
;                      every 128 frames, which is why the capitals in the
;                      middle of the screen keep turning into graphics --
;                      that is not a bug, it is what SHIFT+C= does on a
;                      real C64, and the lower-case letters survive it
;                      because codes 1-26 are letters in both halves.
;
;      Screen code bit 7 is reverse video, again exactly as at $0400. The
;      colour bars are reverse spaces, and the second half of the glyph
;      chart is the first half reversed.
;
;      Run it: LOAD"GPU64-TEXT80",8,1 then RUN. Press RUN/STOP to finish;
;      the text screen deliberately stays up afterwards, so it can be
;      photographed, and the next gpu64 program to start puts graphics
;      back.
;
;      REU emulation must be selected in RAD's menu (press T until it reads
;      REU) or none of gpu64 runs at all.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64.inc"

; Where the two panels sit. The chart is 16 cells wide and 16 rows tall
; with its row labels to the left; the colour bars sit in the right-hand
; half of the 80-column screen, which is the point of having 80 columns.
CHART_COL	= 8
CHART_ROW	= 11
BAR_COL		= 46
BAR_ROW		= 11
CAPT_ROW	= 28
REV_ROW		= 30
MARQ_ROW	= 44
MARQ_COL	= 1
MARQ_LEN	= 78
STAT_ROW	= 46
CURS_COL	= 16

	#basicStub

start
	jsr dmInit			; clear the C64 screen, class 0, read info

	; --- into text mode -------------------------------------------------
	; The one command that can fail here. A build without text mode, or a
	; display gpu64 could not reprogram, says so rather than pretending.
	#argb 0, 1
	#cmd OP_TEXT_MODE
	lda ERRCODE
	beq modeOk

	lda #1
	jsr dmRow
	jsr dmText
	.text "GPU64 TEXT80  NO TEXT MODE  ERRCODE "
	.byte 0
	jsr dmErr
	jmp dmHold

modeOk
	; The border belongs to the display, not to the text planes, and
	; SET_BORDER means the same thing in both modes.
	#argb 0, BLACK
	#cmd OP_SET_BORDER

	; --- the whole screen, one command ----------------------------------
	; Foreground then background: 4000 cells set to a space in those two
	; colours. The C64's own power-on pair, because it is the right pair.
	#argb 0, LTBLUE
	#argb 1, BLUE
	#cmd OP_TEXT_CLEAR

	; --- title bar ------------------------------------------------------
	; A rectangle of spaces in the bar's colours, then the text on top of
	; it in the same colours. TEXT_WRITE sets every cell it touches, so
	; the two agree.
	#txtfill 0, 0, TXT_COLS, 1, $20, BLACK, LTGREY
	#txtw 2, 0, title, titleEnd-title, BLACK, LTGREY

	; --- a ruler, so 80 columns is a fact and not a claim ---------------
	#txtw 0, 2, ruler, TXT_COLS, GREY, BLUE

	#txtw 4, 4, body1, body1End-body1, LTBLUE, BLUE
	#txtw 4, 5, body2, body2End-body2, LTBLUE, BLUE
	#txtw 4, 6, body3, body3End-body3, LTBLUE, BLUE
	#txtw 4, 7, body4, body4End-body4, LTBLUE, BLUE

	; --- the glyph chart ------------------------------------------------
	; All 256 screen codes, sixteen to a row. The colours are painted
	; first, with one TEXT_FILL over the whole block, and then only the
	; screen codes are uploaded on top -- TEXT_UPLOAD writes one plane and
	; leaves the other two alone, which is what makes this two commands a
	; row instead of sixteen.
	#txtw 4, 9, hdrCodes, hdrCodesEnd-hdrCodes, WHITE, BLUE
	#txtw CHART_COL, 10, hexdig, 16, GREY, BLUE
	#txtfill CHART_COL, CHART_ROW, 16, 16, $20, WHITE, BLACK

	.for r = 0, r < 16, r = r + 1
	#txtw 4, CHART_ROW + r, chartLbl + r * 3, 3, GREY, BLUE
	#txtup TXT_PLANE_SCREEN, (CHART_ROW + r) * TXT_COLS + CHART_COL, chart + r * 16, 16
	.next

	; --- the sixteen colours --------------------------------------------
	; Each bar is a row of reverse-video spaces: a space has no set pixels
	; of its own, so reversing it fills the whole cell with its foreground
	; colour -- which is why the bar's background colour below is never
	; seen. The panel the bars sit on alternates black and white by row,
	; because on a panel of one colour whichever bar matched it would be an
	; invisible gap that reads as a missing colour.
	#txtw BAR_COL-2, 9, hdrCols, hdrColsEnd-hdrCols, WHITE, BLUE

	.for c = 0, c < 16, c = c + 1
	#txtput BAR_COL-4, BAR_ROW + c, $30 + c + (c >= 10) * ($01 - $3a), WHITE, BLUE
	.if (c & 1) == 0
	#txtfill BAR_COL-2, BAR_ROW + c, 28, 1, $20, BLACK, WHITE
	.else
	#txtfill BAR_COL-2, BAR_ROW + c, 28, 1, $20, WHITE, BLACK
	.endif
	#txtfill BAR_COL, BAR_ROW + c, 24, 1, TXT_REVERSE + $20, c, BLACK
	.next

	; --- reverse video, spelled out --------------------------------------
	; Built as screen codes rather than as ASCII, to show what TEXT_WRITE's
	; ASCII flag is doing for you everywhere else. Lower-case ASCII minus
	; $60 is screen code 1-26, which is a letter in BOTH halves of the ROM,
	; so this line survives the character set swapping under it. Bit 7 on
	; top of that is the reverse video.
	ldx #0
revCopy
	lda revStr,x
	cmp #$61			; below 'a': punctuation and digits are
	bcc revPlain			; already the screen code they look like
	sec
	sbc #$60
revPlain
	ora #TXT_REVERSE
	sta revBuf,x
	inx
	cpx #revEnd-revStr
	bne revCopy

	; The colours first, then the codes -- and note the fg/bg pair reads
	; backwards, because every one of these cells is reversed.
	#txtfill 4, REV_ROW, revEnd-revStr, 1, $20, YELLOW, BLACK
	#txtup TXT_PLANE_SCREEN, REV_ROW * TXT_COLS + 4, revBuf, revEnd-revStr

	#txtw 4, 32, caps, capsEnd-caps, LTGREEN, BLUE
	#txtw 4, 34, cost1, cost1End-cost1, GREY, BLUE
	#txtw 4, 35, cost2, cost2End-cost2, GREY, BLUE

	#txtw 4, STAT_ROW, statLbl, statLblEnd-statLbl, WHITE, BLUE
	#txtw 4, 48, foot1, foot1End-foot1, LTGREY, BLUE
	#txtw 4, 49, foot2, foot2End-foot2, LTGREY, BLUE

	; The marquee reads a moving 78-byte window out of its message, so the
	; first 78 bytes are copied to just past the end and the window never
	; has to wrap.
	ldx #0
marqInit
	lda marqMsg,x
	sta marqWrap,x
	inx
	cpx #MARQ_LEN
	bne marqInit

	; --- and say so on the C64's own screen ------------------------------
	lda #1
	jsr dmRow
	jsr dmText
	.text "GPU64 TEXT80  LAST ERRCODE "
	.byte 0
	jsr dmErr

	lda #3
	jsr dmRow
	jsr dmText
	.text "LOOK AT THE HDMI SCREEN."
	.byte 0
	lda #4
	jsr dmRow
	jsr dmText
	.text "PRESS RUN/STOP TO FINISH."
	.byte 0

; ----------------------------------------------------------------------
; The animated part. Three commands a frame: the marquee line, the frame
; counter, and the cursor cell -- plus a character set swap twice a second
; or so, which repaints the whole screen from the planes.
; ----------------------------------------------------------------------
mainLoop
	jsr dmVbWait

	; --- the marquee -----------------------------------------------------
	; The blob descriptor is staged by hand rather than with #txtw,
	; because the address moves: this is the one place in these demos
	; where gpu64 is told to read from a computed address.
	lda #SPACE_C64
	sta ARG+0
	lda #<marqMsg
	clc
	adc marqOff
	sta ARG+1
	lda #>marqMsg
	adc #0
	sta ARG+2
	lda #0
	sta ARG+3
	lda #MARQ_LEN
	sta ARG+4
	lda #0
	sta ARG+5
	#argb 6, MARQ_COL
	#argb 7, MARQ_ROW
	#argb 8, YELLOW
	#argb 9, BLUE
	#argb 10, TXT_ASCII
	#cmd OP_TEXT_WRITE

	; One column every other frame, which is about as fast as 8x8 text
	; can move and still be read.
	lda frameCnt
	and #1
	bne noScroll
	inc marqOff
	lda marqOff
	cmp #marqEnd-marqMsg
	bcc noScroll
	lda #0
	sta marqOff
noScroll

	; --- the frame counter, in hex ----------------------------------------
	inc frameCnt
	bne frameHi
	inc frameCnt+1
frameHi
	jsr hexUpd
	#txtw 11, STAT_ROW, hexBuf, 4, WHITE, BLUE

	; --- a blinking cursor, one cell, one command -------------------------
	lda frameCnt
	and #$10
	beq cursOff
	#txtput CURS_COL, STAT_ROW, TXT_REVERSE + $20, LTGREEN, BLUE
	jmp cursDone
cursOff
	#txtput CURS_COL, STAT_ROW, $20, LTGREEN, BLUE
cursDone

	; --- swap the halves of the character ROM every 128 frames ------------
	; Nothing in the planes changes: the same 4000 screen codes are drawn
	; with the other 2048 bytes of the ROM. Capitals become graphics and
	; the lower-case letters become capitals, which is the C64's own
	; behaviour and the reason this demo writes its prose in lower case.
	lda frameCnt
	asl a				; bit 7 of the frame counter...
	lda #0
	rol a				; ...is the character set
	cmp curSet
	bne setSwap
	jmp setDone			; out of branch range from here
setSwap
	sta curSet
	sta ARG+0
	lda #OP_TEXT_CHARSET
	sta CMD_LO
	lda curSet
	beq capt0
	#txtw 4, CAPT_ROW, setStr1, SET_LEN, LTGREEN, BLUE
	jmp setDone
capt0
	#txtw 4, CAPT_ROW, setStr0, SET_LEN, LTGREEN, BLUE
setDone

	jsr dmStop
	beq stopped			; the loop is a good deal longer than
	jmp mainLoop			; a branch reaches

	; RUN/STOP. The text screen is left up on purpose -- see the header.
stopped
	jmp dmHold

; ----------------------------------------------------------------------
; frameCnt as four ASCII hex digits in hexBuf, ready for a TEXT_WRITE with
; the ASCII flag. gpu64 does the screen-code translation, so this routine
; never has to know which character set is up.
; ----------------------------------------------------------------------
hexUpd
	ldy #0
	lda frameCnt+1
	jsr hexPair
	lda frameCnt
hexPair
	pha
	lsr a
	lsr a
	lsr a
	lsr a
	jsr hexNib
	sta hexBuf,y
	iny
	pla
	and #$0f
	jsr hexNib
	sta hexBuf,y
	iny
	rts

hexNib
	cmp #10
	bcc hexDec
	adc #$61-10-1			; carry is set: 'a'-'f'
	rts
hexDec
	adc #$30			; carry is clear: '0'-'9'
	rts

; ----------------------------------------------------------------------
; Text. All lower case on purpose: screen codes 1-26 are letters in both
; halves of the character ROM, so these lines stay readable when the demo
; swaps the halves under them. The one line with capitals in it is there
; to show what happens to those.
; ----------------------------------------------------------------------
title	.text "gpu64 -- 80 columns by 50 rows of the commodore 64 character rom"
titleEnd

; Every tenth column marked, and the mark numbered.
ruler
	.for i = 0, i < 8, i = i + 1
	.text "----+----"
	.byte $31 + i
	.next

body1	.text "every glyph on this screen comes out of the c64 character rom: the same"
body1End
body2	.text "8x8 bitmaps the vic-ii draws, 640x400 pixels of them on the hdmi screen."
body2End
body3	.text "each cell carries a screen code, a foreground and a background colour."
body3End
body4	.text "text_write translates ascii for you; text_upload takes screen codes raw."
body4End

hdrCodes .text "all 256 screen codes"
hdrCodesEnd
hdrCols	.text "the sixteen c64 colours"
hdrColsEnd

caps	.text "capitals ABCDEFGH are graphics in character set 0, exactly as on a c64"
capsEnd
cost1	.text "this whole screen is sixty-odd commands: 16 text_uploads for the chart,"
cost1End
cost2	.text "two text_fills per colour bar, and one text_write per line of prose."
cost2End

statLbl	.text "frame $"
statLblEnd
foot1	.text "run/stop finishes and leaves this screen up, to be photographed. the"
foot1End
foot2	.text "next gpu64 program to start puts the graphics screen back."
foot2End

; The two captions are padded to the same length so that either one
; overwrites the other completely.
SET_LEN	= 46
setStr0	.text "character set 0 -- upper case and graphics"
	.fill SET_LEN - (* - setStr0), $20
setStr1	.text "character set 1 -- lower case and upper case"
	.fill SET_LEN - (* - setStr1), $20

; Deliberately not run through TEXT_WRITE: see revCopy.
revStr	.text "reverse video: screen code bit 7"
revEnd

; "0123456789abcdef", used both as the chart's column header and as the
; source of its row labels.
hexdig	.text "0123456789abcdef"

; The chart itself: every screen code, in order.
chart
	.for i = 0, i < 256, i = i + 1
	.byte i
	.next

; "$00", "$10" ... "$f0", one label per chart row.
chartLbl
	.for i = 0, i < 16, i = i + 1
	.byte $24			; '$'
	.byte $30 + i + (i >= 10) * ($61 - $3a)
	.byte $30
	.next

marqMsg	.text "  gpu64 80x50 text mode -- this line is one text_write per frame, and "
	.text "the c64 waits for a vblank in between, so it moves at the display's "
	.text "own rate.  "
marqEnd
marqWrap .fill MARQ_LEN, 0		; the first MARQ_LEN bytes again, so the
					; window never has to wrap

; ----------------------------------------------------------------------
; Variables.
; ----------------------------------------------------------------------
frameCnt .byte 0, 0
marqOff	.byte 0
curSet	.byte 1				; the mode's own default, so the first
					; pass through the loop does not swap
hexBuf	.fill 4, 0
revBuf	.fill 40, 0

	.include "gpu64_rt.inc"
