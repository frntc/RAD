;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 demo 6 of 7 -- MATRIX: the math API, and nothing on the HDMI
;      screen at all.
;
;      Demo 5 used the matrix ops to move a shape. This one is for the
;      developer who wants to use them as a coprocessor: it runs a small
;      program of linear algebra and prints every answer on the C64's own
;      screen, in hex, so you can check it by hand.
;
;      What it runs:
;
;        1. MAT_IDENTITY on a 3x3, to show the element layout.
;        2. MAT_INVERSE of a 3x3 whose inverse is full of thirds, then
;           MAT_MUL of the two -- which should come back as the identity,
;           and does, to the last bit or one off it. That "one off" is the
;           point: 8.8 has a resolution of 1/256 and 1/3 is not in it.
;        3. The same two operations in float32 ($90-$96 instead of $80-$86,
;           same layouts, 4 bytes an element instead of 2), where the same
;           product comes back as exactly 1.0.
;        4. Two error paths, because an API you cannot get wrong on purpose
;           is one you cannot debug: a singular matrix answers SINGULAR
;           ($05) and writes nothing, and a dimension of 0 answers BAD_ARGS
;           ($04).
;
;      READING THE OUTPUT
;
;      8.8 elements print high byte first here, which is the opposite of
;      the order they sit in memory -- $0100 is 1.0, $0055 is 1/3 rounded,
;      $FF00 is -1.0. Float32 elements print in memory order, low byte
;      first, so 1.0 reads as 00 00 80 3F.
;
;      All of it is signed 16-bit 8.8 or IEEE 754 single, little-endian,
;      row-major, and every operand is a 4-byte compact descriptor: space
;      plus a 24-bit address, with no length, because the dimensions and
;      the element size already imply it. Nothing comes back through the
;      register window -- the results are in C64 RAM before the write to
;      CMD_LO returns.
;
;      Run it: LOAD"GPU64-MATRIX",8,1 then RUN. RUN/STOP finishes.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64.inc"

; Working memory. A 3x3 of 8.8 is 18 bytes; a 3x3 of float32 is 36.
IDENT   = $c000
AINV    = $c020
PROD    = $c040
FAINV   = $c080
FPROD   = $c0c0

	#basicStub

start
	jsr dmInit

	lda #0
	jsr dmRow
	jsr dmText
	.text "GPU64 MATRIX - RESULTS IN C64 RAM"
	.byte 0

	; --- 1. MAT_IDENTITY ------------------------------------------------
	; Five argument bytes: the order n, then where to put it.
	#argb 0, 3			; n
	#argcd 1, SPACE_C64, IDENT	; C
	#cmd OP_MAT_IDENTITY

	lda #2
	jsr dmRow
	jsr dmText
	.text "IDENTITY 3X3 - 0100 IS 1.0"
	.byte 0
	lda #<IDENT
	sta matPtr
	lda #>IDENT
	sta matPtr+1
	lda #3
	sta matRow
	jsr showMat3

	; --- 2. inverse, then the product -----------------------------------
	; A is matA below; its determinant is 3, so the inverse is thirds and
	; nothing about it lands cleanly in 8.8.
	#argb 0, 3			; n
	#argcd 1, SPACE_C64, matA	; A
	#argcd 5, SPACE_C64, AINV	; C
	#cmd OP_MAT_INVERSE
	lda ERRCODE
	sta invErr

	lda #7
	jsr dmRow
	jsr dmText
	.text "A INVERSE 8.8 - ERRCODE "
	.byte 0
	lda invErr
	jsr dmHexA
	lda #<AINV
	sta matPtr
	lda #>AINV
	sta matPtr+1
	lda #8
	sta matRow
	jsr showMat3

	; C = A . AINV, which should be the identity again.
	#argb 0, 3			; m
	#argb 1, 3			; k
	#argb 2, 3			; n
	#argcd 3, SPACE_C64, matA	; A
	#argcd 7, SPACE_C64, AINV	; B
	#argcd 11, SPACE_C64, PROD	; C
	#cmd OP_MAT_MUL

	lda #12
	jsr dmRow
	jsr dmText
	.text "A TIMES A INVERSE - NOTE THE LSBS"
	.byte 0
	lda #<PROD
	sta matPtr
	lda #>PROD
	sta matPtr+1
	lda #13
	sta matRow
	jsr showMat3

	; --- 3. the same thing in float32 -----------------------------------
	; $96 is FLT_INVERSE, $90 is FLT_MUL: same opcodes in the low nibble,
	; same argument layouts, 4 bytes an element instead of 2.
	#argb 0, 3
	#argcd 1, SPACE_C64, fmatA
	#argcd 5, SPACE_C64, FAINV
	#cmd OP_FLT_INVERSE

	#argb 0, 3
	#argb 1, 3
	#argb 2, 3
	#argcd 3, SPACE_C64, fmatA
	#argcd 7, SPACE_C64, FAINV
	#argcd 11, SPACE_C64, FPROD
	#cmd OP_FLT_MUL

	lda #16
	jsr dmRow
	jsr dmText
	.text "FLOAT32 ELEMENT 0 0 WANT 1.0 - "
	.byte 0
	; Element [0][0] of the product, in memory order: 1.0 is 00 00 80 3F.
	ldx #0
fpLoop
	lda FPROD,x
	jsr dmHexA
	inx
	cpx #4
	bne fpLoop

	; --- 4. the error paths ---------------------------------------------
	; matSing's second row is a multiple of its first, so it has no
	; inverse. A failed dispatch does nothing at all: the destination is
	; not written, not even partially.
	#argb 0, 3
	#argcd 1, SPACE_C64, matSing
	#argcd 5, SPACE_C64, AINV
	#cmd OP_MAT_INVERSE

	lda #18
	jsr dmRow
	jsr dmText
	.text "SINGULAR MATRIX  WANT 05  GOT "
	.byte 0
	lda ERRCODE
	jsr dmHexA

	; A dimension of 0 is not a degenerate case to be tolerated -- it is
	; an argument that cannot have been meant.
	#argb 0, 0			; n = 0
	#argcd 1, SPACE_C64, IDENT
	#cmd OP_MAT_IDENTITY

	lda #19
	jsr dmRow
	jsr dmText
	.text "N EQUALS ZERO    WANT 04  GOT "
	.byte 0
	lda ERRCODE
	jsr dmHexA

	lda #21
	jsr dmRow
	jsr dmText
	.text "NOTHING WAS DRAWN. THIS DEMO IS ALL"
	.byte 0
	lda #22
	jsr dmRow
	jsr dmText
	.text "ARITHMETIC. RUN/STOP TO FINISH."
	.byte 0
	jmp dmHold

; ----------------------------------------------------------------------
; Print the 3x3 matrix of 8.8 elements at matPtr, one matrix row per screen
; row starting at matRow. High byte first, which is how a fixed-point value
; reads -- integer part, then fraction -- and the reverse of how it sits in
; memory.
; ----------------------------------------------------------------------
matPtr = SRC			; the zero-page pointer from the include:
				; (zp),y is the only indirect the 6502 has

showMat3
	lda #0
	sta mr
smRow
	lda matRow
	clc
	adc mr
	jsr dmRow
	; DST is the start of the row; indent it a little.
	clc
	lda DST
	adc #2
	sta DST
	bcc +
	inc DST+1
+
	lda #0
	sta mc
smCol
	; element index = mr*3 + mc, two bytes each
	lda mr
	asl a
	adc mr				; *3 (carry is clear after asl of <64)
	clc
	adc mc
	asl a
	tay
	lda (matPtr),y
	sta elo				; dmHexA uses Y, so read both bytes
	iny				; before printing either
	lda (matPtr),y
	jsr dmHexA			; high byte
	lda elo
	jsr dmHexA			; low byte
	; a space between elements
	lda #$20
	ldy #0
	sta (DST),y
	inc DST
	bne +
	inc DST+1
+
	inc mc
	lda mc
	cmp #3
	bne smCol
	inc mr
	lda mr
	cmp #3
	bne smRow
	rts

; ----------------------------------------------------------------------
matRow	.byte 0
mr	.byte 0
mc	.byte 0
elo	.byte 0
invErr	.byte 0

; A, 8.8, row-major:   2 1 0
;                      0 1 1
;                      1 0 1     determinant 3, so A-1 is all thirds.
matA
	.word $0200, $0100, $0000
	.word $0000, $0100, $0100
	.word $0100, $0000, $0100

; Row 1 is twice row 0, so this one has no inverse.
matSing
	.word $0100, $0200, $0300
	.word $0200, $0400, $0600
	.word $0000, $0100, $0100

; The same A in IEEE 754 single precision, little-endian: 0.0 is $00000000,
; 1.0 is $3F800000, 2.0 is $40000000.
fmatA
	.dword $40000000, $3f800000, $00000000
	.dword $00000000, $3f800000, $3f800000
	.dword $3f800000, $00000000, $3f800000

	.include "gpu64_rt.inc"
