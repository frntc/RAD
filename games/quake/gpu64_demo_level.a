;
;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- E1M1. A whole Quake level, on the C64's second screen.
;
;      WHAT THIS PROGRAM IS EVIDENCE FOR
;
;      Every other class 1 demo uploads its own geometry: a few hundred
;      triangles the 6502 has in its own memory, pushed through UPLOAD_MESH.
;      E1M1 is 15601 triangles, 66 textures and 620 KB. That does not fit in
;      a C64 and never will, and it should not have to -- it is level data,
;      not game state. So it ships in the REU image beside the PRG, and this
;      program spends TWO commands on the whole level:
;
;              LOAD_LEVEL      here is the level, build it
;              LEVEL_STEP      ...one slice at a time, until RESULT says $FF
;
;      and then flies a camera around it at one SCENE_COMMIT a frame. The
;      C64's entire per-frame cost is a camera update and a commit -- the
;      same cost the retained-scene API has had since milestone 15b, now
;      against a level two orders of magnitude bigger than the demos that
;      proved it.
;
;      WHAT IT IS NOT EVIDENCE FOR
;
;      It is not a game. There are no monsters, no doors and no weapons.
;      What it does have, since stage 4, is the floor: every step goes
;      through CLIP_MOVE, so the player walks on the ground, climbs the
;      stairs and cannot leave the map. What this program answers is the one
;      question a PC cannot: does the loader put E1M1 on the HDMI output,
;      and does a frame still cost what it cost when the scene was small.
;
;      WHO OWNS THE CAMERA
;
;      The C64 does. Position and heading are kept here and sent absolutely
;      every frame with SET_POSITION and SET_ORIENTATION, never as deltas.
;      That is docs/state-refresh.md applied to the only node that moves,
;      and it is not a precaution: the delta version of this program put the
;      eye under the floor at the bench and left it there. See the note
;      above moveCamera.
;
;      DRIVING IT
;
;        W / S   forward / back          A / D   turn left / right
;        Q / E   strafe left / right     SPACE   hold to move faster
;        RUN/STOP                        leave, and hand the screen back
;
;      Movement is collided against the level's Quake clip hulls by
;      CLIP_MOVE ($15), one command a frame: this program asks for a
;      displacement and is told where it actually ends up. Gravity is a
;      constant downward term in that displacement -- see moveCamera.
;
;      BEFORE RUNNING IT
;
;      Select quake.reu (tools/pack_levels.py) as the REU image in the RAD
;      menu. The Pi checks the pack when the image loads -- the log says so,
;      with the counts -- and LOAD_LEVEL answers BAD_ARGS ($04) if the
;      image is not a level pack.
;
;      READING THE SCREEN
;
;        LOAD     the load's progress, then its verdict. DONE is the only
;                 success; anything else names the phase item that failed.
;        FRAMES   frames attempted / commits accepted
;        CMT      the two answers a commit is allowed to give: 07 BUSY is
;                 pacing, 06 UNSUPPORTED is the loop not running. XX is
;                 neither, and its code is printed.
;        CAM      where this program believes the camera is, as three
;                 signed 16-bit world coordinates and a heading. Every one
;                 of the three now comes back from CLIP_MOVE, so none of
;                 them is the fixed reference an earlier version had in Y.
;        CLIP     CLIP_MOVE's answer for the last frame: F flags (01 on
;                 ground, 02 wall, 08 stepped, 10 stuck in solid), FR how
;                 much of the requested step was covered out of FF, E the
;                 last ERRCODE (a diagnostic, never the verdict). Then the
;                 four ways an answer can be rejected, counted separately
;                 because they point in different directions: N ERRCODE was
;                 non-zero, so the Pi refused the block we SENT; M the
;                 output magic was wrong, so the writeback never landed; S
;                 magic was right and the checksum was not, so it landed
;                 damaged; W it passed both and still ended further from
;                 the start than the step asked for -- the bus nearly
;                 getting away with a permanent wrong position. N, M and S
;                 retry up to CLIP_TRIES times before the frame gives up.
;        MISSED   dispatches whose SEQACK did not match -- the bus defect,
;                 not this program. See CLAUDE.md.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64.inc"

; --- class 1 opcodes this program uses ---------------------------------
OP_SCENE_RESET       = $00
OP_SET_VIEWPORT      = $01
OP_SET_PERSPECTIVE   = $02
OP_SET_BACKGROUND    = $05
OP_LOOP_START        = $06
OP_LOOP_STOP         = $07
OP_SCENE_COMMIT      = $08
OP_ARENA_STATUS      = $09
OP_LOAD_LEVEL        = $13
OP_LEVEL_STEP        = $14
OP_CLIP_MOVE         = $15
OP_SET_ACTIVE_CAMERA = $23
OP_SET_POSITION      = $30
OP_SET_ORIENTATION   = $31
OP_GET_TRANSFORM     = $36

; The one class 0 opcode here is OP_SET_DMA_WINDOW, the fence every
; C64-space readback needs; gpu64.inc defines it.

; The one-shot key every destructive class 1 opcode demands in ARG15, and
; LOAD_LEVEL is one of them: it wipes the resource table, the arena and the
; scene. Spent by every dispatch, so it is staged per command and never
; once at start-up. gpu64_api.h has the reasoning.
KEY_DESTRUCTIVE = $a5



; LEVEL_STEP's RESULT: 0..99 is percent and more remains; $ff is done.
LEVEL_DONE = $ff

; Ids. Textures are forced to 0..65 by the face format -- a face's texture id
; is one byte the renderer looks up directly -- so meshes have to start above
; the texture count and nothing may share the camera's id.
MESH_BASE = 1000
NODE_BASE = 100
CAM_ID    = 1

; The view: the whole 320x200 render surface, which is also the largest
; viewport the per-frame pixel budget allows (320*200*3 vs 196608). The same
; viewport every other class 1 demo uses, so a frame cost measured here is
; comparable with theirs.
VP_W  = 320
VP_H  = 200
FOV   = 13653			; 75 degrees, as 65536 = 360 -- 90 read as
				;   far too wide on the bench (run 38)
NEARZ = 26			; 8.8: 0.1 world units
FARZ  = 32767			; 8.8: 127.99, the format's far plane

; How long to wait for FRAME_READY before giving up on a frame. A poll is
; about 20 cycles, so this is roughly 450ms -- a hang detector, and only
; that.
;
; It used to be 2000, which is about 45ms, and that was written when the
; premise above it said "the render finishes in well under a display frame".
; E1M1 is fifteen thousand triangles with no visibility system, and the
; premise is not true for it: every frame timed out, and a timeout here does
; not skip the frame, it commits anyway. SCENE_COMMIT is the one class 1
; opcode that is not shadow-redirectable, so its dispatch drains the render
; ring with the C64 DMA-halted -- i.e. a too-short timeout converts "poll a
; register while the 6502 free-runs" into "stop the C64 until core 1
; finishes". That is the shape of a program that answers the keyboard badly.
; Wait properly instead, and let the MS rows below say how long the wait
; really is.
READY_WAIT = 20000

; A wall clock that a DMA hold cannot stop. The KERNAL jiffy counter can:
; it is incremented by the CIA1 interrupt, the 6510 is halted for the whole
; of a gpu64 dispatch, and an interrupt that falls inside a hold is serviced
; once however many ticks it covered -- so the jiffy clock UNDER-reports
; exactly the time this program most needs to measure. CIA2's timers keep
; counting regardless, because they are not the CPU.
;
; Timer A free-runs with a 985-cycle period (1.0ms on PAL, 1.04 on NTSC --
; a 4% error that no reading here turns on), and timer B counts timer A's
; underflows, which makes $dd06/$dd07 a 16-bit millisecond counter that
; wraps every 65 seconds. It counts DOWN, so an elapsed time is
; mark - now.
;
; CIA2 is free: the KERNAL drives its timers only for RS232, which this
; program does not open, and nothing here enables a CIA2 interrupt, so the
; NMI line is untouched.
CIA2_TALO = $dd04
CIA2_TAHI = $dd05
CIA2_TBLO = $dd06
CIA2_TBHI = $dd07
CIA2_CRA  = $dd0e
CIA2_CRB  = $dd0f
CLK_PERIOD = 985		; cycles per millisecond, PAL

; Slots in msCur/msMax: the four phases of a frame, plus the frame itself.
MS_PER  = 0			; frame start to frame start
MS_CAM  = 1			; SET_POSITION + SET_ORIENTATION
MS_WAIT = 2			; waiting for FRAME_READY
MS_CMT  = 3			; SCENE_COMMIT's dispatch
MS_DISP = 4			; drawing this program's own telemetry
MS_HB   = 5			; the health sample, on the frames that take one
MS_SLOTS = 6

; Frames between telemetry redraws.
DISP_EVERY = 8

; Movement per frame, 8.8 world units and yaw units.
WALK  = 26			; 0.1 world units = 3.2 Quake units
TURN  = 512			; 512/65536 of a turn, about 2.8 degrees

; The keyboard matrix: a column written to $dc00, the rows read back from
; $dc01, both active low. Three of the eight columns carry every key this
; program uses, so a frame's input is three writes and three reads and no
; KERNAL call -- which matters, because the KERNAL's own scan runs off the
; jiffy IRQ and this program spends most of each frame DMA-halted.
CIA_PRA = $dc00
CIA_PRB = $dc01
COL_B   = %11111101		; W, A, S, E
COL_C   = %11111011		; D
COL_D   = %01111111		; Q, SPACE, RUN/STOP
KB_W    = $02
KB_A    = $04
KB_S    = $20
KB_E    = $40
KC_D    = $04
KD_Q    = $40
KD_SPC  = $10
KD_STOP = $80

; Byte offsets of the three components inside cam. The camera is kept as one
; twelve-byte block in exactly the order SET_POSITION reads it, so sending it
; is a copy and never a rearrangement.
CAM_X = 0
CAM_Y = 4
CAM_Z = 8

; GET_TRANSFORM hands back twelve bytes of position and three angles.
CAM_BUF_LEN = 18

; CLIP_MOVE's block: 32 bytes in, 24 back, at the offsets
; docs/class1-3d-mesh-reference.md tabulates. The out half is a readback like
; any other and lives inside the same SET_DMA_WINDOW fence.
CLIP_LEN     = 56
CLIP_IN_LEN  = 32
CLIP_HULL    = 24
CLIP_MODE    = 25
CLIP_MODEL   = 26
CLIP_MAGIC   = 27
CLIP_CHECK   = 28
CLIP_MOVERS  = 29
CLIP_OUT     = 32
CLIP_OFLAGS  = 44
CLIP_OCONT   = 45
CLIP_OFRAC   = 46
CLIP_OBUMPS  = 47
CLIP_OMAGIC  = 48
CLIP_OCHECK  = 49
CLIP_IN_M    = $c5
CLIP_OUT_M   = $5c

; Slide along walls, step up stairs, settle onto the floor, and the position
; on both sides of the call is the EYE rather than the feet -- so the twelve
; bytes that go in are the same twelve SET_POSITION sends, with no offset
; arithmetic in this program at all.
CLIP_MODE_WALK = $01 | $02 | $04 | $08
CLIP_HULL_PLAYER = 1

; How far past the step it asked for an answer is still allowed to land, in
; whole world units. The trace may add a step-up of its own (18 Quake units,
; 0.5625 world units) and cmBound compares integer halves, so two covers both
; with room to spare while still being three orders of magnitude tighter than
; the corruption it exists to catch.
POS_SLOP = 2

; How many times to ask again before giving the frame up. The Pi never writes
; the input half, so a retry is the descriptor's six register writes and the
; dispatch -- cheap next to a frame of standing still.
CLIP_TRIES = 4

; Gravity, as a fixed downward term in every frame's displacement: 0.25 world
; units, 8 Quake units a frame. Not an acceleration -- a falling speed. A
; constant is enough for a demo that walks, and the floor settle in CLIP_MOVE
; covers anything shorter than a stair.
FALL = 64			; 8.8, 0.25 world units
FALL_16 = FALL * 256		; the same in the 16.16 the displacement is in

; What RESULT must echo after SET_DMA_WINDOW: ARG0^ARG1^ARG2^ARG3^$A5. ARG
; registers cannot be read back, so this is the only confirmation there is
; that the fence landed where it was aimed.
FENCE_ECHO = (<healthBuf) ^ (>healthBuf) ^ (<DMA_LEN) ^ (>DMA_LEN) ^ $a5

; The health block, asked for at its self-verifying length: 128 bytes of
; counters, then 'G', '6', an XOR and a sum over everything before them. The
; trailer is the reason to ask for 132 rather than 12 -- a block that arrives
; in part leaves the poison intact in the bytes that did not land and gone
; from the ones that did, so a poison test passes on corrupt data and this
; one does not.
HB_LEN   = 132
HB_MAGIC = 128			; 'G', '6', xor, sum
HB_PWR   = 4			; throttle word latched this session
HB_TEMP  = 8			; core temperature, tenths of a degree
HB_DTO   = 12			; flip drains that gave up
HB_SLOW  = 16			; flips the VideoCore was slow to take
HB_FLIPS = 18			; flips posted

; One window covers all three readbacks, so healthBuf, camBuf and clipBlk
; below must stay adjacent and in this order.
DMA_LEN = HB_LEN + CAM_BUF_LEN + CLIP_LEN

; Frames between health samples. GET_HEALTH is a mailbox round trip to the
; VideoCore -- about a millisecond with the C64 halted -- so it is
; housekeeping, never per-frame work.
HB_EVERY = 64

	#basicStub

	jsr dmInit			; clear screen, FULL_RESET, frame clock

	lda #0
	jsr dmRow
	jsr dmText
	.text "GPU64 E1M1 - A QUAKE LEVEL FROM SD"
	.byte 0

; ======================================================================
; Set up the view BEFORE the level. LOAD_LEVEL deliberately leaves the
; viewport, fov and clip planes alone -- they belong to the caller, and the
; view a program wants exists before the level does.
; ======================================================================
	lda #1
	sta CMD_HI

	; A clean slate FIRST. Not strictly needed after dmInit's FULL_RESET,
	; but gpu64 state is sticky across program launches (loading a .prg
	; does not reset the Pi) and a half-built scene from the last program
	; would be rendered underneath this one.
	;
	; And it has to come first, not last: SCENE_RESET calls the firmware's
	; gpu64_3dStateDefaults(), so a viewport staged before it is thrown
	; away. Reset, then describe the view.
	lda #KEY_DESTRUCTIVE
	sta ARG+15
	lda #OP_SCENE_RESET
	jsr cmd1
	sta resErr

	; Viewport before perspective, in that order: the focal length is
	; derived from the fov AND the viewport width, so SET_PERSPECTIVE reads
	; the viewport SET_VIEWPORT just installed.
	#argw 0, 0
	#argw 2, 0
	#argw 4, VP_W
	#argw 6, VP_H
	lda #OP_SET_VIEWPORT
	jsr cmd1
	sta vpErr

	#argw 0, FOV
	#argw 2, NEARZ
	#argw 4, FARZ
	lda #OP_SET_PERSPECTIVE
	jsr cmd1
	sta perErr

	lda #0
	sta ARG+0			; black, so unlit geometry is obvious
	lda #OP_SET_BACKGROUND
	jsr cmd1

; ======================================================================
; The level. Two commands and a progress loop.
; ======================================================================
	lda #2
	jsr dmRow
	jsr dmText
	.text "LOAD    "
	.byte 0

	#argw 0, MESH_BASE
	#argw 2, NODE_BASE
	#argw 4, CAM_ID
	lda #KEY_DESTRUCTIVE
	sta ARG+15
	lda #OP_LOAD_LEVEL
	jsr cmd1
	sta loadErr
	beq loadArmed

	; Refused outright. $04 BAD_ARGS is overwhelmingly "no level file on
	; the card" -- say so, because it is the one failure whose fix is not
	; in the firmware.
	jsr showLoadErr
	jmp finish

loadArmed
	lda #0
	sta stepCt
	sta stepCt+1

stepLoop
	lda #OP_LEVEL_STEP
	jsr cmd1
	sta stepErr
	bne stepFailed

	inc stepCt
	bne +
	inc stepCt+1
+
	lda RESULT
	sta stepPct
	cmp #LEVEL_DONE
	beq stepDone

	; A loading bar that is also a liveness indicator: a load that wedges
	; stops here with the percentage it reached, which names the phase.
	lda #2
	jsr dmRow
	jsr dmText
	.text "LOAD    "
	.byte 0
	lda stepPct
	jsr dmHexA
	jmp stepLoop

stepFailed
	jsr showLoadErr
	jmp finish

stepDone
	lda #2
	jsr dmRow
	jsr dmText
	.text "LOAD    DONE IN "
	.byte 0
	lda stepCt+1
	jsr dmHexA
	lda stepCt
	jsr dmHexA
	jsr dmText
	.text " STEPS"
	.byte 0

	; LOAD_LEVEL created the camera at info_player_start and made it
	; active. Assert that rather than assume it: SET_ACTIVE_CAMERA on the
	; same id costs one command and turns "the loader forgot" from a black
	; screen into a BAD_ID on row 3.
	#id16 CAM_ID
	lda #OP_SET_ACTIVE_CAMERA
	jsr cmd1
	sta camErr

	jsr seedCamera

	; Mode 0, handshake: SCENE_COMMIT drives the frames. Staged explicitly
	; because ARG registers are not cleared between commands, and the byte
	; sitting in ARG0 here is the low half of LOAD_LEVEL's mesh base -- which
	; LOOP_START reads as mode $E8 and answers UNSUPPORTED to. Free-running
	; (mode 1) is Stage 18 and is what that refusal is guarding.
	lda #0
	sta ARG+0
	lda #OP_LOOP_START
	jsr cmd1
	sta loopErr

	lda #3
	jsr dmRow
	jsr dmText
	.text "SETUP   "
	.byte 0
	lda vpErr
	ora perErr
	ora resErr
	ora camErr
	ora getErr
	beq setupOk
	jsr dmText
	.text "VP "
	.byte 0
	lda vpErr
	jsr dmHexA
	jsr dmText
	.text " PER "
	.byte 0
	lda perErr
	jsr dmHexA
	jsr dmText
	.text " RST "
	.byte 0
	lda resErr
	jsr dmHexA
	jsr dmText
	.text " CAM "
	.byte 0
	lda camErr
	jsr dmHexA
	jsr dmText
	.text " GET "
	.byte 0
	lda getErr
	jsr dmHexA
	jmp setupShown
setupOk
	jsr dmText
	.text "OK  LOOP "
	.byte 0
	lda loopErr
	jsr dmHexA
setupShown

	; Zero the run's counters here, after every setup command, so the rows
	; below cover the frame loop and nothing else.
	lda #0
	sta frames
	sta frames+1
	sta okFrames
	sta okFrames+1
	sta e06
	sta e06+1
	sta e07
	sta e07+1
	sta eXX
	sta eXX+1
	sta xxCode
	sta missed
	sta missed+1
	sta stalls
	sta dispCt
	sta dispCt+1
	sta dispCt+2
	sta stalls+1
	ldx #MS_SLOTS-1
-	sta msCur,x
	sta msMax,x
	dex
	bpl -
	lda #$ff
	sta msPerMin
	lda #1				; draw the first frame's rows at once
	sta dispWait
	sta hbWait			; and take a health sample at once
	lda #0
	sta hbBad

	; Last, so the first frame's period is measured from the first frame.
	jsr clkInit

; ======================================================================
; A frame. Camera, pace, commit -- and nothing else. Core 1 clears the
; viewport, walks the 108 nodes, rasterises 15601 triangles and flips.
; ======================================================================
frame
	jsr clkFrame			; the period, and the start of phase one
	jsr moveCamera
	jsr sendCamera
	ldx #MS_CAM
	jsr clkLap
	jsr waitReady
	ldx #MS_WAIT
	jsr clkLap

	lda #OP_SCENE_COMMIT
	jsr cmdSeq1
	ldx #MS_CMT
	jsr clkLap
	lda seqErr
	beq frOk

	cmp #ERR_BUSY
	bne frNot07
	inc e07
	bne frCount
	inc e07+1
	jmp frCount
frNot07
	cmp #ERR_UNSUPPORTED
	bne frNotXX
	inc e06
	bne frCount
	inc e06+1
	jmp frCount
frNotXX
	sta xxCode
	inc eXX
	bne frCount
	inc eXX+1
	jmp frCount
frOk
	inc okFrames
	bne frCount
	inc okFrames+1
frCount
	inc frames
	bne +
	inc frames+1
+
	; The Pi's own view of itself, four times a minute. Under-voltage is
	; the first thing to rule out when a bench run reports anything
	; visually wrong (docs/class0-2d-reference.md), and it is the one
	; cause this program cannot see from the C64 side at all.
	dec hbWait
	bne frNoHealth
	jsr doHealth
	ldx #MS_HB
	jsr clkLap
frNoHealth

	; The telemetry costs more than the whole command path does -- eleven
	; rows of text is a few thousand cycles, against two dispatches -- and
	; it is the one part of a frame the player gains nothing from. Redraw
	; it eight times a second, not every frame; the MS MAX D figure still
	; says what one redraw costs, because it is only measured on the
	; frames that do one.
	dec dispWait
	bne frDrawn
	lda #DISP_EVERY
	sta dispWait
	jsr showFrame
	ldx #MS_DISP
	jsr clkLap
frDrawn

	lda keyD			; RUN/STOP, off this program's own scan
	and #KD_STOP
	beq frDone			; the loop outgrew a branch back to it
	jmp frame
frDone
	jmp finish

; ======================================================================
; Shutting down. LOOP_STOP is what hands the framebuffer back; without it
; the next program to run finds core 1 still rendering this level over the
; top of whatever it draws. Keyed, and re-sent until SEQACK confirms it --
; it is idempotent, so a retry costs nothing and a dropped one costs the
; next program its display.
; ======================================================================
finish
	lda #1
	sta CMD_HI
	ldx #8
fnStop
	lda #KEY_DESTRUCTIVE
	sta ARG+15
	lda #OP_LOOP_STOP
	jsr cmdSeq1
	lda seqMiss
	beq fnStopped
	dex
	bne fnStop
fnStopped
	stx stopTry

	lda #0
	sta CMD_HI

	jsr showFrame

	lda #1
	jsr dmRow
	jsr dmText
	.text "STOPPED - RUN/STOP AGAIN TO EXIT"
	.byte 0

-	jsr readKeys			; wait for the key that stopped us to
	lda keyD			; come back up, so the second press is
	and #KD_STOP			; a new one and not this one still held
	beq -
-	jsr readKeys
	lda keyD
	and #KD_STOP
	bne -
	jsr $e544			; KERNAL clear screen
	rts

; ======================================================================
; The camera. THE C64 OWNS IT.
;
; This used to be up to four delta commands a frame: MOVE_LOCAL along the
; camera's own +z and ROTATE_LOCAL about its own y. That is exactly the
; shape docs/state-refresh.md warns against, and the warning is not
; theoretical -- it is what bench run 34 found. A delta command is not
; idempotent, so one corrupted ARG byte is not a glitch the next frame
; corrects: it displaces the camera permanently, because nothing in the
; protocol ever says where the camera actually is. A few steps forward and
; the eye was two and a half world units under the floor, looking up
; through it, for the rest of the session.
;
; What made that diagnosable is that MOVE_LOCAL *cannot* move the camera
; down. With pitch and roll zero the y row of the rotation matrix is
; (0, 1, 0), so a forward step of (0, 0, s) leaves y bit-for-bit alone --
; 402 frames of it on a PC did, and the same walk on hardware did not.
;
; So the C64 keeps the camera now: position as three 16.16 world
; coordinates, heading as one 16-bit yaw, and the step is taken here with a
; sine table instead of by gpu64. Every frame sends SET_POSITION and
; SET_ORIENTATION, which are absolute and idempotent, whether or not
; anything moved. A lost or corrupted ARG byte then lasts exactly one
; frame. That is the refresh ring of docs/state-refresh.md with one entry
; in it, which is all a scene with one moving node needs -- and it is
; cheaper than what it replaces: two dispatches a frame instead of four.
;
; y is not merely refreshed. There is no expression in this program that
; can change it, which is what makes the CAM row on the screen a test: a Y
; that is not its start value is a corrupted register write, full stop.
;
;       W / S   forward / back          A / D   turn left / right
;       Q / E   strafe left / right     SPACE   hold to move four times as far
; ======================================================================

; Ask gpu64 where LOAD_LEVEL put the camera, once, and take ownership from
; there. Hardcoding info_player_start would be wrong for every other level,
; and the position is in the file, not in this program.
seedCamera
	; Fence first. This is a readback: the destination arrives in ARG
	; bytes, no ARG byte is covered by SEQACK, and a dropped one does not
	; produce a failed readback -- it produces a SUCCESSFUL one into an
	; address nobody named, written by the Pi while this C64 is halted.
	; SET_DMA_WINDOW confines it to the two buffers this program reads
	; back into, which are adjacent for that reason. Three tries, then
	; carry on regardless: a program with no window is exactly as safe as
	; every program written before the opcode existed, and refusing to
	; start is the more expensive mistake.
	ldx #3
scFence
	stx fenceTry
	#argw 0, healthBuf
	#argw 2, DMA_LEN
	lda #OP_SET_DMA_WINDOW
	jsr cmdClass0
	sta fenceErr
	lda RESULT
	sta fenceEcho
	cmp #FENCE_ECHO
	beq scFenced
	ldx fenceTry
	dex
	bne scFence
scFenced

	; Four tries at the readback itself. It is a pure read of retained
	; state, so a retry costs nothing and repeats nothing.
	ldx #4
scGet
	stx getTry

	; Poison, so that "nothing arrived" cannot be mistaken for a camera at
	; the origin facing north -- which is a position this level could
	; plausibly have.
	lda #$a5
	ldy #CAM_BUF_LEN-1
-	sta camBuf,y
	dey
	bpl -

	#id16 CAM_ID
	#argblob 0, SPACE_C64, camBuf, CAM_BUF_LEN
	lda #OP_GET_TRANSFORM
	jsr cmd1
	sta getErr
	bne scRetry

	; The block has no magic of its own, so the check is a structural
	; invariant instead: LOAD_LEVEL creates the camera with
	; SET_ORIENTATION(yaw, 0, 0), so pitch and roll are zero and the
	; poison is not. Four bytes is a weak test on its own and a sound one
	; against $A5.
	lda camBuf+14
	ora camBuf+15
	ora camBuf+16
	ora camBuf+17
	beq scGot
	lda #$ff			; arrived, but not intact
	sta getErr
scRetry
	ldx getTry
	dex
	bne scGet
	rts				; leave cam at 0 and let the row say why

scGot
	ldx #11
-	lda camBuf,x
	sta cam,x
	dex
	bpl -
	lda camBuf+12
	sta camYaw
	lda camBuf+13
	sta camYaw+1
	rts

; Held SPACE multiplies the step. A level is 200 world units across and a
; walking pace crosses it in a minute and a half, which is too slow to check
; a whole map at the bench.
moveCamera
	jsr readKeys

	; This frame's displacement starts at nothing and gains a term per key.
	; Zeroed every frame: it is a request, not state, and a request that
	; survived a frame would be a delta protocol again.
	lda #0
	ldx #11
-	sta mov,x
	dex
	bpl -

	lda #WALK
	sta stepLo
	lda keyD
	and #KD_SPC
	bne mcStepSet
	lda #WALK * 4			; 104, still one byte
	sta stepLo
mcStepSet

	; Turning first: a step taken this frame should be along the heading
	; the player just asked for, not the one before it. u16 yaw wraps for
	; free, which is the whole reason the wire angle is one.
	lda keyB
	and #KB_A
	bne mcNotLeft
	sec
	lda camYaw
	sbc #<TURN
	sta camYaw
	lda camYaw+1
	sbc #>TURN
	sta camYaw+1
mcNotLeft
	lda keyC
	and #KC_D
	bne mcNotRight
	clc
	lda camYaw
	adc #<TURN
	sta camYaw
	lda camYaw+1
	adc #>TURN
	sta camYaw+1
mcNotRight

	lda keyB
	and #KB_W
	bne mcNotFwd
	lda #0
	sta dirNeg
	jsr mcWalk
mcNotFwd
	lda keyB
	and #KB_S
	bne mcNotBack
	lda #1
	sta dirNeg
	jsr mcWalk
mcNotBack
	lda keyD
	and #KD_Q
	bne mcNotStrafeL
	lda #1
	sta dirNeg
	jsr mcStrafe
mcNotStrafeL
	lda keyB
	and #KB_E
	bne mcNotStrafeR
	lda #0
	sta dirNeg
	jsr mcStrafe
mcNotStrafeR

	; Gravity. A constant downward term rather than an acceleration, and
	; unconditional: on the ground CLIP_MOVE's floor trace absorbs it, off
	; the ground it is the fall. Subtracted in 16.16, so the low word is
	; zero and only the top two bytes carry it.
	sec
	lda mov+CAM_Y+0
	sbc #<FALL_16
	sta mov+CAM_Y+0
	lda mov+CAM_Y+1
	sbc #>FALL_16
	sta mov+CAM_Y+1
	lda mov+CAM_Y+2
	sbc #0
	sta mov+CAM_Y+2
	lda mov+CAM_Y+3
	sbc #0
	sta mov+CAM_Y+3

	jmp clipMove

; ======================================================================
; CLIP_MOVE: the one command that answers where the player may actually go.
;
; Everything travels in clipBlk rather than the ARG registers -- a position
; and a displacement are 24 bytes on their own, and one DMA burst with a
; checksum over it is one chance to lose a byte where 24 register writes
; would be 24. The Pi writes only the block's second half, so a failed
; answer leaves the request intact and a retry is six register writes.
;
; So a failed answer is retried, up to CLIP_TRIES times, and only then
; allowed to do nothing: cam is unchanged, the player does not move for one
; frame at 25 frames a second, and N/M/S counts which way it failed. That is
; the whole error policy: this is a query, the C64 owns the position, and the
; next frame asks again from where it really is.
; ======================================================================
clipMove
	; start = the eye, which is what cam already is: CLIP_MODE_EYE means
	; the Pi does the 22-unit view-offset arithmetic on both sides.
	ldx #11
-	lda cam,x
	sta clipBlk,x
	lda mov,x
	sta clipBlk+12,x
	dex
	bpl -

	lda #CLIP_HULL_PLAYER
	sta clipBlk+CLIP_HULL
	lda #CLIP_MODE_WALK
	sta clipBlk+CLIP_MODE
	lda #0
	sta clipBlk+CLIP_MODEL		; the world
	lda #CLIP_IN_M
	sta clipBlk+CLIP_MAGIC

	; No movers: this demo walks the static world and opens no doors. The
	; count is still written explicitly, because the checksum covers it and
	; a byte nobody wrote is not reliably a zero.
	lda #0
	sta clipBlk+CLIP_MOVERS

	lda clipBlk+CLIP_MOVERS
	ldx #0
-	eor clipBlk,x
	inx
	cpx #CLIP_CHECK
	bne -
	sta clipBlk+CLIP_CHECK

	; Poison the answer, so that a writeback that never happened cannot be
	; read as a legal move. The magic test below is the one that catches
	; it; this is what makes the magic test unambiguous.
	ldx #CLIP_TRIES
	stx cmTry
cmSend
	lda #$a5
	ldx #CLIP_OUT
-	sta clipBlk,x
	inx
	cpx #CLIP_LEN
	bne -

	#argblob 0, SPACE_C64, clipBlk, CLIP_LEN
	lda #OP_CLIP_MOVE
	jsr cmd1
	sta clipErr

	; ERRCODE is a diagnostic here and never a verdict. It is one register
	; read, and a register read that fails hands back whatever was last on
	; the bus rather than an error (gpu64-errcode-ff-is-the-bus), so
	; treating a garbled read as a refusal throws away good answers --
	; which is how run 27 died. When the command really WAS refused the Pi
	; wrote nothing, the poison is still in place, and the magic test below
	; catches it anyway. docs/class1-3d-mesh-reference.md says exactly
	; this: check the block, not ERRCODE.
	cmp #0
	beq cmErrOK
	inc clipN
	bne cmErrOK
	inc clipN+1
cmErrOK
	lda clipBlk+CLIP_OMAGIC
	cmp #CLIP_OUT_M
	beq cmMagOK
	inc clipM
	bne cmAgain
	inc clipM+1
	jmp cmAgain
cmMagOK
	lda #0
	ldx #CLIP_OUT
-	eor clipBlk,x
	inx
	cpx #CLIP_OCHECK
	bne -
	cmp clipBlk+CLIP_OCHECK
	beq cmSumOK
	inc clipS
	bne cmAgain
	inc clipS+1
	jmp cmAgain
cmSumOK

	lda clipBlk+CLIP_OFLAGS
	sta clipFlags
	lda clipBlk+CLIP_OCONT
	sta clipCont
	lda clipBlk+CLIP_OFRAC
	sta clipFrac
	lda clipBlk+CLIP_OBUMPS
	sta clipBumps

	; Stuck in solid is not an answer to move to. It means the start was
	; already inside a wall, and the position the Pi hands back then is
	; the start -- copying it is harmless, but taking the frame's step
	; would be, so the flags row is left to say so and cam is left alone.
	lda clipFlags
	and #$10
	bne cmDone

	jsr cmBound
	bcs cmWild

	ldx #11
-	lda clipBlk+CLIP_OUT,x
	sta cam,x
	dex
	bpl -
cmDone
	rts

	; The Pi never touches the input half, so another try is the six
	; register writes of the descriptor plus the dispatch -- far cheaper
	; than a frame of standing still, and at run 37's fault rate the
	; second try is usually the one that lands. Only the poison has to be
	; laid down again, which is why cmSend is where it is.
cmAgain
	dec cmTry
	beq +
	jmp cmSend
+	rts
cmWild
	lda clipWild
	cmp #$ff
	beq +
	inc clipWild
+	rts

; ======================================================================
; Bound the answer by the question.
;
; An answer that passes its checksum and is still wrong is not a one-frame
; glitch. cam is authoritative, nothing in this program ever contradicts it,
; and a corrupted coordinate is therefore the rest of the session. That is
; what run 36 looked like: the eye 222 world units outside E1M1, y and z
; still exactly at the spawn, x $000F arriving as $FF0F -- one byte -- and
; the picture a level seen from the outside, with the player never having
; touched a key.
;
; An 8-bit XOR over seventeen bytes cannot prevent that on its own. It
; passes about one corrupted block in 256, and that run had the checksum
; reject 67 blocks in 345 frames, so one silent acceptance in a session is
; the expected outcome rather than bad luck. A wider checksum would only
; move the exponent.
;
; So this is a different KIND of check, not a stronger hash: a move cannot
; end further from where it started than the step that was asked for, plus
; the step-up the trace is allowed to add on its own. The question bounds
; the answer, and the bound is exact rather than probabilistic. Two world
; units of margin covers the step-up and the truncation in comparing only
; the integer halves; anything the bus does to a coordinate that matters
; moves it by hundreds.
;
; Carry clear = plausible, and cam may take it.
; ======================================================================
cmBound
	ldx #0
cbAxis
	; d = |end - start|, integer halves only
	sec
	lda clipBlk+CLIP_OUT+2,x
	sbc cam+2,x
	sta cbD0
	lda clipBlk+CLIP_OUT+3,x
	sbc cam+3,x
	sta cbD1
	bpl cbDPos
	sec
	lda #0
	sbc cbD0
	sta cbD0
	lda #0
	sbc cbD1
	sta cbD1
cbDPos
	; m = |delta| + POS_SLOP, the same halves
	lda mov+2,x
	sta cbM0
	lda mov+3,x
	sta cbM1
	bpl cbMPos
	sec
	lda #0
	sbc cbM0
	sta cbM0
	lda #0
	sbc cbM1
	sta cbM1
cbMPos
	clc
	lda cbM0
	adc #POS_SLOP
	sta cbM0
	lda cbM1
	adc #0
	sta cbM1

	; Reject when m < d. A d of $8000 cannot be negated and stays $8000,
	; which fails this compare -- the safe direction.
	lda cbM0
	cmp cbD0
	lda cbM1
	sbc cbD1
	bcc cbFail

	inx
	inx
	inx
	inx
	cpx #12
	bne cbAxis
	clc
	rts
cbFail
	sec
	rts

; The keyboard, read straight off the matrix. Active low throughout: a bit
; that is ZERO is a key that is DOWN, which is why every test here is `bne`
; to skip.
readKeys
	sei
	lda #$ff
	sta $dc02			; port A drives the columns
	lda #$00
	sta $dc03			; port B reads the rows

	lda #COL_B
	sta CIA_PRA
	lda CIA_PRB
	sta keyB
	lda #COL_C
	sta CIA_PRA
	lda CIA_PRB
	sta keyC
	lda #COL_D
	sta CIA_PRA
	lda CIA_PRB
	sta keyD

	lda #$ff			; leave it as the KERNAL expects
	sta CIA_PRA
	cli
	rts

; Forward is the camera's local +z, which for a camera with no pitch and no
; roll is (sin yaw, 0, cos yaw) in world axes -- the same two matrix entries
; gpu64_3dMatFromEuler() builds, m[2] and m[8]. Cos is sin a quarter turn
; on, so one table serves both.
mcWalk
	lda camYaw+1
	ldx #CAM_X
	jsr camAdd
	lda camYaw+1
	clc
	adc #64
	ldx #CAM_Z
	jmp camAdd

; Strafe right is local +x = (cos yaw, 0, -sin yaw). Only the z term carries
; the extra negation, so it is the only one that flips dirNeg.
mcStrafe
	lda camYaw+1
	clc
	adc #64
	ldx #CAM_X
	jsr camAdd
	lda dirNeg
	eor #1
	sta dirNeg
	lda camYaw+1
	ldx #CAM_Z
	jmp camAdd

; camAdd -- mov[X..X+3] += (dirNeg ? -1 : +1) * stepLo * sin(A), in 16.16.
;
;   A  sine table index, which is the top 8 bits of a 16-bit wire angle
;   X  CAM_X, CAM_Y or CAM_Z
;
; stepLo is 8.8 and the table is 8.8, so their product is already the 16.16
; the position is kept in: 26 (0.1 world units) times 256 (sin of a quarter
; turn) is 6656, and 6656/65536 is 0.1015625. Nothing is shifted afterwards
; and nothing is rounded away.
camAdd
	stx camOff
	tax
	lda sinLo,x
	sta mLo
	lda sinHi,x
	sta mHi

	; Combine the table's sign with the caller's direction and multiply
	; magnitudes. A signed multiply would not help: the table's range is
	; -256..+256, which does not fit a signed byte in either direction.
	ldy #0
	lda mHi
	bpl caPos
	iny
	lda #0
	sec
	sbc mLo
	sta mLo
	lda #0
	sbc mHi
	sta mHi
caPos
	tya
	eor dirNeg
	sta caNeg

	; 8-bit multiplier, 16-bit multiplicand, accumulator shifted right:
	; the 24-bit product lands in prod2:prod1:prod0. The accumulator never
	; exceeds 512, so the carry the ROR shifts in is the only one there is.
	lda #0
	sta prod0
	sta prod1
	sta prod2
	lda stepLo
	sta mult
	ldx #8
caMul
	lsr mult
	bcc caNoAdd
	clc
	lda prod1
	adc mLo
	sta prod1
	lda prod2
	adc mHi
	sta prod2
caNoAdd
	ror prod2
	ror prod1
	ror prod0
	dex
	bne caMul

	; Into mov, the displacement -- not into cam. Nothing in this program
	; writes cam except the answer CLIP_MOVE gives back.
	ldx camOff
	lda caNeg
	bne caSub
	clc
	lda mov+0,x
	adc prod0
	sta mov+0,x
	lda mov+1,x
	adc prod1
	sta mov+1,x
	lda mov+2,x
	adc prod2
	sta mov+2,x
	lda mov+3,x
	adc #0
	sta mov+3,x
	rts
caSub
	sec
	lda mov+0,x
	sbc prod0
	sta mov+0,x
	lda mov+1,x
	sbc prod1
	sta mov+1,x
	lda mov+2,x
	sbc prod2
	sta mov+2,x
	lda mov+3,x
	sbc #0
	sta mov+3,x
	rts

; Both halves of the camera, absolutely, every frame -- whether or not a key
; was pressed. The unconditional re-send IS the protocol: it costs eighteen
; register writes and buys a corruption lifetime of one frame.
sendCamera
	#id16 CAM_ID

	ldx #11
-	lda cam,x
	sta ARG,x
	dex
	bpl -
	lda #OP_SET_POSITION
	jsr cmd1
	sta posErr

	#argwv 0, camYaw
	#argw 2, 0
	#argw 4, 0
	lda #OP_SET_ORIENTATION
	jsr cmd1
	ora posErr
	sta posErr
	rts

; ======================================================================
; Pace on the loop. A commit issued before the last frame has finished
; answers BUSY and is thrown away; a program that commits flat out gets
; about four in five refused (gpu64-stage16-loop-verified). BOTH bits:
; FRAME_READY says core 1 has finished rendering, and BUSY says nothing has
; retired the flip the previous commit armed.
; ======================================================================
waitReady
	lda #<READY_WAIT
	sta waitCt
	lda #>READY_WAIT
	sta waitCt+1
wrPoll
	lda STATUS
	and #( ST_FRAME_READY | ST_BUSY )
	cmp #ST_FRAME_READY
	beq wrDone
	lda waitCt
	bne +
	dec waitCt+1
+	dec waitCt
	lda waitCt
	ora waitCt+1
	bne wrPoll

	; Gave up. The frame is committed anyway -- BUSY is a legitimate answer
	; and is counted -- but the stall itself is the reading, so keep the
	; first one's frame number. Sixteen bits: at 2000 polls every frame of
	; run 33 stalled and the byte this replaces saturated at FF, which
	; reads the same as "255 of 4096 frames" and meant something else
	; entirely.
	inc stalls
	bne +
	inc stalls+1
+
	lda stalls
	cmp #1
	bne wrDone
	lda stalls+1
	bne wrDone
	lda frames
	sta stallAt
	lda frames+1
	sta stallAt+1
wrDone
	rts

; ======================================================================
; The health sample. Four tries, and the block has to verify itself before
; any of it is believed -- see HB_LEN. hbBad counts the samples that never
; did, saturating, so a row of stale numbers says so instead of looking
; like a Pi that stopped changing.
; ======================================================================
doHealth
	lda #HB_EVERY
	sta hbWait

	; Latch the program's own commit count as of this sample, so the row
	; can print it beside the Pi's flip count. The two are the same number
	; seen from the two ends of the same protocol, and a reader comparing
	; them must not have to allow for the sixty-odd frames since.
	lda okFrames
	sta hbOkAt
	lda okFrames+1
	sta hbOkAt+1

	ldx #4
dhTry
	stx hbTry

	; Poison the trailer, not the body: the body is what the check bytes
	; are computed over, and zeroing it would make a block that never
	; arrived check out perfectly.
	lda #0
	sta healthBuf+HB_MAGIC
	sta healthBuf+HB_MAGIC+1
	sta healthBuf+HB_MAGIC+2
	sta healthBuf+HB_MAGIC+3

	#argblob 0, SPACE_C64, healthBuf, HB_LEN
	lda #OP_GET_HEALTH
	jsr cmdClass0
	bne dhRetry
	jsr hbCheck
	beq dhDone
dhRetry
	ldx hbTry
	dex
	bne dhTry
	lda hbBad
	cmp #255
	beq dhDone
	inc hbBad
dhDone
	rts

; A = 0 if the block arrived whole. The magic says a block arrived at all;
; the XOR catches a wrong byte and the sum catches a transposition the XOR
; is blind to.
hbCheck
	lda healthBuf+HB_MAGIC
	cmp #$47			; 'G'
	bne hcBad
	lda healthBuf+HB_MAGIC+1
	cmp #$36			; '6'
	bne hcBad
	lda #0
	sta hbXor
	sta hbSum
	ldx #0
hcSum
	lda healthBuf,x
	eor hbXor
	sta hbXor
	clc
	lda hbSum
	adc healthBuf,x
	sta hbSum
	inx
	cpx #HB_MAGIC+2
	bne hcSum
	lda hbXor
	cmp healthBuf+HB_MAGIC+2
	bne hcBad
	lda hbSum
	cmp healthBuf+HB_MAGIC+3
	bne hcBad
	lda #0
	rts
hcBad
	lda #$ff
	rts

; A = the core temperature in whole degrees. The block carries tenths, and
; a reader looking at a photograph wants 62 and not 026A.
hbTempC
	lda healthBuf+HB_TEMP
	sta tmpLo
	lda healthBuf+HB_TEMP+1
	sta tmpHi
	ldx #0
htLoop
	lda tmpLo
	sec
	sbc #10
	tay
	lda tmpHi
	sbc #0
	bcc htDone			; less than ten tenths left
	sty tmpLo
	sta tmpHi
	inx
	cpx #255
	bne htLoop
htDone
	txa
	rts

; ======================================================================
; The millisecond clock. See CIA2_* above for why it is a CIA timer pair
; and not the jiffy counter.
; ======================================================================

; Start timer A on a 1ms period and timer B counting its underflows. Both
; continuous, both force-loaded from their latches by bit 4, neither
; enabled as an interrupt source.
clkInit
	lda #<CLK_PERIOD
	sta CIA2_TALO
	lda #>CLK_PERIOD
	sta CIA2_TAHI
	lda #$ff
	sta CIA2_TBLO
	sta CIA2_TBHI
	lda #%00010001			; force load, continuous, start
	sta CIA2_CRA
	lda #%01010001			; + count timer A underflows
	sta CIA2_CRB
	; Both marks start here, so the first frame measures from the first
	; frame and not from whenever the counter happened to be reset.
	jsr clkNow
	lda msNow
	sta msMark
	sta msFrameMark
	lda msNow+1
	sta msMark+1
	sta msFrameMark+1
	rts

; msNow = timer B, read whole. High, low, high again: the counter ticks
; once a millisecond, so a read that straddles a borrow is rare and cheap
; to reject, and the alternative -- accepting it -- shows up as a 256ms
; frame that never happened.
clkNow
	lda CIA2_TBHI
	sta msNow+1
	lda CIA2_TBLO
	sta msNow
	lda CIA2_TBHI
	cmp msNow+1
	bne clkNow
	rts

; X = slot. Stores (now - msMark) in it, keeps the running maximum, and
; moves the mark to now, so consecutive calls carve a frame into phases
; with nothing unaccounted between them. Clamped to 255: a phase that long
; is off the scale either way, and three digits is what fits on the row.
clkLap
	jsr clkNow
	lda msMark			; counts down
	sec
	sbc msNow
	sta clkTmp
	lda msMark+1
	sbc msNow+1
	beq +
	lda #$ff
	sta clkTmp
+
	lda msNow
	sta msMark
	lda msNow+1
	sta msMark+1
	lda clkTmp
	sta msCur,x
	cmp msMax,x
	bcc +
	sta msMax,x
+
	rts

; The frame period, measured start to start, and the one reading here that
; is not a phase: it includes whatever the loop spends outside the four
; phases as well. Re-marks BOTH clocks, so the first phase of the new frame
; starts where the period does.
clkFrame
	jsr clkNow
	lda msFrameMark
	sec
	sbc msNow
	sta clkTmp
	lda msFrameMark+1
	sbc msNow+1
	beq +
	lda #$ff
	sta clkTmp
+
	lda msNow
	sta msMark
	sta msFrameMark
	lda msNow+1
	sta msMark+1
	sta msFrameMark+1
	ldx #MS_PER
	lda clkTmp
	sta msCur,x
	cmp msMax,x
	bcc +
	sta msMax,x
+
	cmp msPerMin
	bcs +
	sta msPerMin
+
	rts

; ======================================================================
; One class 1 command. The ERRCODE range test and the eight retries are the
; run 27 lesson: an unreadable answer is NOT a failed command, and a single
; garbage byte turned into a control-flow decision cost a whole bench run.
; ======================================================================
;
; cmdClass0 is the same machinery aimed at class 0, for the one class 0 opcode
; this program sends. It shares every retry with cmd1 because the argument for
; them is about the register window, not about the class. (Not "cmd0": that is
; a macro in gpu64.inc, and a label shadowing it assembles into a very
; confusing error somewhere else entirely.)
cmdClass0
	ldx #0
	stx CMD_HI
	jmp cEntry
cmd1
	ldx #1
	stx CMD_HI
cEntry
	sta CMD_LO
	lda ERRCODE
	cmp #$0d			; the valid codes run $00-$0C
	bcc c1Done
	ldx #7
c1ReRead
	lda ERRCODE
	cmp #$0d
	bcc c1Done
	dex
	bne c1ReRead
	inc errBad
	bne +
	inc errBad+1
+	lda #0				; report OK: the reply was lost, not the command
c1Done
	; Flags from the RETURN VALUE, not from the range test. Without this the
	; Z flag a caller branches on is whatever `cmp #$0d` left behind -- which
	; for a perfectly good ERRCODE of 0 is Z CLEAR, so every `beq` on a
	; successful command falls through into its own error path. Caught on a
	; PC before the bench, which is what tools/prgsim is for.
	cmp #0
	rts

; The same with a sequence number, which is the only detector there is for
; a CMD_LO or SEQ write the polling loop did not sample. Leaves the answer
; in seqErr and the verdict in seqMiss (0 = the command was seen).
cmdSeq1
	sta seqOp
	inc dispCt
	bne +
	inc dispCt+1
	bne +
	inc dispCt+2
+
	; Never 0 and never $FF: 0 would let an unwritten SEQACK read as a
	; match, $FF would let a dropped READ of SEQACK -- which returns a
	; floating $FF -- read as one.
	inc seqCounter
	lda seqCounter
	beq csWrap
	cmp #$ff
	bne csSeqOk
csWrap	lda #1
	sta seqCounter
csSeqOk
	lda seqCounter
	sta SEQ
	lda seqOp
	jsr cmd1
	sta seqErr

	lda SEQACK
	cmp seqCounter
	beq csOk
	; Read it again. SEQACK is a plain latch and the command finished long
	; before the first read returned, so a second read that agrees proves
	; the READ was the failure and the firmware was right all along.
	lda SEQACK
	cmp seqCounter
	beq csOk
	inc missed
	bne +
	inc missed+1
+	lda #1
	sta seqMiss
	rts
csOk
	lda #0
	sta seqMiss
	rts

; ======================================================================
; The display. Four rows, all of them printed every frame -- run 18 froze
; at frame 256 and returned nothing because its rows were printed only at
; finish, and a blank row is not a zero.
; ======================================================================
showFrame
	; Row 4: where this program believes the camera is. The three integer
	; world coordinates and the top byte of the heading, which is also the
	; sine table index the step was taken with.
	;
	; All three coordinates now come back from CLIP_MOVE, so Y is no longer
	; the fixed reference an earlier version of this program could check a
	; corrupted register write against -- row 13 and the block's own
	; checksum are what watch the move instead. What Y still says at a
	; glance is whether the player is standing on something: in E1M1's
	; first room the eye sits near 0070, and a Y falling without bound is
	; the floor trace failing. Printed as the integer part only: bench
	; telemetry is read off a photograph of a CRT, and a reader who has to
	; subtract two numbers to reach a verdict will not.
	lda #4
	jsr dmRow
	jsr dmText
	.text "CAM X"
	.byte 0
	lda cam+CAM_X+3
	jsr dmHexA
	lda cam+CAM_X+2
	jsr dmHexA
	jsr dmText
	.text " Y"
	.byte 0
	lda cam+CAM_Y+3
	jsr dmHexA
	lda cam+CAM_Y+2
	jsr dmHexA
	jsr dmText
	.text " Z"
	.byte 0
	lda cam+CAM_Z+3
	jsr dmHexA
	lda cam+CAM_Z+2
	jsr dmHexA
	jsr dmText
	.text " YAW"
	.byte 0
	lda camYaw+1
	jsr dmHexA
	jsr dmText
	.text " P"
	.byte 0
	lda posErr
	jsr dmHexA

	lda #5
	jsr dmRow
	jsr dmText
	.text "FRAMES  "
	.byte 0
	lda frames+1
	jsr dmHexA
	lda frames
	jsr dmHexA
	jsr dmText
	.text "  OK "
	.byte 0
	lda okFrames+1
	jsr dmHexA
	lda okFrames
	jsr dmHexA

	lda #6
	jsr dmRow
	jsr dmText
	.text "CMT  07 "
	.byte 0
	lda e07+1
	jsr dmHexA
	lda e07
	jsr dmHexA
	jsr dmText
	.text "  06 "
	.byte 0
	lda e06+1
	jsr dmHexA
	lda e06
	jsr dmHexA
	jsr dmText
	.text "  XX "
	.byte 0
	lda eXX+1
	jsr dmHexA
	lda eXX
	jsr dmHexA
	jsr dmText
	.text " "
	.byte 0
	lda xxCode
	jsr dmHexA

	lda #7
	jsr dmRow
	jsr dmText
	.text "MISSED  "
	.byte 0
	lda missed+1
	jsr dmHexA
	lda missed
	jsr dmHexA
	jsr dmText
	.text "  DISP "
	.byte 0
	lda dispCt+2
	jsr dmHexA
	lda dispCt+1
	jsr dmHexA
	lda dispCt
	jsr dmHexA

	lda #8
	jsr dmRow
	jsr dmText
	.text "STALLS  "
	.byte 0
	lda stalls+1
	jsr dmHexA
	lda stalls
	jsr dmHexA
	jsr dmText
	.text "  AT "
	.byte 0
	lda stallAt+1
	jsr dmHexA
	lda stallAt
	jsr dmHexA
	jsr dmText
	.text "  ERRBAD "
	.byte 0
	lda errBad+1
	jsr dmHexA
	lda errBad
	jsr dmHexA

	; Rows 9 and 10: where a frame's time goes, in milliseconds off CIA2.
	; Decimal, because the question these answer is "how many frames a
	; second" and the reader has a photograph, not a calculator.
	;
	; Row 9 is the frame period: 1000/CUR is the rate the player is
	; actually getting, and MIN against MAX is the steadiness they
	; complained about. Row 10 splits the worst frame into its phases, so
	; a large period names its own cause -- WAIT is core 1 rendering,
	; CMT is core 1 rendering with the C64 halted, CAM is the command
	; path, DISP is these two rows costing more than they are worth.
	;
	; The DISP figure is one frame behind by construction: it is measured
	; after this routine returns.
	lda #9
	jsr dmRow
	jsr dmText
	.text "MS/FRAME  CUR "
	.byte 0
	lda msCur+MS_PER
	jsr dmDecA
	jsr dmText
	.text "  MIN "
	.byte 0
	lda msPerMin
	jsr dmDecA
	jsr dmText
	.text "  MAX "
	.byte 0
	lda msMax+MS_PER
	jsr dmDecA

	lda #10
	jsr dmRow
	jsr dmText
	.text "MS MAX  CAM "
	.byte 0
	lda msMax+MS_CAM
	jsr dmDecA
	jsr dmText
	.text " WAIT "
	.byte 0
	lda msMax+MS_WAIT
	jsr dmDecA
	jsr dmText
	.text " CMT "
	.byte 0
	lda msMax+MS_CMT
	jsr dmDecA
	jsr dmText
	.text " D "
	.byte 0
	lda msMax+MS_DISP
	jsr dmDecA

	; Rows 11 and 12: the Pi's own account of itself, resampled every
	; HB_EVERY frames.
	;
	; PWR is the throttle word latched since this program started, in hex
	; because it is a bit field: 0000 is the healthy reading and bit 0 or
	; bit 16 set is a power verdict, not a hint. BAD counts health samples
	; that failed to verify -- without it a frozen row reads as a Pi whose
	; numbers stopped changing.
	;
	; FLIP is what the Pi thinks it presented and OK is what this program
	; thinks it asked for, both as of the same sample. They are the two
	; ends of one count, and only one of them is the picture. SLOW and DTO
	; are the flip path's two pathologies (Source/Firmware/gpu64_flip.h);
	; both should be 0000.
	lda #11
	jsr dmRow
	jsr dmText
	.text "PWR "
	.byte 0
	lda healthBuf+HB_PWR+1
	jsr dmHexA
	lda healthBuf+HB_PWR
	jsr dmHexA
	jsr dmText
	.text "  HOT "
	.byte 0
	jsr hbTempC
	jsr dmDecA
	jsr dmText
	.text "  HB "
	.byte 0
	lda msMax+MS_HB
	jsr dmDecA
	jsr dmText
	.text "  BAD "
	.byte 0
	lda hbBad
	jsr dmDecA

	lda #12
	jsr dmRow
	jsr dmText
	.text "FLIP "
	.byte 0
	lda healthBuf+HB_FLIPS+1
	jsr dmHexA
	lda healthBuf+HB_FLIPS
	jsr dmHexA
	jsr dmText
	.text " OK "
	.byte 0
	lda hbOkAt+1
	jsr dmHexA
	lda hbOkAt
	jsr dmHexA
	jsr dmText
	.text " SLOW "
	.byte 0
	lda healthBuf+HB_SLOW+1
	jsr dmHexA
	lda healthBuf+HB_SLOW
	jsr dmHexA
	jsr dmText
	.text " DTO "
	.byte 0
	lda healthBuf+HB_DTO+1
	jsr dmHexA
	lda healthBuf+HB_DTO
	jsr dmHexA

	; Row 13: the collision answer, and then four separate ways it can go
	; wrong. F 01 is standing on ground, which is what walking looks like;
	; 02 means the step hit a wall and slid along it; 08 means it climbed
	; something; 10 means the eye started inside solid and the move was
	; refused. FR is how much of the requested step was actually covered,
	; out of FF. E is the LAST ERRCODE, a diagnostic only -- see clipMove.
	;
	; The four counters are deliberately not one number. Run 37 printed a
	; single BAD of 1072 frames in 1753 and that number could not say which
	; direction the bytes were being lost in, which is the only thing worth
	; knowing:
	;   N  attempts whose ERRCODE came back non-zero. The Pi rejected the
	;      INPUT block, so a byte we wrote never arrived.
	;   M  attempts whose output magic was wrong. The Pi's writeback never
	;      landed at all, or landed somewhere else.
	;   S  attempts whose output checksum was wrong but magic was right.
	;      The writeback landed and arrived damaged.
	;   W  answers that passed magic AND checksum and were still refused,
	;      because they put the player further away than the step asked
	;      for. This is the bus getting past both channel checks, and one
	;      of these uncaught is a permanently wrong position (run 36).
	; N M S all retry, so they cost a frame's precision, not the frame.
	lda #13
	jsr dmRow
	jsr dmText
	.text "CLIP F"
	.byte 0
	lda clipFlags
	jsr dmHexA
	jsr dmText
	.text " FR"
	.byte 0
	lda clipFrac
	jsr dmHexA
	jsr dmText
	.text " E"
	.byte 0
	lda clipErr
	jsr dmHexA
	jsr dmText
	.text " N"
	.byte 0
	lda clipN+1
	jsr dmHexA
	lda clipN
	jsr dmHexA
	jsr dmText
	.text " M"
	.byte 0
	lda clipM+1
	jsr dmHexA
	lda clipM
	jsr dmHexA
	jsr dmText
	.text " S"
	.byte 0
	lda clipS+1
	jsr dmHexA
	lda clipS
	jsr dmHexA
	jsr dmText
	.text " W"
	.byte 0
	lda clipWild
	jsr dmHexA
	rts

; The load's verdict, which is the whole reading if the level never built.
; Prints the ERRCODE and the item number RESULT carries -- the loader stamps
; the failing item there, so a failure names its address and not just its
; kind.
showLoadErr
	lda #2
	jsr dmRow
	jsr dmText
	.text "LOAD    FAILED ERR "
	.byte 0
	lda loadErr
	ora stepErr
	jsr dmHexA
	jsr dmText
	.text " AT PCT "
	.byte 0
	lda stepPct
	jsr dmHexA
	jsr dmText
	.text " ITEM "
	.byte 0
	lda RESULT
	jsr dmHexA

	lda #3
	jsr dmRow
	jsr dmText
	.text "04 USUALLY MEANS NO RAD/LEVEL.G64LEV"
	.byte 0
	rts

; ----------------------------------------------------------------------
vpErr		.byte 0
perErr		.byte 0
resErr		.byte 0
camErr		.byte 0
loopErr		.byte 0
loadErr		.byte 0
stepErr		.byte 0
stepPct		.byte 0
stepCt		.word 0
stopTry		.byte 0

frames		.word 0
okFrames	.word 0
e06		.word 0
e07		.word 0
eXX		.word 0
xxCode		.byte 0
missed		.word 0
errBad		.word 0
dispCt		.byte 0, 0, 0
stalls		.word 0
stallAt		.word 0
waitCt		.word 0

; The clock's state. msCur/msMax are indexed by the MS_* slots.
msNow		.word 0
msMark		.word 0
msFrameMark	.word 0
clkTmp		.byte 0
msCur		.fill MS_SLOTS, 0
msMax		.fill MS_SLOTS, 0
msPerMin	.byte $ff
dispWait	.byte 1

hbWait		.byte 1
hbOkAt		.word 0
hbTry		.byte 0
hbBad		.byte 0
hbXor		.byte 0
hbSum		.byte 0
tmpLo		.byte 0
tmpHi		.byte 0

seqCounter	.byte 0
seqOp		.byte 0
seqErr		.byte 0
seqMiss		.byte 0
keyB		.byte 0
keyC		.byte 0
keyD		.byte 0
stepLo		.byte 0

; ----------------------------------------------------------------------
; The camera this program owns. Twelve bytes in exactly the order
; SET_POSITION reads them -- x, y, z as signed 16.16 world units -- so
; sending it is a copy loop and never a rearrangement.
; ----------------------------------------------------------------------
cam		.fill 12, 0
camYaw		.word 0

; Where the Pi's two readbacks land: GET_HEALTH's block and the starting
; pose GET_TRANSFORM hands back. Adjacent, and in this order, because one
; SET_DMA_WINDOW covers both -- see DMA_LEN. A dropped ARG byte can still
; corrupt the destination address; what it can no longer do is aim the
; writeback at this program's code.
healthBuf	.fill HB_LEN, 0
camBuf		.fill CAM_BUF_LEN, 0
clipBlk		.fill CLIP_LEN, 0

; The displacement this frame asks CLIP_MOVE for: twelve bytes in the same
; x, y, z 16.16 order as cam, because camAdd accumulates into it with the
; same CAM_X/CAM_Y/CAM_Z offsets.
mov		.fill 12, 0

; CLIP_MOVE's last answer, kept for row 13. clipCont and clipBumps are read
; out of the block but no longer printed: row 13 has to fit in 40 columns and
; the four rejection counters below earned those columns off run 37.
clipFlags	.byte 0
clipCont	.byte 0
clipFrac	.byte 0
clipBumps	.byte 0
clipErr		.byte 0

; Why the answer was refused, split three ways, because the three have
; nothing to do with each other. N is a non-zero ERRCODE: the Pi rejected
; what we sent, or the ERRCODE read itself was garbled. M is a bad output
; magic: the writeback never landed and the poison is still there. S is a
; bad output checksum: the writeback landed corrupted. One lumped counter
; said 61% of frames failed and could not say which way the bytes were
; going.
clipN		.word 0
clipM		.word 0
clipS		.word 0
cmTry		.byte 0

; clipWild counts the answers that passed magic and checksum and were still
; refused, because they put the eye further from the start than the step
; asked for. Distinct from N/M/S on purpose: those three are the bus being
; caught by a channel check, clipWild is the bus getting past both of them
; and being caught by what the answer MEANS instead.
clipWild	.byte 0
cbD0		.byte 0
cbD1		.byte 0
cbM0		.byte 0
cbM1		.byte 0

; camAdd's workspace.
mLo		.byte 0
mHi		.byte 0
mult		.byte 0
prod0		.byte 0
prod1		.byte 0
prod2		.byte 0
dirNeg		.byte 0
caNeg		.byte 0
camOff		.byte 0

; Verdicts. posErr is the per-frame camera send and belongs on row 4;
; getErr and the fence belong to setup and are printed on row 3.
posErr		.byte 0
getErr		.byte 0
getTry		.byte 0
fenceErr	.byte 0
fenceTry	.byte 0
fenceEcho	.byte 0

; ----------------------------------------------------------------------
; sin(a) as 8.8, 256 entries over a full turn: the whole reason the camera
; can live on the C64. The index is the TOP byte of the 16-bit wire angle,
; which makes the truncation from 65536 steps to 256 a shift and the wrap
; free.
;
; The range is -256..+256 inclusive, so it does not fit in a byte and the
; table is two. That is also why camAdd multiplies magnitudes and carries
; the sign separately: a signed 8-bit multiply has nowhere to put sin(64).
;
; 64tass evaluates sin() and round() at assembly time, so this costs 512
; bytes of PRG and no code.
; ----------------------------------------------------------------------
sinLo
	.for i = 0, i < 256, i += 1
	.byte <(round(sin(i * 2 * pi / 256) * 256))
	.next
sinHi
	.for i = 0, i < 256, i += 1
	.byte >(round(sin(i * 2 * pi / 256) * 256))
	.next

	.include "gpu64_rt.inc"
