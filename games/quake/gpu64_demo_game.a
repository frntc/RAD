; ----------------------------------------------------------------------
; sin(a) as 8.8, 256 entries over a full turn: the whole reason the camera
; can live on the C64. The index is the TOP byte of the 16-bit wire angle,
; which makes the truncation from 65536 steps to 256 a shift and the wrap
; free.
;
; The range is -256..+256 inclusive, so it does not fit in a byte and the
; table is two. That is also why camAdd multiplies magnitudes and carries
; the sign separately: a signed 8-bit multiply has nowhere to put sin(64).
;
; 64tass evaluates sin() and round() at assembly time, so this costs 512
; bytes of PRG and no code.
; ----------------------------------------------------------------------
sinLo
	.for i = 0, i < 256, i += 1
	.byte <(round(sin(i * 2 * pi / 256) * 256))
	.next
sinHi
	.for i = 0, i < 256, i += 1
	.byte >(round(sin(i * 2 * pi / 256) * 256))
	.next

	.include "gpu64_rt.inc"

; ----------------------------------------------------------------------
; Past the code: E-Quake tune 1, relocated to $a000 by tools/sidreloc.py
; so it sits under BASIC, and the RLE-packed HONDANI logo (tools/hondani.py).
; The one tune plays on the title and at the intermission. The PRG loads
; contiguously up to the logo's end; the logo unpacks into VIC bank 3
; ($cc00 / $e000), which nothing else uses. The tune's .bin carries a
; two-byte load address, skipped here.
; ----------------------------------------------------------------------
	.cerror * > $a000, "the game's code has grown into the tune at $a000"
	* = TUNE_INIT
	.binary "gpu64_tune.bin", 2	; E-Quake tune 1, init $a000
	.cerror * > LOGO_RLE
	* = LOGO_RLE
	.binary "gpu64_hondani.bin"
	; The controls menu and the key remap, also under BASIC -- which is
	; banked out from `title` to `finish`, the only span that calls them.
	.include "gpu64_game_controls.inc"
	.include "gpu64_game_pause.inc"
	; Moved out of the main block when MAX_TRG went 32 -> 48 for E1M4, and
	; out of the PRG altogether for the monsters' missiles: every entry is
	; written by the level scan before anything reads it, and nothing reads
	; them outside the frame loop, so they live on the logo's screen, which
	; only the title shows -- and the title is always followed by a scan.
	; The movers' travel fractions, which only the level scan writes, live
	; in the cassette buffer: nothing in this game touches tape.
	.virtual $0334
mvTX0		.fill MAX_MOV, 0
mvTY0		.fill MAX_MOV, 0
mvTZ0		.fill MAX_MOV, 0
	.cerror * > $0400, "the cassette buffer's tenants outgrew it"
	.endv
	.virtual LOGO_SCREEN
; A trigger volume is a box, a target and whether it has already gone off.
trKind		.fill MAX_TRG, 0
trDest		.fill MAX_TRG, 0	; trigger_changelevel: E1Mn as n, 0 = end of episode
trTgL		.fill MAX_TRG, 0
trTgH		.fill MAX_TRG, 0
trFired		.fill MAX_TRG, 0
trMnXl		.fill MAX_TRG, 0
trMnXh		.fill MAX_TRG, 0
trMnYl		.fill MAX_TRG, 0
trMnYh		.fill MAX_TRG, 0
trMnZl		.fill MAX_TRG, 0
trMnZh		.fill MAX_TRG, 0
trMxXl		.fill MAX_TRG, 0
trMxXh		.fill MAX_TRG, 0
trMxYl		.fill MAX_TRG, 0
trMxYh		.fill MAX_TRG, 0
trMxZl		.fill MAX_TRG, 0
trMxZh		.fill MAX_TRG, 0
; A working teleport's destination: the eye in fine units, axis by axis
; (X, Y, Z) and then its yaw, MAX_TEL apart. trDest holds slot + 1.
nTel		.byte 0
tpL		.fill 4 * MAX_TEL, 0
tpH		.fill 4 * MAX_TEL, 0
PJ_VARS					; gpu64_game_proj.inc's state, likewise
	.endv
