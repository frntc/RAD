;       {_______            {_          {______
;             {__          {_ __               {__
;             {__         {_  {__               {__
;          {__           {__   {__               {__
;      {______          {__     {__              {__
;            {__       {__       {__            {__
;              {_________         {______________		Expansion Unit
;
;      gpu64 -- DRAW_POLYS: a level a Doom renderer cannot draw at all.
;
;      WHAT THIS DEMONSTRATES
;
;      gpu64_demo_sectors draws a level of vertical walls standing between
;      horizontal floors, because that is everything DRAW_SECTORS can
;      express. This program draws the three things it cannot:
;
;        * a RAMP -- a sloped surface you walk up, which is neither a wall
;          nor a flat and has no representation in a sector at all
;        * a BRIDGE across the room, with a walkway on top and an
;          underside below, so there is floor above floor: the geometry
;          that made Quake a different renderer and not a faster Doom.
;          The player walks under it at the start of his lap and looks
;          back down onto it from the top of the ramp
;        * MONSTERS with a FRONT AND A BACK -- a DRAW_THINGS record may
;          name eight consecutive textures and the direction the thing
;          faces, and gpu64 works out which of the eight you are looking
;          at from where you are standing. Walk round one and it turns.
;          The batch is projected through SET_CAMERA3D, so the same
;          billboards a Doom level uses stand in a Quake one, depth-tested
;          against its faces: the one under the bridge is hidden by the
;          slab until you walk out from under it
;        * real PITCH -- the camera looks up and down by rotating, so the
;          walls converge as you tilt. SET_CAMERA's horizon shears the
;          picture instead, which is exact for vertical walls and wrong for
;          everything here
;
;      WHAT THE 6502 DOES PER FRAME
;
;      Four reads of the keyboard matrix, two table lookups and two 16-bit
;      adds for the walk, one shift for the height of the ramp under his
;      feet, twelve bytes of camera, and one batch command. The
;      level -- 16 faces, 62 vertices and 3 texinfos -- is uploaded once at
;      start-up and never touched again; the projection, the clipping, the
;      perspective texture mapping and the depth sorting are all gpu64's.
;
;      THE PART THAT IS EASY TO MISS
;
;      Nothing here is sorted, and there is no BSP tree. The faces are sent
;      in the order they were written down, which for the bridge means its
;      underside arrives before the floor it hangs over. Every pixel is
;      depth-tested against the same buffer DRAW_SECTORS and DRAW_THINGS
;      use, so the order simply does not matter -- which is the whole
;      reason a 1 MHz CPU can drive this.
;
;      The face batch is a few hundred bytes of unchanging data, so
;      R2_BATCH_SUM is free: it is computed once at start-up and every byte is
;      verified on arrival on every frame.
;
;      THE CONTROLS
;
;        W / S     walk forward and back
;        A / D     turn left and right
;        Q / E     strafe left and right
;        F1 / F3   look up and down, F7 centres
;        SPACE     fire -- a muzzle flash that lights the room
;        RUN/STOP  quit
;
;      The player is free in the room now rather than walking a fixed lap,
;      which is what makes the eight-view monsters worth having: you can
;      get behind one.
;
;      Run it: LOAD"GPU64-QUAKE",8,1 then RUN. RUN/STOP finishes.
;
;      Copyright (c) 2026 Honza Slesinger
;
;      This program is free software: you can redistribute it and/or modify
;      it under the terms of the GNU General Public License as published by
;      the Free Software Foundation, either version 3 of the License, or
;      (at your option) any later version.
;

	.include "gpu64.inc"

VIEW_H	= 160			; the 3D view; the status bar is below it
TEXW	= 32
TEXH	= 32			; a power of two -- and for DRAW_POLYS the
TEXLEN	= TEXW * TEXH		; width must be one too: both are masked

TEX_BRICK = 1
TEX_STONE = 2
TEX_GUN	  = 3
TEX_MON	  = 4

CMAP_LEVELS = 16

; --- the level, in world units (8.8, so 1.0 = $0100) -------------------
; The room is 10 x 10 x 3. The ramp climbs from x=6 to x=9 across the
; middle four units of it, and a bridge crosses the whole width at x=2..4,
; low enough to walk under and low enough to look down on from the top of
; the ramp -- floor above floor, seen from both sides of it.
WU	.function n
	.endf n * 256

Z_TOP	= 3 * 256		; the ceiling
Z_RAMP	= 384			; 1.5 -- the top of the ramp and the platform
Z_SLABB	= 256			; 1.0  -- the underside of the bridge
Z_SLABT	= 320			; 1.25 -- the walkway on top of it

RAMP_X0	= 6 * 256
EYE_UP	= $0080			; the eye, half a unit above whatever he is on
PROJ	= $a000			; 160.0 pixels: a 90-degree field of view
SKY_COL	= 2*32+6		; what shows where nothing was drawn

; Where he may stand: half a unit clear of every wall, and off the sides
; of the ramp the floor is flat again.
X_LO	= $0080			; 0.5
X_HI	= $0980			; 9.5
Y_LO	= $fb80			; -4.5
Y_HI	= $0480			; 4.5
START_X	= 384			; 1.5 -- under the bridge, looking up the room

TURN	= 3			; binary degrees a frame, 256 to the circle
PITCH_LIM = 48			; and how far he may crane his neck

; The keyboard matrix: a column written to $dc00 and the rows read back
; from $dc01, both active low. Four columns carry every key this program
; uses, so a frame's input is four writes and four reads.
CIA_PRA	= $dc00
CIA_PRB	= $dc01
COL_A	= %11111110		; F7, F1, F3
COL_B	= %11111101		; W, A, S, E
COL_C	= %11111011		; D
COL_D	= %01111111		; Q, RUN/STOP
KA_F7	= $08
KA_F1	= $10
KA_F3	= $20
KB_W	= $02
KB_A	= $04
KB_S	= $20
KB_E	= $40
KC_D	= $04
KD_Q	= $40
KD_SPC	= $10
KD_STOP	= $80

; Milestone 12: the two dynamic lights. Slot 1 is the torch on the far
; wall, slot 0 the muzzle flash at the player's own eye. A light reaches
; TORCH_R/FLASH_R world units and its strength is how many colormap
; levels it lifts a pixel at its centre -- of sixteen, so six is a lot.
TORCH_X	= 8 * 256
TORCH_Y	= 0
TORCH_Z	= Z_RAMP
TORCH_R	= $0500			; 5.0 world units of reach
FLASH_R	= $0600			; 6.0 -- the flash has to reach the far
				; wall of a room this size, not just the
				; floor at his feet
FLASH_N	= 10			; frames a shot stays lit

; Zero page. $f7-$fe is the RS232 area every gpu64 program uses.
posX	= $f7			; the player, 8.8 world units
posY	= $f9			; -- kept next to posX so one routine adds
eyeZ	= $fb			;    a signed step to either of them

	#basicStub

; ======================================================================
; Start-up
; ======================================================================
start
	jsr dmInit

	#argb 0, BLACK
	#cmd OP_SET_BORDER
	#argb 0, BLACK
	#cmd OP_CLEAR

	; The palette: 8 hues x 32 brightnesses, so a colormap can darken by
	; walking down a hue. PAL_LOAD's count is a byte, so 256 entries take
	; two calls.
	#argblob 0, SPACE_C64, palData, 128*3
	#argb 6, 0
	#argb 7, 128
	#cmd OP_PAL_LOAD
	#argblob 0, SPACE_C64, palData+128*3, 128*3
	#argb 6, 128
	#argb 7, 128
	#cmd OP_PAL_LOAD

	lda #2
	sta CMD_HI
	#cmd R2_RESET

	#argw 0, 0
	#argw 2, 0
	#argw 4, FB_W
	#argw 6, VIEW_H
	#cmd R2_SET_VIEW

	#argblob 0, SPACE_C64, brickTex, TEXLEN
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #TEX_BRICK
	sta ID_LO
	lda #0
	sta ID_HI
	#cmd R2_UPLOAD_TEX

	#argblob 0, SPACE_C64, stoneTex, TEXLEN
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #TEX_STONE
	sta ID_LO
	#cmd R2_UPLOAD_TEX

	#argblob 0, SPACE_C64, gunTex, TEXLEN
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	lda #TEX_GUN
	sta ID_LO
	#cmd R2_UPLOAD_TEX

	; Eight views of the monster, at TEX_MON .. TEX_MON+7. A DIRECTIONAL
	; thing names only the first of them; gpu64 picks which one to draw.
	; TEXLEN is 1024, so each view starts four pages on from the last and
	; the blob's address is one add.
	ldx #0
mtUpload
	lda #SPACE_C64
	sta ARG+0
	lda #<monTex
	sta ARG+1
	txa
	asl a
	asl a
	clc
	adc #>monTex
	sta ARG+2
	lda #0
	sta ARG+3
	#argw 4, TEXLEN
	#argw 6, TEXW
	#argw 8, TEXH
	#argb 10, 0
	txa
	clc
	adc #TEX_MON
	sta ID_LO
	lda #0
	sta ID_HI
	#cmd2 R2_UPLOAD_TEX
	inx
	cpx #8
	bne mtUpload

	; 16 light levels. A face carries a base level and gpu64 adds half
	; the distance to it, so the far end of the room darkens by itself.
	#argblob 0, SPACE_C64, cmapData, CMAP_LEVELS*256
	#argb 6, CMAP_LEVELS
	#cmd R2_SET_COLORMAP

	; The level. Both tables are as static as the faces that index them,
	; so both are uploaded once and never sent again.
	#r2verts vertTab, NVERT
	#cmd2 R2_UPLOAD_VERTS
	lda ERRCODE
	sta upV
	#r2texinfo texinfoTab, NTI
	#cmd2 R2_UPLOAD_TEXINFO
	lda ERRCODE
	sta upT

	; And the faces themselves. This is milestone 13: the level goes to
	; gpu64 once, here, and a frame afterwards names a range of it. The
	; batch this replaced was 256 bytes down the bulk transfer path
	; sixty times a second, which is the one thing that does not scale
	; to a real level.
	#r2world faces, NFACES
	#cmd2 R2_UPLOAD_POLYS
	lda ERRCODE
	sta upP

	lda #<START_X
	sta posX
	lda #>START_X
	sta posX+1
	lda #0
	sta posY
	sta posY+1
	jsr eyeHeight

; ======================================================================
; A frame
; ======================================================================
frame
	; 1. Where he is and where he is looking. Twelve bytes, of which
	;    five change.
	lda posX
	sta ARG+0
	lda posX+1
	sta ARG+1
	lda posY			; and now he goes where he likes
	sta ARG+2
	lda posY+1
	sta ARG+3
	lda eyeZ
	sta ARG+4
	lda eyeZ+1
	sta ARG+5
	lda plYaw
	sta ARG+6
	lda plPitch
	sta ARG+7
	#argw 8, PROJ
	#argb 10, 0
	#cmd2 R2_SET_CAMERA3D

	; 1b. The dynamic lights. They are set after the camera and before
	;     anything is drawn, because a light applies to every batch that
	;     follows it -- the walls below and the monsters after them.
	jsr sendLights

	; 2. FILL_VIEW is not only the background: it is also what empties
	;    the depth buffer. DRAW_POLYS does not clear it -- a frame may be
	;    several batches, and a batch that cleared would erase the one
	;    before it -- so this is the op the frame has to start with.
	#argb 0, SKY_COL
	#cmd2 R2_FILL_VIEW

	; 3. The level, in the order it was written down -- and no longer
	;    sent: it is resident, and this is ten register writes naming
	;    all of it. Several ranges here is how a real level would do
	;    crude visibility, one command per room.
	#r2drawworld 0, NFACES
	#cmd2 R2_DRAW_WORLD
	lda ERRCODE
	beq +
	sta lastW
	inc wErr
	bne +
	inc wErr+1
+

	; 3b. The monsters. Screen-upright billboards in the world, in the
	;     same depth buffer the faces went into, so the one standing
	;     under the bridge is cut off by the slab from every angle that
	;     ought to cut it off -- and nothing here had to be sorted
	;     against the geometry either.
	;
	;     R2_BATCH_CAM3D is the whole of what milestone 10 added: without
	;     it this batch would project through SET_CAMERA, which this
	;     program never sends.
	#r2batch monsters, NMON, R2_BATCH_CAM3D
	#cmd2 R2_DRAW_THINGS
	lda ERRCODE
	beq +
	sta lastT
	inc tErr
	bne +
	inc tErr+1
+

	#argblob 0, SPACE_C64, statBuf, 16
	#cmd2 R2_STATS

	; 4. The weapon. Still a DRAW_SPRITE: it is at a screen position, not
	;    a world one, and nothing in the world may ever occlude it.
	lda frameCt
	lsr a
	lsr a
	and #$03
	clc
	adc #64
	sta sprY
	#argw 0, 112
	lda sprY
	sta ARG+2
	lda #0
	sta ARG+3
	#argw 4, 96
	#argw 6, 96
	#argb 8, 1
	#argb 9, 0
	#argw 10, 0
	#argw 12, VIEW_H-1
	#argb 14, R2_SPR_MASKED
	lda #TEX_GUN
	sta ID_LO
	lda #0
	sta ID_HI
	#cmd2 R2_DRAW_SPRITE

	jsr statusBar

	jsr dmFlip
	jsr dmVbWait
	jsr report
	jsr movePlayer

	; RUN/STOP off our own matrix scan, not the KERNAL's $91 flag, and
	; only believed on two consecutive frames. $91 is maintained by the
	; IRQ's SCNKEY, which this program's own sei-guarded column scan
	; fights with -- that is the suspect for the idle exit to READY.
	lda keyD
	and #KD_STOP
	bne frUp
	inc stopCt
	lda stopCt
	cmp #2
	bcs frDone
	jmp frNext
frUp
	lda #0
	sta stopCt

	; Instrument the old path: count frames where the KERNAL claims STOP
	; is down while our scan says it is up. If G climbs while the demo
	; stays alive, $91 was the culprit and this is the proof.
frNext
	jsr dmStop
	bne +
	lda keyD
	and #KD_STOP
	beq +
	inc ghostCt
+	jmp frame
frDone
	lda #0
	sta CMD_HI
	; Say so on the C64 screen before holding. An exit nobody asked for
	; now parks here in plain sight instead of dropping to READY., so a
	; spurious STOP and a crash no longer look the same.
	lda #24
	jsr dmRow
	jsr dmText
	.text "STOPPED  G "
	.byte 0
	lda ghostCt
	jsr dmHexA
	jsr dmText
	.text "  RUN/STOP AGAIN TO EXIT   "
	.byte 0

	; Hold the C64 screen until RUN/STOP is released and pressed again,
	; so returning to BASIC does not print READY. over the last line.
-	jsr readKeys
	lda keyD
	and #KD_STOP
	beq -
-	jsr readKeys
	lda keyD
	and #KD_STOP
	bne -
	jsr $e544			; KERNAL clear screen
	rts

; ======================================================================
; The player
;
; He goes where he is driven. W and S walk along the direction he is
; facing, A and D turn him, Q and E strafe, F1 and F3 tilt his head, F7
; levels it again and SPACE fires. The walk is two table lookups and two
; 16-bit adds a frame: the walk vector is (cos yaw, sin yaw) out of the same sine
; table the 3D camera's angles come from, and the strafe vector is the same
; two numbers swapped and one negated.
; ======================================================================
movePlayer
	inc frameCt
	jsr readKeys

	; Look up and down. The limit is 48 binary degrees either way -- far
	; enough to see the ceiling, not far enough to turn the room over.
	lda keyA
	and #KA_F7
	bne +
	lda #0
	sta plPitch
+
	lda keyA
	and #KA_F1
	bne +
	lda plPitch
	cmp #PITCH_LIM
	beq +
	clc
	adc #2
	sta plPitch
+
	lda keyA
	and #KA_F3
	bne +
	lda plPitch
	cmp #256-PITCH_LIM
	beq +
	sec
	sbc #2
	sta plPitch
+

	; Turn first, so the walk that follows uses the angle he is facing by
	; the end of the frame. Yaw counts anticlockwise: +y is to his left.
	lda keyB
	and #KB_A
	bne +
	lda plYaw
	clc
	adc #TURN
	sta plYaw
+
	lda keyC
	and #KC_D
	bne +
	lda plYaw
	sec
	sbc #TURN
	sta plYaw
+

	; vecX,vecY is now one step forward: about an eighth of a world unit,
	; which is the speed the automatic walk used to run at.
	lda plYaw
	jsr setDir

	lda keyB
	and #KB_W
	bne +
	lda vecX
	ldx #posX
	jsr addSgn
	lda vecY
	ldx #posY
	jsr addSgn
+
	lda keyB
	and #KB_S
	bne +
	lda vecX
	jsr negA
	ldx #posX
	jsr addSgn
	lda vecY
	jsr negA
	ldx #posY
	jsr addSgn
+

	; Strafing right is the forward vector turned a quarter circle:
	; (sin yaw, -cos yaw). No second lookup, just the two bytes swapped.
	lda keyB
	and #KB_E
	bne +
	lda vecY
	ldx #posX
	jsr addSgn
	lda vecX
	jsr negA
	ldx #posY
	jsr addSgn
+
	lda keyD
	and #KD_Q
	bne +
	lda vecY
	jsr negA
	ldx #posX
	jsr addSgn
	lda vecX
	ldx #posY
	jsr addSgn
+

	; Fire. SPACE raises the muzzle flash and re-arms the one-shot that
	; puts the light out again; holding the key keeps it lit, which is
	; what a held trigger should look like.
	lda keyD
	and #KD_SPC
	bne +
	lda #FLASH_N
	sta flashCt
	lda #1
	sta flashArm
+
	jsr clampPos

	; The patrolling monster walks the width of the room and back. Its
	; record is the only thing in the batch that changes, and the three
	; bytes below are the whole cost of animating it -- one of them the
	; direction it faces, which is what picks the view gpu64 draws.
	ldy #64				; walking toward +y, so facing +y
	lda frameCt
	and #$7f
	cmp #$40
	bcc +
	eor #$7f			; 127 - p: the way back
	ldy #192
+
	sty monsters+2*R2_REC+13
	sec
	sbc #32				; -32..31, a fifth of a unit a step
	sta tmp
	asl a				; x 8 -> -4.0 .. 3.9 world units
	asl a
	asl a
	sta monsters+2*R2_REC+2
	lda tmp
	and #$80			; sign-extend the high byte
	beq +
	lda #$ff
+
	sta monsters+2*R2_REC+3

	; The one on the platform turns on the spot, a full circle every 256
	; frames, so all eight of its views come round without moving.
	lda frameCt
	sta monsters+1*R2_REC+13

	jsr eyeHeight
	rts

; ======================================================================
; The dynamic lights.
;
; SET_LIGHT carries its arguments inline -- ten register writes and no
; upload -- which is the whole reason a light can move. A muzzle flash
; has to be up on the frame the key is hit, and a blob transfer could
; not do that.
;
; The torch never moves; only its strength is stirred, so the far wall
; never quite settles. The flash is at the player's eye and fades over
; FLASH_N frames, so what it lights is whatever he is pointing at. When
; it reaches zero the slot is cleared once -- strength 0 frees it -- and
; then nothing is sent at all until he fires again.
; ======================================================================
sendLights
	lda #1				; slot 1: the torch
	sta ARG+0
	#argw 1, TORCH_X
	#argw 3, TORCH_Y
	#argw 5, TORCH_Z
	#argw 7, TORCH_R
	lda frameCt
	and #7
	tax
	lda flickTab,x
	sta ARG+9
	#cmd2 R2_SET_LIGHT

	lda flashCt			; slot 0: the muzzle flash
	bne slSend
	lda flashArm			; out, and already cleared?
	beq slDone
	lda #0
	sta flashArm			; no: this frame is the one that clears it
slSend
	lda #0
	sta ARG+0
	lda posX
	sta ARG+1
	lda posX+1
	sta ARG+2
	lda posY
	sta ARG+3
	lda posY+1
	sta ARG+4
	lda eyeZ
	sta ARG+5
	lda eyeZ+1
	sta ARG+6
	#argw 7, FLASH_R
	lda flashCt			; 10..1 -> strength 40..4, 0 -> off.
	asl a				; Forty is far past the sixteen levels
	asl a				; the map has, and lightAdjust clamps:
	sta ARG+9			; near the muzzle the wall goes white.
	#cmd2 R2_SET_LIGHT
	lda flashCt
	beq slDone
	dec flashCt
slDone
	rts

flickTab
	.byte 5, 7, 6, 8, 5, 8, 7, 6

; ======================================================================
; The keyboard, read straight off the matrix.
;
; A column is written to $dc00 and its eight rows read back from $dc01,
; both active low, so a pressed key is a ZERO bit. Four columns carry
; every key this program uses. The KERNAL's own IRQ scans the same matrix
; sixty times a second and would see -- and leave behind -- a different
; column, so the whole read runs with interrupts off.
; ======================================================================
readKeys
	sei
	lda #$ff
	sta $dc02			; port A drives the columns
	lda #$00
	sta $dc03			; port B reads the rows
	lda #COL_A
	sta CIA_PRA
	lda CIA_PRB
	sta keyA
	lda #COL_B
	sta CIA_PRA
	lda CIA_PRB
	sta keyB
	lda #COL_C
	sta CIA_PRA
	lda CIA_PRB
	sta keyC
	lda #COL_D
	sta CIA_PRA
	lda CIA_PRB
	sta keyD
	lda #$ff			; leave it as the KERNAL expects
	sta CIA_PRA
	cli
	rts

; ======================================================================
; A = angle -> vecX,vecY, one step in that direction.
;
; cos a is sin (a + 64): one table, two lookups. The entries run to +-127
; and two arithmetic shifts bring a step down to +-31, an eighth of a
; world unit.
; ======================================================================
setDir
	tax
	lda sinTab,x
	jsr asr2
	sta vecY
	txa
	clc
	adc #64
	tax
	lda sinTab,x
	jsr asr2
	sta vecX
	rts

asr2
	cmp #$80			; carry = sign, so ROR keeps it
	ror a
	cmp #$80
	ror a
	rts

negA
	eor #$ff
	clc
	adc #1
	rts

; ======================================================================
; A = a signed 8-bit step, X = the zero page address of a 16-bit value:
; add one to the other. posX and posY are adjacent so that one routine
; serves both, which is why they moved up the page.
; ======================================================================
addSgn
	ldy #0
	cmp #$80
	bcc +
	ldy #$ff			; sign-extend into the high byte
+
	clc
	adc $00,x
	sta $00,x
	tya
	adc $01,x
	sta $01,x
	rts

; ======================================================================
; Keep him inside the room: half a unit clear of every wall. There is no
; collision detection here -- the room is a box, and a box is four
; compares.
;
; x is always positive, so a negative high byte can only mean he walked
; backwards through the west wall. y is signed, and biasing the high byte
; by $80 turns the signed compare into the unsigned one the 6502 has.
; ======================================================================
YHB	= (>Y_HI) ^ $80
YLB	= (>Y_LO) ^ $80

clampPos
	lda posX+1
	bmi cpLoX
	cmp #>X_HI
	bcc cpChkLo
	bne cpHiX
	lda posX
	cmp #<X_HI
	bcc cpChkLo
cpHiX
	lda #<X_HI
	sta posX
	lda #>X_HI
	sta posX+1
	jmp cpYax
cpChkLo
	lda posX+1
	cmp #>X_LO
	bcc cpLoX
	bne cpYax
	lda posX
	cmp #<X_LO
	bcs cpYax
cpLoX
	lda #<X_LO
	sta posX
	lda #>X_LO
	sta posX+1

cpYax
	lda posY+1
	eor #$80
	cmp #YHB
	bcc cpChkYlo
	bne cpHiY
	lda posY
	cmp #<Y_HI
	bcc cpChkYlo
cpHiY
	lda #<Y_HI
	sta posY
	lda #>Y_HI
	sta posY+1
	rts
cpChkYlo
	lda posY+1
	eor #$80
	cmp #YLB
	bcc cpLoY
	bne cpYdone
	lda posY
	cmp #<Y_LO
	bcs cpYdone
cpLoY
	lda #<Y_LO
	sta posY
	lda #>Y_LO
	sta posY+1
cpYdone
	rts

; ======================================================================
; The height of the ramp under his feet, plus half a unit for the eye.
;
; The ramp climbs 1.5 units over the 3 from x=6 to x=9, so the floor he is
; standing on is ( x - 6 ) / 2, clamped to the top. One subtract and one
; shift: this is the whole of what a sloped floor costs the 6502, and it is
; the same shape as gpu64_demo_sectors' lookup of the sector he is in.
; ======================================================================
eyeHeight
	lda posY+1			; the ramp is only three units wide,
	bpl +				; so off its sides the floor is flat
	lda posY
	jsr negA
	lda posY+1
	eor #$ff
	adc #0
+
	cmp #2
	bcs ehFlat

	lda posX+1
	cmp #6
	bcc ehFlat

	sec
	lda posX
	sbc #<RAMP_X0
	sta eyeZ
	lda posX+1
	sbc #>RAMP_X0
	sta eyeZ+1
	lsr eyeZ+1
	ror eyeZ

	lda eyeZ+1
	cmp #>Z_RAMP
	bcc ehAdd
	bne ehClamp
	lda eyeZ
	cmp #<Z_RAMP
	bcc ehAdd
ehClamp
	lda #<Z_RAMP
	sta eyeZ
	lda #>Z_RAMP
	sta eyeZ+1
ehAdd
	clc
	lda eyeZ
	adc #<EYE_UP
	sta eyeZ
	lda eyeZ+1
	adc #>EYE_UP
	sta eyeZ+1
	rts

ehFlat
	lda #<EYE_UP
	sta eyeZ
	lda #>EYE_UP
	sta eyeZ+1
	rts

; ======================================================================
; The status bar, drawn on the HDMI screen below the view.
; ======================================================================
statusBar
	#argw 0, 0
	#argw 2, VIEW_H
	#argw 4, FB_W
	#argw 6, 200-VIEW_H
	#argb 8, 1*32+8
	#cmd0 OP_RECT_FILL

	; A bar whose length is where he is in the room: the cheapest
	; possible proof that the frame loop is still running.
	#argw 0, 8
	#argw 2, VIEW_H+8
	lda posX+1
	asl a
	asl a
	asl a
	asl a
	sta ARG+4
	lda #0
	sta ARG+5
	#argw 6, 8
	#argb 8, 7*32+28
	#cmd0 OP_RECT_FILL
	lda #2
	sta CMD_HI
	rts

; ======================================================================
; What the C64 has to say about it, on its own screen.
; ======================================================================
report
	lda #21
	jsr dmRow
	jsr dmText
	.text "WASD QE F1/F3 SPC"
	.byte 0

	; F is the frames the muzzle flash has left and D is column 7 of
	; the keyboard matrix raw, SPACE being bit 4 and active low. The
	; two of them say which half of a fire that does not show is at
	; fault: D stuck at FF is the matrix read, D dropping to EF while
	; F stays 00 is this program, F counting down while nothing on
	; the HDMI screen changes is the light itself.
	jsr dmText
	.text " F "
	.byte 0
	lda flashCt
	jsr dmHexA
	jsr dmText
	.text " D "
	.byte 0
	lda keyD
	jsr dmHexA
	jsr dmText
	.text " G "
	.byte 0
	lda ghostCt
	jsr dmHexA

	lda #22
	jsr dmRow
	jsr dmText
	.text "POLYS  ACC "
	.byte 0
	lda statBuf+3
	jsr dmHexA
	lda statBuf+2
	jsr dmHexA
	jsr dmText
	.text "  REJ "
	.byte 0
	lda statBuf+5
	jsr dmHexA
	lda statBuf+4
	jsr dmHexA
	jsr dmText
	.text "  PIX "
	.byte 0
	lda statBuf+9
	jsr dmHexA
	lda statBuf+8
	jsr dmHexA

	; ACC and REJ are one frame's snapshot and cannot be read off a
	; moving screen; ERRS and LAST only ever go up.
	lda #23
	jsr dmRow
	jsr dmText
	.text "X "
	.byte 0
	lda posX+1
	jsr dmHexA
	lda posX
	jsr dmHexA
	jsr dmText
	.text " Y "
	.byte 0
	lda posY+1
	jsr dmHexA
	lda posY
	jsr dmHexA
	jsr dmText
	.text " Z "
	.byte 0
	lda eyeZ+1
	jsr dmHexA
	lda eyeZ
	jsr dmHexA
	jsr dmText
	.text " YAW "
	.byte 0
	lda plYaw
	jsr dmHexA
	jsr dmText
	.text " PIT "
	.byte 0
	lda plPitch
	jsr dmHexA

	; Which command is failing, not just that one is. W counts frames
	; DRAW_WORLD refused and T frames DRAW_THINGS refused, each with the
	; code it last gave; U is the three start-up uploads -- verts, texinfo
	; and the resident face pool. A non-zero U with W climbing means the
	; level never got there and every frame since has been asking for a
	; range that is not resident.
	lda #24
	jsr dmRow
	jsr dmText
	.text "W "
	.byte 0
	lda wErr+1
	jsr dmHexA
	lda wErr
	jsr dmHexA
	lda lastW
	jsr dmHexA
	jsr dmText
	.text " T "
	.byte 0
	lda tErr+1
	jsr dmHexA
	lda tErr
	jsr dmHexA
	lda lastT
	jsr dmHexA
	jsr dmText
	.text " U "
	.byte 0
	lda upV
	jsr dmHexA
	lda upT
	jsr dmHexA
	lda upP
	jsr dmHexA
	jsr dmText
	.text " ER "
	.byte 0
	jsr dmErr
	rts

; ======================================================================
; State
; ======================================================================
plYaw	.byte 0			; 0 = looking along +x, 128 = back again
plPitch	.byte 0
frameCt	.byte 0
sprY	.byte 0
flashCt	.byte 0			; frames the muzzle flash has left
flashArm .byte 0		; and whether the slot still needs clearing
vecX	.byte 0			; one step forward, signed
vecY	.byte 0
keyA	.byte $ff		; the four matrix columns, active low
keyB	.byte $ff
keyC	.byte $ff
keyD	.byte $ff
stopCt	.byte 0		; frames RUN/STOP has been down on our own scan
ghostCt	.byte 0		; frames the KERNAL claimed STOP and we did not

; A whole circle of sines, 256 units round, +-127. The 3D camera measures
; its angles the same way, so the number in plYaw indexes this table
; directly and cos is the same table 64 entries along.
sinTab
	.for i = 0, i < 256, i += 1
	.byte round(127 * sin(i * 2 * pi / 256)) & $ff
	.next

tmp	.word 0
wErr	.word 0			; frames DRAW_WORLD refused
lastW	.byte 0
tErr	.word 0			; frames DRAW_THINGS refused
lastT	.byte 0
upV	.byte 0			; ERRCODE from each of the three start-up
upT	.byte 0			; uploads, kept rather than counted: they
upP	.byte 0			; happen once and once is all that matters
statBuf	.fill 16, 0

; ======================================================================
; The level.
;
; A face's vertices are consecutive in the pool, so each face owns its own
; run and shared corners are written twice -- which is what keeps a face
; record down to sixteen bytes, eight of them still spare.
;
; WINDING: a face is drawn from the side it projects CLOCKWISE from, y
; downwards. For an upright wall that is the same rule DRAW_WALLS has --
; the side that projects its first edge left to right -- so an interior
; wall loop runs clockwise in map coordinates, a floor is wound the same
; way round and a ceiling the other.
; ======================================================================

vertTab
V_FLOOR	= ( * - vertTab ) / R2_VERT
	#r2vertd WU(0),  WU(-5), 0
	#r2vertd WU(0),  WU(5),  0
	#r2vertd WU(10), WU(5),  0
	#r2vertd WU(10), WU(-5), 0

V_CEIL	= ( * - vertTab ) / R2_VERT
	#r2vertd WU(0),  WU(-5), Z_TOP
	#r2vertd WU(10), WU(-5), Z_TOP
	#r2vertd WU(10), WU(5),  Z_TOP
	#r2vertd WU(0),  WU(5),  Z_TOP

V_WALLS	= ( * - vertTab ) / R2_VERT	; y = -5, seen from inside
	#r2vertd WU(10), WU(-5), Z_TOP
	#r2vertd WU(0),  WU(-5), Z_TOP
	#r2vertd WU(0),  WU(-5), 0
	#r2vertd WU(10), WU(-5), 0

V_WALLW	= ( * - vertTab ) / R2_VERT	; x = 0
	#r2vertd WU(0),  WU(-5), Z_TOP
	#r2vertd WU(0),  WU(5),  Z_TOP
	#r2vertd WU(0),  WU(5),  0
	#r2vertd WU(0),  WU(-5), 0

V_WALLN	= ( * - vertTab ) / R2_VERT	; y = 5
	#r2vertd WU(0),  WU(5),  Z_TOP
	#r2vertd WU(10), WU(5),  Z_TOP
	#r2vertd WU(10), WU(5),  0
	#r2vertd WU(0),  WU(5),  0

V_WALLE	= ( * - vertTab ) / R2_VERT	; x = 10
	#r2vertd WU(10), WU(5),  Z_TOP
	#r2vertd WU(10), WU(-5), Z_TOP
	#r2vertd WU(10), WU(-5), 0
	#r2vertd WU(10), WU(5),  0

V_RAMP	= ( * - vertTab ) / R2_VERT	; the slope itself
	#r2vertd WU(6),  WU(-2), 0
	#r2vertd WU(6),  WU(2),  0
	#r2vertd WU(9),  WU(2),  Z_RAMP
	#r2vertd WU(9),  WU(-2), Z_RAMP

V_PLAT	= ( * - vertTab ) / R2_VERT	; the platform at the top of it
	#r2vertd WU(9),  WU(-2), Z_RAMP
	#r2vertd WU(9),  WU(2),  Z_RAMP
	#r2vertd WU(10), WU(2),  Z_RAMP
	#r2vertd WU(10), WU(-2), Z_RAMP

V_RAMPS	= ( * - vertTab ) / R2_VERT	; the ramp's south cheek, a triangle
	#r2vertd WU(9),  WU(-2), Z_RAMP
	#r2vertd WU(6),  WU(-2), 0
	#r2vertd WU(9),  WU(-2), 0

V_PLATS	= ( * - vertTab ) / R2_VERT	; and the platform's south side
	#r2vertd WU(10), WU(-2), Z_RAMP
	#r2vertd WU(9),  WU(-2), Z_RAMP
	#r2vertd WU(9),  WU(-2), 0
	#r2vertd WU(10), WU(-2), 0

V_RAMPN	= ( * - vertTab ) / R2_VERT	; the north cheek
	#r2vertd WU(6),  WU(2),  0
	#r2vertd WU(9),  WU(2),  Z_RAMP
	#r2vertd WU(9),  WU(2),  0

V_PLATN	= ( * - vertTab ) / R2_VERT
	#r2vertd WU(9),  WU(2),  Z_RAMP
	#r2vertd WU(10), WU(2),  Z_RAMP
	#r2vertd WU(10), WU(2),  0
	#r2vertd WU(9),  WU(2),  0

; The slab: floor above floor, which is the whole reason this is not a
; sector renderer. It hangs from x=2..4 across the west end of the room,
; open at the north so you can see it end-on as you walk under it.
V_SLABB	= ( * - vertTab ) / R2_VERT	; the underside, seen from below
	#r2vertd WU(2),  WU(-5), Z_SLABB
	#r2vertd WU(4),  WU(-5), Z_SLABB
	#r2vertd WU(4),  WU(5),  Z_SLABB
	#r2vertd WU(2),  WU(5),  Z_SLABB

V_SLABT	= ( * - vertTab ) / R2_VERT	; the walkway, seen from above
	#r2vertd WU(2),  WU(-5), Z_SLABT
	#r2vertd WU(2),  WU(5),  Z_SLABT
	#r2vertd WU(4),  WU(5),  Z_SLABT
	#r2vertd WU(4),  WU(-5), Z_SLABT

; The bridge reaches both side walls, so it has no end caps: the two faces
; below are its west and east sides, the ones the player sees as he walks
; up to it and as he looks back at it from the ramp.
V_SLABW	= ( * - vertTab ) / R2_VERT	; x = 2, seen from the west
	#r2vertd WU(2),  WU(-5), Z_SLABT
	#r2vertd WU(2),  WU(5),  Z_SLABT
	#r2vertd WU(2),  WU(5),  Z_SLABB
	#r2vertd WU(2),  WU(-5), Z_SLABB

V_SLABX	= ( * - vertTab ) / R2_VERT	; x = 4, seen from the east
	#r2vertd WU(4),  WU(5),  Z_SLABT
	#r2vertd WU(4),  WU(-5), Z_SLABT
	#r2vertd WU(4),  WU(-5), Z_SLABB
	#r2vertd WU(4),  WU(5),  Z_SLABB

NVERT	= ( * - vertTab ) / R2_VERT

; The texture axes. Eight texels to the world unit, so a 32-texel brick
; tiles every four units; t runs with -z so the texture is the right way
; up. Two faces naming one of these are guaranteed to align, which is why
; the room's four walls need no per-face alignment at all.
texinfoTab
TI_WALLX = 1				; a wall running along x
	#r2texinfod  2048, 0, 0, 0,      0, 0, -2048, 0
TI_WALLY = 2				; a wall running along y
	#r2texinfod  0, 2048, 0, 0,      0, 0, -2048, 0
TI_FLAT	 = 3				; anything roughly horizontal
	#r2texinfod  2048, 0, 0, 0,      0, 2048, 0, 0
NTI	= ( * - texinfoTab ) / R2_TEXINFO

; The faces. Order is the order they were written; nothing sorts them and
; nothing needs to.
faces
	#r2polyd V_FLOOR, 4, TI_FLAT,  TEX_STONE, 0, 1
	#r2polyd V_CEIL,  4, TI_FLAT,  TEX_STONE, 0, 3
	#r2polyd V_WALLS, 4, TI_WALLX, TEX_BRICK, 0, 1
	#r2polyd V_WALLW, 4, TI_WALLY, TEX_BRICK, 0, 2
	#r2polyd V_WALLN, 4, TI_WALLX, TEX_BRICK, 0, 1
	#r2polyd V_WALLE, 4, TI_WALLY, TEX_BRICK, 0, 2
	#r2polyd V_RAMP,  4, TI_FLAT,  TEX_BRICK, 0, 0
	#r2polyd V_PLAT,  4, TI_FLAT,  TEX_BRICK, 0, 0
	#r2polyd V_RAMPS, 3, TI_WALLX, TEX_STONE, 0, 2
	#r2polyd V_PLATS, 4, TI_WALLX, TEX_STONE, 0, 2
	#r2polyd V_RAMPN, 3, TI_WALLX, TEX_STONE, 0, 2
	#r2polyd V_PLATN, 4, TI_WALLX, TEX_STONE, 0, 2
	#r2polyd V_SLABB, 4, TI_FLAT,  TEX_BRICK, 0, 4
	#r2polyd V_SLABT, 4, TI_FLAT,  TEX_STONE, 0, 0
	#r2polyd V_SLABW, 4, TI_WALLY, TEX_BRICK, 0, 3
	#r2polyd V_SLABX, 4, TI_WALLY, TEX_BRICK, 0, 3
NFACES	= ( * - faces ) / R2_POLY
	.word	0			; R2_BATCH_SUM, filled in at start-up

; The monsters. A thing is a card that always faces the viewer, so it needs
; no vertices and no winding -- just where its feet are, how big it is, and
; a texture whose index 0 is see-through.
;
; The first stands under the bridge, which is the interesting one: it is
; occluded by a face that arrives in the batch BEFORE it, from a program
; that sorts nothing.
MON_W	= $00c0				; 0.75 x 1.5 world units
MON_H	= $0180

monsters
	; All three name TEX_MON as the first of eight consecutive views and
	; the direction they face; gpu64 works out which view you are looking
	; at. The first stands still in the corner, so walking round it is
	; what turns it.
MON_DIR	= R2_THING_MASKED | R2_THING_DIR
	#r2thingd WU(3),  WU(-3), 0,      MON_W, MON_H, TEX_MON, 4, MON_DIR, 32
	#r2thingd WU(10), WU(1),  Z_RAMP, MON_W, MON_H, TEX_MON, 0, MON_DIR, 0
	#r2thingd WU(5),  WU(0),  0,      MON_W, MON_H, TEX_MON, 2, MON_DIR, 64
NMON	= ( * - monsters ) / R2_REC

; --- the palette: 8 hues x 32 brightnesses -----------------------------
palHues = [[80,60,50], [150,120,95], [110,110,120], [90,130,90],  [170,150,60], [70,90,150], [180,90,60], [200,200,200]]

palData
	.for h = 0, h < 8, h += 1
	  .for s = 0, s < 32, s += 1
	  .byte round(palHues[h][0] * s / 31.0), round(palHues[h][1] * s / 31.0), round(palHues[h][2] * s / 31.0)
	  .next
	.next

; --- the colormap: 16 levels, each two shades darker than the last -----
cmapData
	.for l = 0, l < CMAP_LEVELS, l += 1
	  .for c = 0, c < 256, c += 1
	  .byte (c & $e0) | ((c & 31) - 2 * l < 0 ? 0 : (c & 31) - 2 * l)
	  .next
	.next

; --- the textures, column-major: texel(u,v) at u * TEXH + v ------------
brickTex
	.for u = 0, u < TEXW, u += 1
	  .for v = 0, v < TEXH, v += 1
	  .byte ((v % 8) == 0) || (((u + ((v / 8) % 2) * 8) % 16) < 2) ? 0*32+20 : 1*32+18+((u*5+v*3) % 6)
	  .next
	.next

stoneTex
	.for u = 0, u < TEXW, u += 1
	  .for v = 0, v < TEXH, v += 1
	  .byte ((v % 16) < 1) || ((u % 16) < 1) ? 2*32+12 : 2*32+20+((u*3+v*7) % 5)
	  .next
	.next

; The weapon: index 0 is the key, so the shape is what is not 0.
gunTex
	.for u = 0, u < TEXW, u += 1
	  .for v = 0, v < TEXH, v += 1
	  .byte (u >= 12 && u < 20 && v >= 8) ? (u < 14 || u >= 18 ? 7*32+14 : 7*32+24) :  ((u >= 10 && u < 22 && v >= 20) ? 7*32+8 : 0)
	  .next
	.next

; The monster, eight times over: a squat two-legged silhouette seen from
; eight directions round the compass, index 0 clear. View 0 is its front,
; view 4 its back, and gpu64 picks between them. Three things change as it
; turns: the silhouette narrows toward the side views, the eyes slide
; across the face and then go out of sight altogether, and the back views
; get a pale plate across the shoulders that the front ones do not -- so
; which way it is facing reads at a glance, which is the whole point.
MHW	.function d			; half width: broad face on, narrow side on
	.endf (d == 0 || d == 4) ? 10 : ((d == 2 || d == 6) ? 6 : 8)

MBODY	.function d, u, v
	.endf (v >= 4) && (u >= 16 - MHW(d)) && (u < 16 + MHW(d)) && !((v >= 26) && ((u % 12) >= 6))

MEYE	.function d, u, v
	.endf (v >= 8) && (v < 12) && ((d == 0) ? ((u >= 11 && u < 14) || (u >= 18 && u < 21)) : (d == 1) ? ((u >= 13 && u < 16) || (u >= 20 && u < 23)) : (d == 7) ? ((u >= 9 && u < 12) || (u >= 16 && u < 19)) : (d == 2) ? (u >= 18 && u < 21) : (d == 6) ? (u >= 11 && u < 14) : 0)

MBACK	.function d, u, v
	.endf (d >= 3) && (d <= 5) && (v >= 7) && (v < 12)

monTex
	.for d = 0, d < 8, d += 1
	  .for u = 0, u < TEXW, u += 1
	    .for v = 0, v < TEXH, v += 1
	    .byte !MBODY(d, u, v) ? 0 : MEYE(d, u, v) ? 7*32+30 : MBACK(d, u, v) ? 4*32+28 : 6*32+12+((u*3+v*5) % 8)
	    .next
	  .next
	.next

	.include "gpu64_rt.inc"
