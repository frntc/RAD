ry2L		.byte 0
ry2H		.byte 0
ckSpin		.word 0
gap0		.byte 0
gap1		.byte 0
gap2		.byte 0

	.include "stunt_league.inc"
	.include "stunt_sfx.inc"
	.include "gpu64_rt.inc"

; ----------------------------------------------------------------------
; Past the code: Led Storm, relocated to $a000 by tools/sidreloc.py so it
; sits under BASIC, then the RLE-packed HONDANI logo (tools/hondani.py, a
; copy of quake/'s), and from $c000 the title that uses both. The PRG
; loads contiguously up to the title's end; the logo unpacks into VIC
; bank 3 ($cc00 / $e000), which nothing else uses. The tune's .bin
; carries a two-byte load address, skipped here.
; ----------------------------------------------------------------------
	.cerror * > TRK, "the game's code has grown into the track block"
	.cerror * > TUNE_INIT, "the game's code has grown into the tune at $a000"
	* = TUNE_INIT
	.binary "gpu64_tune.bin", 2
	.cerror * > LOGO_RLE, "the tune has grown into the logo"
	* = LOGO_RLE
	.binary "gpu64_hondani.bin"
	.cerror * > $c000, "the logo has grown into the title"
	* = $c000
	.include "stunt_title.inc"
	.cerror * > LOGO_SCREEN, "the title has grown into the logo's screen"
